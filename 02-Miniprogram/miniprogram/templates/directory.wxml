<template name="directory-tabs"><view class="directory-tabs"><button wx:for="{{directoryTabs}}" wx:key="id" class="{{directoryType===item.id?'active':''}}" data-type="{{item.id}}" bindtap="changeDirectoryType">{{item.name}}</button></view></template>
<template name="directory-rows"><view class="directory-list"><button wx:for="{{directoryItems}}" wx:key="key" class="directory-row" data-type="{{item.type}}" data-key="{{item.key}}" data-name="{{item.name}}" bindtap="openDirectoryEntity"><view class="directory-avatar {{item.type}}">{{item.initial}}</view><view class="directory-row-body"><view class="directory-row-head"><text>{{item.name}}</text><text>{{item.typeLabel}} ›</text></view><text class="directory-summary">{{updates?item.updateTitle:item.subtitle}}</text><view class="directory-meta"><text>{{updates?item.updateLabel:item.categoriesText}}</text><text>{{item.latestDate}}</text></view></view></button></view></template>
