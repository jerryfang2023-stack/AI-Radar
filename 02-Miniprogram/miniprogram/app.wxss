page {
  --gl-ink: #071827;
  --gl-blue: #0d355c;
  --gl-gray: #6f7f8f;
  --gl-border: #e5e8ec;
  --gl-bg: #f7f4ef;
  --gl-page: #fffdf8;
  --gl-paper: #ffffff;
  --gl-gold: #c8a766;
  --gl-positive: #2f8c57;
  --gl-risk: #b85c5c;
  min-height: 100%;
  background: var(--gl-page);
  color: var(--gl-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

button { font: inherit; }
button::after { border: 0; }
.page-shell { min-height: 100vh; background: var(--gl-page); }
.page-content { padding: 24rpx 28rpx 146rpx; }
.serif { font-family: "Songti SC", "STSong", "SimSun", serif; }
.mono { font-family: "SFMono-Regular", Consolas, monospace; font-variant-numeric: tabular-nums; }
.section-title { margin: 34rpx 0 18rpx; font-size: 30rpx; font-weight: 600; }
.paper-card { border: 1rpx solid var(--gl-border); border-radius: 20rpx; background: rgba(255, 255, 255, 0.92); }
.primary-button { display: flex; align-items: center; justify-content: center; min-height: 84rpx; border-radius: 14rpx; background: var(--gl-ink); color: #fff; font-size: 28rpx; font-weight: 600; }
.secondary-button { display: flex; align-items: center; justify-content: center; min-height: 80rpx; border: 1rpx solid rgba(200, 167, 102, 0.75); border-radius: 14rpx; background: #fff; color: #9b6d20; font-size: 28rpx; font-weight: 600; }
.empty-state { padding: 100rpx 28rpx; text-align: center; }
.empty-state .title { margin-bottom: 12rpx; font-size: 32rpx; font-weight: 600; }
.empty-state .copy { color: var(--gl-gray); font-size: 26rpx; line-height: 1.7; }
.status-positive { color: var(--gl-positive); }
.status-risk { color: var(--gl-risk); }
.content-access-gate { margin: 28rpx 0 8rpx; padding: 40rpx 30rpx; border: 1rpx solid rgba(200, 167, 102, .68); border-radius: 20rpx; background: linear-gradient(145deg, #fffaf0, #fffdf8); text-align: center; box-shadow: 0 16rpx 36rpx rgba(7, 24, 39, .06); }
.content-access-gate .gate-kicker { display: block; color: #9b6d20; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }
.content-access-gate .gate-title { display: block; margin-top: 14rpx; color: var(--gl-ink); font-size: 34rpx; font-weight: 600; line-height: 1.45; }
.content-access-gate .gate-copy { display: block; margin: 14rpx auto 26rpx; color: var(--gl-gray); font-size: 24rpx; line-height: 1.7; }
.content-access-gate button { min-height: 82rpx; border-radius: 14rpx; background: var(--gl-blue); color: #fff; font-size: 27rpx; font-weight: 600; line-height: 82rpx; }
.content-access-gate .gate-note { display: block; margin-top: 16rpx; color: #8996a3; font-size: 20rpx; line-height: 1.6; }
.service-state { display: block; padding: 28rpx 16rpx; margin: 12rpx 0; color: #6F7F8F; font-size: 24rpx; line-height: 1.6; background: #F7F4EF; border-radius: 12rpx; text-align: center; }
.community-skeleton { padding: 24rpx 0; }
.community-skeleton view { height: 24rpx; margin: 20rpx 0; border-radius: 8rpx; background: #F0ECE5; }
.community-skeleton view:first-child { width: 62%; height: 36rpx; }
.community-skeleton view:last-child { width: 78%; }
