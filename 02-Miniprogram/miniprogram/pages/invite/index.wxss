.invite-content { display: grid; gap: 24rpx; padding-top: 24rpx; padding-bottom: 54rpx; }
.invite-hero { overflow: hidden; padding: 34rpx 30rpx 0; border-radius: 26rpx; background: linear-gradient(145deg, #071827 0%, #0d355c 100%); color: #fff; box-shadow: 0 18rpx 42rpx rgba(7,24,39,.14); }
.invite-kicker { color: #d9bd82; font-size: 20rpx; letter-spacing: 4rpx; }
.invite-heading { display: block; margin-top: 16rpx; font-size: 39rpx; font-weight: 600; line-height: 1.42; }
.reward-grid { display: grid; grid-template-columns: 1fr 1fr; margin: 30rpx -30rpx 0; border-top: 1rpx solid rgba(255,255,255,.14); background: rgba(255,255,255,.06); }
.reward-grid > view { display: flex; flex-direction: column; gap: 6rpx; padding: 23rpx 30rpx 26rpx; color: rgba(255,255,255,.65); font-size: 19rpx; }
.reward-grid > view + view { border-left: 1rpx solid rgba(255,255,255,.14); }
.reward-grid .serif { color: #e8d6ae; font-size: 36rpx; font-weight: 600; }
.invite-section { padding: 28rpx 26rpx; border: 1rpx solid #e7e1d5; border-radius: 22rpx; background: #fff; }
.section-heading { display: flex; align-items: center; justify-content: space-between; }
.section-heading > text:last-child { color: #9b6d20; font-size: 21rpx; }
.section-title { color: #071827; font-size: 31rpx; font-weight: 600; }
.invitee-action-card { display: grid; gap: 22rpx; padding: 26rpx; border: 1rpx solid rgba(200,167,102,.62); border-radius: 22rpx; background: #fff9ec; }
.invitee-action-card > view { display: flex; flex-direction: column; gap: 9rpx; }
.invitee-action-card .serif { color: #071827; font-size: 29rpx; font-weight: 600; }
.invitee-action-card view text:last-child { color: #6c5b38; font-size: 22rpx; line-height: 1.55; }
.invitee-action-card .share-button { width: 100%; }
.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 24rpx; }
.stats-grid > view { display: flex; flex-direction: column; gap: 7rpx; align-items: center; }
.stats-grid > view + view { border-left: 1rpx solid #e7e1d5; }
.stats-grid strong { color: #0d355c; font-size: 35rpx; }
.stats-grid text { color: #6f7f8f; font-size: 20rpx; }
.value-list, .step-list { display: grid; gap: 0; margin-top: 16rpx; }
.value-list > view, .step-list > view { display: grid; grid-template-columns: 54rpx 1fr; gap: 16rpx; align-items: start; padding: 19rpx 0; border-bottom: 1rpx solid #ece8df; }
.value-list > view:last-child, .step-list > view:last-child { border-bottom: 0; padding-bottom: 4rpx; }
.value-index { color: #b38e4e; font-family: Georgia, serif; font-size: 21rpx; }
.value-list view view, .step-list view view { display: flex; flex-direction: column; gap: 8rpx; }
.value-list view view text:first-child, .step-list view view text:first-child { color: #071827; font-size: 26rpx; font-weight: 600; }
.value-list view view text:last-child, .step-list view view text:last-child { color: #64717c; font-size: 21rpx; line-height: 1.55; }
.step-list > view > text { display: flex; width: 42rpx; height: 42rpx; align-items: center; justify-content: center; border-radius: 50%; background: #eaf0f5; color: #0d355c; font-size: 20rpx; font-weight: 700; }
.rule-card { display: flex; flex-direction: column; gap: 10rpx; padding: 24rpx 26rpx; border-left: 6rpx solid #c8a766; background: #f4edde; }
.rule-card text:first-child { color: #604412; font-size: 25rpx; font-weight: 600; }
.rule-card text:last-child { color: #6c5b38; font-size: 21rpx; line-height: 1.7; }
.share-button { min-height: 90rpx; border-radius: 16rpx; background: #071827; color: #fff; font-size: 27rpx; font-weight: 600; line-height: 90rpx; box-shadow: 0 12rpx 26rpx rgba(7,24,39,.15); }
.with-shared-nav { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.shared-entry-nav { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: grid; grid-template-columns: repeat(4, 1fr); padding-bottom: env(safe-area-inset-bottom); border-top: 1rpx solid #d7d0c3; background: rgba(255,253,248,.98); box-shadow: 0 -8rpx 24rpx rgba(7,24,39,.07); }
.shared-entry-nav button { position: relative; min-height: 94rpx; margin: 0; padding: 0; border-radius: 0; background: transparent; color: #516273; font-size: 25rpx; font-weight: 600; line-height: 94rpx; }
.shared-entry-nav button + button::before { position: absolute; top: 25rpx; left: 0; width: 1rpx; height: 44rpx; background: #d7d0c3; content: ""; }
