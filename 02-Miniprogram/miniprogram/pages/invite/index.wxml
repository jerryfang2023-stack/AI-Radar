<view class="page-shell">
  <app-header title="{{isInvitee ? '好友邀请' : '邀请好友'}}" show-back fallback-url="/pages/terminal/index" />
  <view class="page-content invite-content {{sharedEntry ? 'with-shared-nav' : ''}}">
    <view class="invite-hero">
      <text class="invite-kicker">{{isInvitee ? inviterName + ' 邀请你来' : '观澜同频邀请'}}</text>
      <text class="invite-heading serif">{{isInvitee ? '一起看懂 AI 商业变化' : '把有价值的 AI 商业情报，分享给同频的人'}}</text>
      <view class="reward-grid">
        <view><text>新用户获得</text><text class="serif">7 天</text><text>完整权益体验</text></view>
        <view><text>邀请人获得</text><text class="serif">300 分</text><text>活跃积分</text></view>
      </view>
    </view>

    <view wx:if="{{isInvitee}}" class="invitee-action-card">
      <view><text class="serif">接受 {{inviterName}} 的邀请</text><text>{{registered ? '注册已完成，现在可以进入观澜。' : '微信快捷注册后，立即开启 7 天完整体验。'}}</text></view>
      <button class="share-button" loading="{{registering}}" bindtap="registerInvitee">{{registered ? '进入观澜' : '微信快捷注册'}}</button>
    </view>

    <view wx:else class="invite-stats invite-section">
      <view class="section-heading"><text class="section-title serif">我的邀请</text><text bindtap="loadSummary">刷新</text></view>
      <view class="stats-grid">
        <view><strong class="serif">{{summary.invitedCount}}</strong><text>已邀请</text></view>
        <view><strong class="serif">{{summary.successfulCount}}</strong><text>注册成功</text></view>
        <view><strong class="serif">{{summary.rewardPoints}}</strong><text>获得积分</text></view>
      </view>
    </view>

    <view class="invite-section">
      <text class="section-title serif">好友可以获得什么</text>
      <view class="value-list">
        <view><text class="value-index">01</text><view><text>融资情报</text><text>快速掌握 AI 企业融资动态与资本动向</text></view></view>
        <view><text class="value-index">02</text><view><text>生态图谱</text><text>查询企业、投资机构与核心人物档案</text></view></view>
        <view><text class="value-index">03</text><view><text>商业观察</text><text>阅读周报与月报，理解变化而不只看消息</text></view></view>
      </view>
    </view>

    <view wx:if="{{!isInvitee}}" class="invite-section">
      <text class="section-title serif">邀请如何生效</text>
      <view class="step-list">
        <view><text>1</text><view><text>分享邀请</text><text>把观澜分享给需要 AI 商业情报的好友</text></view></view>
        <view><text>2</text><view><text>好友首次注册</text><text>好友通过邀请进入并完成首次注册</text></view></view>
        <view><text>3</text><view><text>积分到账</text><text>系统确认邀请关系后，向邀请人发放 300 活跃积分</text></view></view>
      </view>
    </view>

    <view wx:if="{{!isInvitee}}" class="rule-card">
      <text>邀请规则</text>
      <text>每位新用户仅计入一次有效邀请；邀请关系及积分发放以系统确认结果为准。活跃积分不可提现，可用于兑换会员权益。</text>
    </view>

    <button wx:if="{{!isInvitee}}" class="share-button" open-type="share">邀请好友加入</button>
  </view>

  <view wx:if="{{sharedEntry}}" class="shared-entry-nav">
    <button data-url="/pages/terminal/index" bindtap="switchSection">融资</button>
    <button data-url="/pages/market/index" bindtap="switchSection">生态</button>
    <button data-url="/pages/watchlist/index" bindtap="switchSection">观察</button>
    <button data-url="/pages/profile/index" bindtap="switchSection">我的</button>
  </view>
  <registration-sheet visible="{{registrationOpen}}" required="{{isInvitee}}" invite-code="{{inviteCode}}" bind:close="closeRegistration" bind:registered="registrationCompleted" bind:continue="continueAfterRegistration" />
</view>
