<view class="page-shell">
  <app-header title="我的" show-logo="{{false}}" />
  <view class="page-content profile-content">
    <view class="identity-row" bindtap="openSettings">
      <image class="member-avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
      <view class="identity-copy">
        <text class="member-name serif">{{profile.nickname}}</text>
        <text class="member-meta">资料完善度 {{profileCompletion}}% · 管理个人信息</text>
      </view>
      <text class="text-link">设置</text>
    </view>

    <view class="growth-card" bindtap="openGrowth">
      <view class="growth-top">
        <view>
          <text class="growth-kicker">会员等级</text>
          <text class="growth-level">L{{growth.level.level}} {{growth.level.name}}</text>
        </view>
        <view class="points-block">
          <text class="points mono">{{growth.wallet.balance}}</text>
          <text>活跃积分</text>
        </view>
      </view>
      <view class="growth-progress-row">
        <text>已完成 {{growth.completedToday}}/{{growth.tasks.length}} 个成长任务</text>
        <text wx:if="{{growth.level.remaining}}">距下一级 {{growth.level.remaining}} 分</text>
        <text wx:else>已到最高等级</text>
      </view>
      <view class="progress-track"><view class="progress-value" style="width: {{growth.level.progress}}%;"></view></view>
      <view class="growth-action">查看积分明细与会员兑换</view>
    </view>

    <view class="membership-card" bindtap="openMembership">
      <view class="membership-copy"><view><text class="membership-kicker">会员权益</text><text class="membership-status">{{growth.membership.statusLabel}}</text></view><text wx:if="{{growth.membership.active}}">有效至 {{growth.membership.activeUntil}}</text><text wx:else>浏览全部栏目</text></view>
      <view class="membership-action">{{growth.membership.status === 'unregistered' ? '立即注册' : (growth.membership.active ? '续费会员' : '开通会员')}}<text>›</text></view>
    </view>

    <view class="community-card">
      <view class="community-mark">观</view>
      <view class="community-copy" bindtap="openCommunity">
        <text>观澜社群</text>
        <text class="community-status">{{community.status === 'joined' ? '已入群' : community.statusLabel}}</text>
      </view>
      <view wx:if="{{community.status === 'joined'}}" class="community-action" bindtap="openCommunity">
        <text class="community-points mono">{{community.points}}</text><text>社群积分</text>
      </view>
      <view wx:elif="{{community.status !== 'none'}}" class="community-action" bindtap="openCommunity">{{community.statusLabel}} <text>›</text></view>
      <button wx:else class="community-link-button" open-type="getPhoneNumber" bindgetphonenumber="linkCommunity" loading="{{linkingCommunity}}">申请加入</button>
    </view>

    <view class="section-heading"><text class="serif">成长任务</text><text bindtap="openGrowth">查看明细</text></view>
    <view class="list-card paper-card">
      <view wx:for="{{growth.tasks}}" wx:key="id" class="action-row" data-id="{{item.id}}" bindtap="openTask">
        <view class="row-copy">
          <text class="row-title">{{item.title}}</text>
          <text class="row-subtitle">今日进度 {{item.current}}/{{item.target}}{{item.unit}}</text>
        </view>
        <view class="reward-state {{item.completed ? 'completed' : ''}}">{{item.completed ? '已完成' : '+' + item.reward + ' 分'}}</view>
      </view>
    </view>

    <view class="section-heading"><text class="serif">我的权益</text><text bindtap="openGrowth">全部权益</text></view>
    <view class="list-card paper-card">
      <view wx:for="{{growth.benefits}}" wx:key="id" class="benefit-row" bindtap="openGrowth">
        <view class="benefit-mark"><image src="/assets/brand/app-icon-light.svg" mode="aspectFit" /></view>
        <view class="row-copy"><text class="row-title">{{item.title}}</text><text class="row-subtitle">{{item.description}}</text></view>
        <text class="benefit-cost mono">{{item.redeemed ? '已兑换' : item.cost + ' 分'}}</text>
      </view>
    </view>

    <view class="invite-card" bindtap="openInvite">
      <view><text class="invite-title">邀请好友 · 共同成长</text><text class="invite-copy">好友完成首次注册后，邀请人得 300 活跃积分</text></view>
      <text class="invite-action">查看详情 ›</text>
    </view>
  </view>
</view>
