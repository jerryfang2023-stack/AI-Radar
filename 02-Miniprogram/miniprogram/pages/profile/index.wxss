.profile-content { display: grid; gap: 22rpx; padding-top: 16rpx; }
.identity-row { display: grid; grid-template-columns: 92rpx minmax(0, 1fr) auto; gap: 18rpx; align-items: center; padding: 14rpx 4rpx 8rpx; }
.member-avatar { width: 88rpx; height: 88rpx; border: 1rpx solid #e5e8ec; border-radius: 50%; background: #fff; }
.identity-copy, .row-copy { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; }
.member-name { color: #071827; font-size: 38rpx; font-weight: 600; }
.member-meta, .row-subtitle { color: #6f7f8f; font-size: 23rpx; line-height: 1.5; }
.text-link { padding: 11rpx 18rpx; border: 1rpx solid rgba(13, 53, 92, 0.22); border-radius: 999rpx; background: #fff; color: #0d355c; font-size: 23rpx; font-weight: 600; }
.membership-card { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 22rpx 24rpx; border: 1rpx solid rgba(200,167,102,.62); border-left: 7rpx solid #c8a766; border-radius: 16rpx; background: #fffaf0; box-shadow: 0 10rpx 28rpx rgba(86,63,22,.07); }
.membership-copy { display: flex; min-width: 0; flex-direction: column; gap: 7rpx; color: #806b45; font-size: 19rpx; }
.membership-copy > view { display: flex; align-items: baseline; gap: 14rpx; }
.membership-kicker { color: #8c7041; font-size: 19rpx; }
.membership-status { color: #071827; font-size: 23rpx; font-weight: 600; }
.membership-action { display: flex; flex: 0 0 auto; align-items: center; gap: 7rpx; padding: 15rpx 19rpx; border-radius: 999rpx; background: #071827; color: #fff; font-size: 20rpx; font-weight: 600; }
.membership-action text { font-size: 25rpx; line-height: 1; }
.growth-card { overflow: hidden; padding: 28rpx 28rpx 0; border-radius: 22rpx; background: linear-gradient(135deg, #071827 0%, #0d355c 100%); color: #fff; box-shadow: 0 16rpx 36rpx rgba(7, 24, 39, 0.12); }
.growth-top { display: flex; align-items: flex-start; justify-content: space-between; }
.growth-top > view:first-child, .points-block { display: flex; flex-direction: column; }
.growth-kicker { color: rgba(255,255,255,.68); font-size: 22rpx; letter-spacing: 3rpx; }
.growth-level { margin-top: 10rpx; font-family: "Songti SC", "STSong", serif; font-size: 36rpx; font-weight: 600; }
.points-block { align-items: flex-end; color: rgba(255,255,255,.68); font-size: 21rpx; }
.points { color: #d9bd82; font-size: 44rpx; font-weight: 600; line-height: 1.1; }
.growth-progress-row { display: flex; justify-content: space-between; margin-top: 24rpx; color: rgba(255,255,255,.72); font-size: 21rpx; }
.progress-track { height: 8rpx; margin-top: 12rpx; overflow: hidden; border-radius: 999rpx; background: rgba(255,255,255,.16); }
.progress-value { height: 100%; border-radius: inherit; background: #c8a766; }
.growth-action { margin: 24rpx -28rpx 0; padding: 19rpx 28rpx; background: rgba(255,255,255,.07); color: #e8d6ae; font-size: 23rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.section-heading > text:first-child { color: #071827; font-size: 30rpx; font-weight: 600; }
.section-heading > text:last-child { color: #9b6d20; font-size: 23rpx; }
.list-card { overflow: hidden; }
.action-row, .benefit-row { display: flex; min-height: 98rpx; align-items: center; gap: 18rpx; padding: 16rpx 22rpx; border-bottom: 1rpx solid #e5e8ec; }
.action-row:last-child, .benefit-row:last-child { border-bottom: 0; }
.row-copy { flex: 1; }
.row-title { color: #071827; font-size: 26rpx; font-weight: 600; }
.reward-state { min-width: 98rpx; padding: 10rpx 14rpx; border-radius: 999rpx; background: #c8a766; color: #fff; font-size: 21rpx; text-align: center; }
.reward-state.completed { background: #eef6f1; color: #2f8c57; }
.benefit-mark { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(200,167,102,.48); border-radius: 50%; background: #fffbf1; }
.benefit-mark image { width: 42rpx; height: 42rpx; }
.benefit-cost { color: #9b6d20; font-size: 22rpx; }
.invite-card { display: flex; min-height: 104rpx; align-items: center; justify-content: space-between; margin: 8rpx 0 0; padding: 20rpx 24rpx; border: 1rpx solid rgba(200,167,102,.52); border-radius: 18rpx; background: #fff9ec; line-height: normal; text-align: left; }
.invite-card > view { display: flex; flex-direction: column; gap: 9rpx; }
.invite-title { color: #604412; font-size: 27rpx; font-weight: 600; }
.invite-copy { color: #8c7041; font-size: 21rpx; }
.invite-action { color: #9b6d20; font-size: 23rpx; font-weight: 600; }
