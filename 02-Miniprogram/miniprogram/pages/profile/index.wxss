.profile-content { display: grid; gap: 20rpx; padding-top: 30rpx; }
.brand-block { display: flex; flex-direction: column; gap: 12rpx; align-items: center; padding: 36rpx 24rpx; }
.brand-block image { width: 300rpx; }
.brand-block .serif { color: #071827; font-size: 34rpx; font-weight: 600; }
.brand-block > text:last-child { color: #6f7f8f; font-size: 23rpx; }
.profile-card { display: flex; align-items: center; justify-content: space-between; padding: 26rpx; }
.profile-card > view { display: flex; flex-direction: column; gap: 8rpx; }
.card-title { color: #071827; font-size: 29rpx; font-weight: 600; }
.card-copy { color: #6f7f8f; font-size: 23rpx; }
.card-action { color: #9b6d20; font-size: 24rpx; }
.info-list > view { display: grid; grid-template-columns: 190rpx 1fr; gap: 20rpx; min-height: 84rpx; padding: 0 24rpx; align-items: center; border-bottom: 1rpx solid #e5e8ec; color: #6f7f8f; font-size: 23rpx; }
.info-list > view:last-child { border-bottom: 0; }
.info-list > view > text:last-child { overflow-wrap: anywhere; color: #071827; text-align: right; }
.note { padding: 24rpx; color: #516273; font-size: 24rpx; line-height: 1.75; }
.danger-button { min-height: 78rpx; margin: 18rpx 0 0; border: 1rpx solid rgba(184, 92, 92, 0.5); border-radius: 14rpx; background: #fff; color: #b85c5c; font-size: 25rpx; line-height: 78rpx; }
