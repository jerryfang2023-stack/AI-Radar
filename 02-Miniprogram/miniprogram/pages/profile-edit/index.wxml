<view class="page-shell">
  <app-header title="个人资料" show-back fallback-url="/pages/profile/index" />
  <view class="page-content edit-content">
    <view class="profile-summary paper-card">
      <view class="summary-heading">
        <view><text>资料完成度</text><text class="summary-state">{{profileCompletion === 100 ? '资料已完善' : '继续完善资料'}}</text></view>
        <text class="summary-value serif">{{profileCompletion}}%</text>
      </view>
      <view class="completion-track"><view style="width: {{profileCompletion}}%;"></view></view>
    </view>

    <view class="section-title serif">资料设置</view>
    <view class="form-card paper-card">
      <view class="profile-row avatar-field">
        <view class="field-copy"><text class="field-label">头像</text><text class="field-note">点击头像更换</text></view>
        <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image src="{{profile.avatarUrl}}" mode="aspectFill" /></button>
      </view>

      <view class="profile-row nickname-field">
        <text class="field-label">昵称</text>
        <input type="nickname" value="{{nickname}}" maxlength="20" placeholder="请输入昵称" bindinput="inputNickname" />
      </view>

      <view class="profile-row phone-field">
        <view class="field-copy"><text class="field-label">手机号</text><text class="field-note {{profile.phoneMasked ? 'is-bound' : ''}}">{{profile.phoneMasked || '未绑定'}}</text></view>
        <button class="outline-button" loading="{{bindingPhone}}" disabled="{{bindingPhone}}" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">{{profile.phoneMasked ? '更换' : '绑定'}}</button>
      </view>
    </view>

    <button class="primary-button save-button" bindtap="saveNickname">保存资料</button>
  </view>
</view>
