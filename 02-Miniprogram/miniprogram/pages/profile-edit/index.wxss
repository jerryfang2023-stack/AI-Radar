.edit-content { padding-top: 28rpx; padding-bottom: 64rpx; }
.profile-summary { padding: 28rpx 26rpx 26rpx; border-color: rgba(200,167,102,.34); background: #fffdf8; box-shadow: 0 14rpx 34rpx rgba(7,24,39,.06); }
.summary-heading { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.summary-heading > view { display: flex; flex-direction: column; gap: 7rpx; }
.summary-heading view text:first-child { color: #071827; font-size: 29rpx; font-weight: 650; }
.summary-state { color: #6f7f8f; font-size: 21rpx; }
.summary-value { color: #9b6d20; font-size: 40rpx; font-weight: 600; }
.completion-track { height: 8rpx; margin-top: 22rpx; overflow: hidden; border-radius: 99rpx; background: #edf0f2; }
.completion-track > view { height: 100%; border-radius: inherit; background: #c8a766; }
.section-title { margin: 34rpx 4rpx 16rpx; color: #071827; font-size: 31rpx; font-weight: 600; }
.form-card { overflow: hidden; border-color: #e5ded1; box-shadow: 0 16rpx 38rpx rgba(7,24,39,.055); }
.profile-row { display: flex; min-height: 118rpx; align-items: center; justify-content: space-between; gap: 24rpx; padding: 18rpx 26rpx; border-bottom: 1rpx solid #e7e1d6; }
.profile-row:last-child { border-bottom: 0; }
.field-copy { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; }
.field-label { color: #071827; font-size: 27rpx; font-weight: 600; }
.field-note { color: #7d8994; font-size: 21rpx; line-height: 1.45; }
.field-note.is-bound { color: #2f7d69; }
.avatar-button { width: 88rpx; height: 88rpx; margin: 0; padding: 0; overflow: hidden; border: 1rpx solid #e5ded1; border-radius: 22rpx; background: #fff; line-height: normal; box-shadow: 0 6rpx 16rpx rgba(7,24,39,.06); }
.avatar-button image { width: 88rpx; height: 88rpx; border-radius: 22rpx; }
.nickname-field { justify-content: flex-start; }
.nickname-field .field-label { width: 110rpx; flex: none; }
.nickname-field input { flex: 1; height: 72rpx; color: #071827; font-size: 26rpx; text-align: right; }
.outline-button { min-width: 112rpx; min-height: 62rpx; margin: 0; padding: 0 20rpx; border: 1rpx solid rgba(200,167,102,.72); border-radius: 31rpx; background: #fffaf0; color: #8b6423; font-size: 22rpx; font-weight: 600; line-height: 62rpx; }
.outline-button[disabled] { opacity: .62; }
.save-button { margin-top: 28rpx; border-radius: 18rpx; box-shadow: 0 14rpx 30rpx rgba(7,24,39,.13); }
