.page{min-height:100vh;background:#fffdf8;color:#071827}.safe-top{height:env(safe-area-inset-top)}.header{display:flex;align-items:center;justify-content:center;height:112rpx;border-bottom:1rpx solid #e8e0d3;font-size:34rpx;font-weight:700}.header image{position:absolute;left:38rpx;width:150rpx}.panel{margin:76rpx 38rpx;padding:58rpx 40rpx;border:1rpx solid #e5dac8;border-radius:24rpx;background:#fff;text-align:center;box-shadow:0 18rpx 60rpx rgba(13,53,92,.08)}.mark{display:grid;width:104rpx;height:104rpx;margin:0 auto 30rpx;place-items:center;border-radius:50%;background:#0d355c;color:#d9b668;font-family:serif;font-size:48rpx}.title{display:block;font-size:40rpx;font-weight:700}.description{display:block;margin:22rpx 0 44rpx;color:#6f7f8f;font-size:27rpx;line-height:1.75}.primary,.secondary{height:92rpx;border-radius:12rpx;font-size:29rpx;line-height:92rpx}.primary{background:#0d355c;color:#fff}.secondary{border:1rpx solid #c8a766;background:#fff;color:#0d355c}
