<view class="page-shell">
  <app-header title="{{report.typeLabel || '行业观察'}}" show-back fallback-url="/pages/market/index" />
  <view class="page-content reader-content {{sharedEntry ? 'with-shared-nav' : ''}}">
    <view wx:if="{{report}}" class="reader-hero">
      <view class="reader-kicker"><text>{{report.typeLabel}}</text><text class="mono">{{report.issue}}</text></view>
      <text class="reader-title serif">{{report.title}}</text>
      <text class="reader-summary">{{report.summary}}</text>
      <view class="reader-meta"><text>{{report.date}}</text><text wx:if="{{report.author}}">{{report.author}}</text><text wx:if="{{report.readingTime}}">{{report.readingTime}}</text><text wx:elif="{{report.window}}">{{report.window}}</text></view>
      <view wx:if="{{report.counts}}" class="reader-evidence"><view><text class="mono">{{report.counts.signals}}</text><text>商业事件</text></view><view><text class="mono">{{report.counts.opinions}}</text><text>一线观点</text></view><view><text class="mono">{{report.counts.community}}</text><text>社群观察</text></view></view>
    </view>

    <view wx:if="{{contentLocked}}" class="content-access-gate">
      <text class="gate-kicker">游客试读已完成</text>
      <text class="gate-title serif">{{lockReason === 'expired' ? '开通会员继续阅读' : '注册后继续阅读'}}</text>
      <text class="gate-copy">文章标题、摘要和发布信息可见，完整正文需登录后查看。</text>
      <button bindtap="unlockContent">{{lockReason === 'expired' ? '查看会员权益' : '注册并继续'}}</button>
      <text class="gate-note">是否登录由你选择，可随时返回生态栏目。</text>
    </view>

    <view wx:elif="{{loading}}" class="reader-status">正在读取正文…</view>
    <view wx:elif="{{loadError}}" class="reader-status">
      <text>{{loadError}}</text>
      <button bindtap="verifyServerAccess">重新加载</button>
    </view>
    <view wx:else class="reader-body">
      <block wx:for="{{report.blocks}}" wx:key="id">
        <view wx:if="{{item.type === 'heading'}}" class="block-heading serif">{{item.text}}</view>
        <view wx:elif="{{item.type === 'subheading'}}" class="block-subheading">{{item.text}}</view>
        <view wx:elif="{{item.type === 'list'}}" class="block-list">{{item.text}}</view>
        <view wx:elif="{{item.type === 'quote'}}" class="block-quote">{{item.text}}</view>
        <view wx:elif="{{item.type === 'table'}}" class="block-table">{{item.text}}</view>
        <view wx:else class="block-paragraph">{{item.text}}</view>
      </block>
    </view>
  </view>
  <view wx:if="{{sharedEntry}}" class="shared-entry-nav">
    <button data-url="/pages/terminal/index" bindtap="switchSection">融资</button>
    <button class="active" data-url="/pages/market/index" bindtap="switchSection">生态</button>
    <button data-url="/pages/community/index" bindtap="switchSection">社群</button>
    <button data-url="/pages/profile/index" bindtap="switchSection">我的</button>
  </view>
  <registration-sheet visible="{{registrationOpen}}" required="{{true}}" bind:close="closeRegistration" bind:continue="continueAfterRegistration" />
</view>
