.graph-page { padding: 20rpx 28rpx 160rpx; }.top-actions { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }.segment { display: grid; grid-template-columns: 1fr 1fr; flex: 1; padding: 6rpx; border-radius: 16rpx; background: #ece9e3; }.segment button { margin: 0; padding: 0 22rpx; border-radius: 12rpx; background: transparent; color: #718191; font-size: 22rpx; line-height: 62rpx; }.segment button.active { background: #fff; color: #071827; font-weight: 700; }.profile-link { margin: 0; padding: 0 18rpx; border: 1rpx solid #c8a766; border-radius: 13rpx; background: #fffaf0; color: #9b6d20; font-size: 21rpx; line-height: 72rpx; font-weight: 700; }
.section-heading,.member-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 30rpx 0 16rpx; }.section-heading > view,.member-heading > view { display: flex; flex-direction: column; gap: 6rpx; }.section-heading view text:first-child,.member-heading view text:first-child { color: #9b6d20; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }.section-heading view text:last-child,.member-heading view text:last-child { color: #071827; font-size: 34rpx; font-weight: 760; }.section-heading > text,.member-heading > text { color: #718191; font-size: 20rpx; }
.supply { padding: 26rpx; border: 1rpx solid #e2d8c9; border-radius: 22rpx; background: #fff; }.supply > text { color: #071827; font-size: 24rpx; font-weight: 700; }.supply > view:nth-child(2) { display: flex; height: 15rpx; margin: 24rpx 0; overflow: hidden; border-radius: 99rpx; }.supply i { display: block; }.s1{width:54%;background:#a66d14}.s2{width:17%;background:#c8a766}.s3{width:15%;background:#7a8f9f}.s4{width:14%;background:#0d355c}.supply > view:last-child { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx 30rpx; color: #718191; font-size: 19rpx; }.supply span { display: flex; justify-content: space-between; }.supply strong { color: #071827; }
.role-tabs { width: 100%; margin-top: 18rpx; white-space: nowrap; }.role-tabs button { display: inline-flex; min-width: 200rpx; margin: 0 12rpx 0 0; padding: 18rpx; align-items: center; gap: 15rpx; border: 1rpx solid #e0d7ca; border-radius: 18rpx; background: #fff; text-align: left; }.role-tabs button.active { border-color: #0d355c; background: #0d355c; color: #fff; }.role-tabs button > text { color: #a56e17; font-size: 20rpx; }.role-tabs button view { display: flex; flex-direction: column; gap: 4rpx; }.role-tabs strong { font-size: 22rpx; }.role-tabs small { color: #7b8996; font-size: 17rpx; }.role-tabs .active small { color: rgba(255,255,255,.62); }
.role-hero { margin-top: 20rpx; padding: 32rpx; border-radius: 27rpx; background: linear-gradient(140deg,#071827,#0d426c); color: #fff; }.role-hero > view:first-child { display: flex; justify-content: space-between; color: #dab75f; font-size: 19rpx; }.role-hero > text:nth-child(2) { display: block; margin: 30rpx 0 8rpx; font-size: 40rpx; font-weight: 760; }.role-hero > text:nth-child(3) { color: rgba(255,255,255,.68); font-size: 21rpx; }.role-hero > view:last-child { display: flex; margin-top: 24rpx; align-items: baseline; gap: 12rpx; }.role-hero strong { color: #e0ba5c; font-size: 52rpx; }.role-hero small { color: rgba(255,255,255,.65); font-size: 19rpx; }
.member-list,.directory { overflow: hidden; border: 1rpx solid #e2d8c9; border-radius: 22rpx; }.member-list button,.directory button { display: grid; grid-template-columns: 72rpx 1fr auto; width: 100%; margin: 0; padding: 20rpx 24rpx; align-items: center; gap: 18rpx; border-bottom: 1rpx solid #e5ddd1; background: #fff; text-align: left; }.member-list button:last-child,.directory button:last-child { border: 0; }.avatar { display: flex; width: 68rpx; height: 68rpx; align-items: center; justify-content: center; border-radius: 17rpx; background: #eaf1f5; color: #0d355c; font-size: 25rpx; font-weight: 700; }.avatar.gold { border-radius: 50%; background: #f0d89d; color: #071827; }.member-list button > view,.directory button > view { display: flex; min-width: 0; flex-direction: column; gap: 6rpx; }.member-list strong,.directory strong { color: #071827; font-size: 23rpx; }.member-list small,.directory small { color: #718191; font-size: 18rpx; }.member-list button > text:last-child,.directory button > text:last-child { color: #8a98a4; font-size: 30rpx; }
.search { display: flex; margin-bottom: 18rpx; padding: 0 22rpx; align-items: center; gap: 12rpx; border: 1rpx solid #ddd6cb; border-radius: 18rpx; background: #fff; }.search > text { color: #0d355c; font-size: 40rpx; }.search input { flex: 1; height: 82rpx; color: #071827; font-size: 24rpx; }.directory { border: 0; border-radius: 0; }.directory button { margin-bottom: 15rpx; border: 1rpx solid #e2d8c9!important; border-radius: 20rpx; }.directory button > view > text { display: -webkit-box; overflow: hidden; color: #536879; font-size: 20rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.directory button > view > view { display: flex; gap: 8rpx; }.directory span { padding: 5rpx 10rpx; border-radius: 99rpx; background: #edf3f6; color: #0d355c; font-size: 16rpx; }
.profile-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }.profile-title > text { color: #071827; font-size: 34rpx; font-weight: 760; }.profile-title button { margin: 0; padding: 0; background: transparent; color: #9b6d20; font-size: 22rpx; line-height: 60rpx; }
.profile-hero { display: flex; padding: 32rpx; border-radius: 27rpx; background: linear-gradient(140deg,#071827,#0d426c); color: #fff; gap: 24rpx; }.avatar-large { display: flex; width: 104rpx; height: 104rpx; flex: none; align-items: center; justify-content: center; border-radius: 24rpx; background: #e2bd64; color: #071827; font-size: 39rpx; font-weight: 760; }.profile-hero > view { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; }.profile-hero > view > text:first-child { color: #d9b760; font-size: 17rpx; letter-spacing: 2rpx; }.profile-hero > view > text:nth-child(2) { font-size: 36rpx; font-weight: 760; }.profile-hero > view > text:nth-child(3) { color: rgba(255,255,255,.68); font-size: 20rpx; }.profile-hero > view > view { display: flex; flex-wrap: wrap; gap: 8rpx; }.profile-hero span { padding: 5rpx 10rpx; border-radius: 99rpx; background: rgba(255,255,255,.12); color: #fff; font-size: 16rpx; }
.public-card { margin-top: 20rpx; padding: 30rpx; border: 1rpx solid #e2d8c9; border-radius: 22rpx; background: #fff; }.public-card > text:first-child { color: #9b6d20; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }.public-card > text:nth-child(2) { display: block; margin: 12rpx 0; color: #071827; font-size: 31rpx; font-weight: 750; }.public-card > text:nth-child(3) { color: #506577; font-size: 22rpx; line-height: 1.7; }.public-card > view { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 24rpx; }.public-card > view > view { display: flex; min-height: 120rpx; padding: 18rpx; border-radius: 15rpx; background: #f5f7f8; flex-direction: column; gap: 8rpx; }.public-card small { color: #85919d; font-size: 17rpx; }.public-card strong { color: #243a4b; font-size: 20rpx; line-height: 1.55; }
.privacy { display: block; margin: 18rpx 6rpx; color: #7d8995; font-size: 19rpx; line-height: 1.6; }.edit-hero { padding: 30rpx; border-radius: 24rpx; background: #071827; color: #fff; }.edit-hero text { display: block; }.edit-hero text:first-child { color: #d8b45e; font-size: 18rpx; letter-spacing: 2rpx; }.edit-hero text:nth-child(2) { margin-top: 14rpx; font-size: 34rpx; font-weight: 750; }.edit-hero text:last-child { margin-top: 10rpx; color: rgba(255,255,255,.65); font-size: 20rpx; }.form-card { display: grid; gap: 12rpx; margin-top: 20rpx; padding: 26rpx; border: 1rpx solid #e2d8c9; border-radius: 22rpx; background: #fff; }.form-card label { margin-top: 8rpx; color: #334b5d; font-size: 21rpx; }.form-card input,.form-card textarea { box-sizing: border-box; width: 100%; padding: 18rpx; border: 1rpx solid #dce1e5; border-radius: 13rpx; background: #f8fafb; color: #071827; font-size: 23rpx; }.form-card input { height: 76rpx; }.form-card textarea { min-height: 130rpx; }.save { margin-top: 18rpx; }
