@import "../../utils/directory.wxss";
.follows-content { display: grid; gap: 18rpx; padding-top: 24rpx; }
.follow-summary { padding: 14rpx 4rpx 22rpx; }
.follow-summary text { display: block; }
.follow-summary .serif { color: #071827; font-size: 34rpx; font-weight: 600; }
.follow-summary text:last-child { margin-top: 12rpx; color: #6f7f8f; font-size: 23rpx; line-height: 1.7; }
.topic-card { display: grid; grid-template-columns: 100rpx minmax(0, 1fr) auto; gap: 20rpx; align-items: center; min-height: 124rpx; padding: 20rpx 22rpx; }
.topic-count, .topic-copy { display: flex; min-width: 0; flex-direction: column; gap: 7rpx; }
.topic-count { align-items: center; padding-right: 18rpx; border-right: 1rpx solid #e5e8ec; color: #6f7f8f; font-size: 19rpx; }
.topic-count .mono { color: #0d355c; font-size: 30rpx; font-weight: 600; }
.topic-copy text:first-child { color: #071827; font-size: 27rpx; font-weight: 600; }
.topic-copy text:last-child { color: #6f7f8f; font-size: 21rpx; }
.follow-button { min-height: 58rpx; margin: 0; padding: 0 18rpx; border: 1rpx solid rgba(200,167,102,.72); border-radius: 999rpx; background: #fff; color: #9b6d20; font-size: 21rpx; line-height: 58rpx; }
.follow-button.active { background: #071827; border-color: #071827; color: #fff; }

.follow-type-tabs{display:flex;gap:30rpx;white-space:nowrap;margin-top:20rpx}.follow-type-tabs button{margin:0;padding:22rpx 0;background:transparent;font-size:23rpx;color:#718192;border-radius:0}.follow-type-tabs button.active{color:#0d355c;border-bottom:4rpx solid #c8a766}
