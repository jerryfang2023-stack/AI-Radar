<view class="page-shell">
  <app-header title="社群" />
  <view class="community-page">
    <view class="community-nav" aria-label="社群功能导航">
      <button class="active" data-url="/pages/community-program/index" bindtap="openProtected">造浪者计划</button>
      <button data-url="/pages/community-bounty/index" bindtap="openProtected">悬赏令</button>
      <button data-url="/pages/community-points/index" bindtap="openProtected">积分榜</button>
      <button data-url="/pages/community-graph/index" bindtap="openProtected">行业图谱</button>
    </view>

    <section class="flow-section">
      <view class="section-heading"><view><text class="section-main">本周分享</text><text class="section-meta">第 12–13 场 · 08.27–08.28</text></view><button data-url="/pages/community-program/index" bindtap="openProtected">查看全部 ›</button></view>
      <view class="schedule-list">
        <button wx:for="{{schedules}}" wx:key="id" class="schedule-row" data-url="/pages/community-program/index?type=schedule&id={{item.id}}" bindtap="openProtected">
          <view class="row-time"><text>{{item.day}}</text><text>{{item.date}}</text></view>
          <view class="row-copy"><view><text>{{item.issue}}</text><text wx:if="{{item.status === '进行中'}}" class="live">{{item.status}}</text></view><text class="row-title">{{item.title}}</text><text class="row-note">{{item.speakers}}</text></view>
          <text class="row-action">{{item.status}}</text>
        </button>
      </view>
    </section>

    <section class="flow-section archive-section">
      <view class="section-heading"><view><text class="section-main">最近实录</text></view><button data-url="/pages/community-program/index?tab=archive" bindtap="openProtected">查看全部 ›</button></view>
      <button wx:for="{{archives}}" wx:key="id" class="archive-row" data-url="/pages/community-program/index?type=archive&id={{item.id}}" bindtap="openProtected">
        <view><text class="archive-status">已结束</text><text>{{item.dateShort}}</text></view><view><text class="archive-title">{{item.title}}</text><text>{{item.speakers}}</text></view><text>实录 ›</text>
      </button>
    </section>

    <button class="bounty-feature" data-url="/pages/community-bounty/index?id={{bounty.id}}" bindtap="openProtected">
      <view class="bounty-top"><text>{{bounty.category}} · {{bounty.mode}}</text><text>查看详情 ›</text></view>
      <view class="bounty-title"><text>悬赏令</text><text>{{bounty.points}} 积分</text></view>
      <text class="bounty-question">{{bounty.question}}</text>
      <view class="bounty-bottom"><text>{{bounty.answers}} 个回答 · {{bounty.participants}} 位参与者</text><text>{{bounty.time}}</text></view>
    </button>

    <section class="flow-section role-section">
      <view class="section-heading"><view><text class="section-main">行业图谱</text></view><button data-url="/pages/community-graph/index" bindtap="openProtected">查看图谱 ›</button></view>
      <view class="member-chips">
        <button wx:for="{{featuredMembers}}" wx:key="id" data-url="/pages/community-graph/index?mode=member&id={{item.id}}" bindtap="openProtected"><text>{{item.avatar}}</text><strong>{{item.name}}</strong><small>{{item.roleShort}}</small></button>
        <button data-url="/pages/community-graph/index?tab=directory" bindtap="openProtected"><text class="more">•••</text><strong>更多成员</strong><small>54 位</small></button>
      </view>
    </section>

    <button class="points-strip" data-url="/pages/community-points/index" bindtap="openProtected">
      <view><text>社群积分</text><text>{{points}} <small>积分</small></text></view>
      <view><text>最近积分 <strong>+10</strong></text><text>查看积分 ›</text></view>
    </button>
  </view>
</view>
