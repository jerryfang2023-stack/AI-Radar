<view class="page-shell">
  <app-header title="社群" />
  <view class="community-page">
    <button wx:if="{{experience}}" class="experience-note" bindtap="switchExperience">隔离体验 · {{experienceStatus}} · 点击切换身份</button>
    <view class="community-nav" aria-label="社群功能导航">
      <button class="active" data-url="/pages/community-program/index" bindtap="openProtected">造浪者计划</button>
      <button data-url="/pages/community-bounty/index" bindtap="openProtected">悬赏令</button>
      <button data-url="/pages/community-points/index" bindtap="openProtected">积分榜</button>
      <button data-url="/pages/community-graph/index" bindtap="openProtected">行业图谱</button>
    </view>

    <view wx:if="{{loading}}" class="service-state">正在加载社群内容…</view>
    <button wx:if="{{error}}" class="service-state" bindtap="refresh">{{error}} · 点击重试</button>
    <view class="sharing-section">
      <view class="section-heading"><view><text class="eyebrow">SHARING ARCHIVE</text><text class="section-main">分享实录</text></view><button data-url="/pages/community-program/index?tab=archive" bindtap="openProtected">查看全部 ›</button></view>
      <text wx:if="{{!loading && !error && !featuredArchive}}" class="service-state">暂无已发布实录</text>
      <button wx:if="{{featuredArchive}}" class="community-focus-card" data-url="/pages/community-program/index?type=archive&amp;id={{featuredArchive.id}}" bindtap="openProtected">
        <view class="focus-meta"><text>精选实录 · 第 {{featuredArchive.issue}} 场</text><text>{{featuredArchive.dateShort}}</text></view>
        <text class="focus-title">{{featuredArchive.title}}</text>
        <text class="focus-copy">{{featuredArchive.subtitle}}</text>
        <text class="focus-speakers">{{featuredArchive.speakers}}</text>
        <view class="focus-action"><text>阅读完整实录</text><text>›</text></view>
      </button>
      <view class="community-quick-grid">
        <button wx:for="{{olderArchives}}" wx:key="id" data-url="/pages/community-program/index?type=archive&amp;id={{item.id}}" bindtap="openProtected">
          <view class="quick-meta"><text>第 {{item.issue}} 场</text><text>{{item.dateShort}}</text></view>
          <text class="quick-title">{{item.title}}</text>
          <view class="quick-footer"><text>{{item.speakers}}</text><text>↗</text></view>
        </button>
      </view>
    </view>

    <button wx:if="{{bounty}}" class="bounty-feature" data-url="/pages/community-bounty/index?id={{bounty.id}}" bindtap="openProtected">
      <view class="bounty-top"><text>{{bounty.category}} · {{bounty.mode}}</text><text>查看详情 ›</text></view>
      <view class="bounty-title"><text>悬赏令</text><text>{{bounty.points}} 积分</text></view>
      <text class="bounty-question">{{bounty.question}}</text>
      <view class="bounty-bottom"><text>{{bounty.answers}} 个回答 · {{bounty.participants}} 位参与者</text><text>{{bounty.time}}</text></view>
    </button>

    <button wx:else class="bounty-feature" data-url="/pages/community-bounty/index" bindtap="openProtected"><view class="bounty-title"><text>悬赏令</text></view><text class="bounty-question">发起问题，与成员一起寻找答案</text><view class="bounty-bottom"><text>查看悬赏令</text><text>›</text></view></button>

    <view class="home-section role-section">
      <view class="section-heading"><view><text class="eyebrow">INDUSTRY ROLE MAP</text><text class="section-main">行业图谱</text></view><button data-url="/pages/community-graph/index" bindtap="openProtected">查看图谱 ›</button></view>
      <view class="member-chips">
        <button wx:for="{{featuredMembers}}" wx:key="id" data-url="/pages/community-graph/index?mode=member&amp;id={{item.id}}" bindtap="openProtected"><text>{{item.avatar}}</text><text class="member-name">{{item.name}}</text><text class="member-role">{{item.roleShort}}</text></button>
        <button data-url="/pages/community-graph/index?tab=directory" bindtap="openProtected"><text class="more">•••</text><text class="member-name">更多成员</text><text class="member-role">{{memberCount}} 位</text></button>
      </view>
    </view>

  </view>
</view>
