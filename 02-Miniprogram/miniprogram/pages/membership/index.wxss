.membership-content { display: grid; gap: 22rpx; padding-top: 24rpx; }
.status-card { display: grid; gap: 10rpx; padding: 30rpx; border-radius: 22rpx; background: linear-gradient(135deg, #071827, #0d355c); color: #fff; }
.status-kicker { color: #d9bd82; font-size: 21rpx; letter-spacing: 3rpx; }
.status-title { font-size: 40rpx; font-weight: 600; }
.status-copy { color: rgba(255,255,255,.72); font-size: 22rpx; line-height: 1.6; }
.plan-card { padding: 28rpx; border: 1rpx solid rgba(200,167,102,.55); border-radius: 22rpx; background: #fffaf0; }
.plan-title { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.plan-title > view { display: flex; flex-direction: column; gap: 8rpx; color: #7d6942; font-size: 21rpx; }
.plan-title > view:first-child text:first-child { color: #2f2617; font-size: 36rpx; font-weight: 600; }
.plan-title > view:last-child { align-items: flex-end; }
.plan-price { color: #6b4b16; font-size: 50rpx; font-weight: 700; }
.pricing-list { display: grid; gap: 12rpx; margin-top: 24rpx; }
.pricing-item { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 18rpx 20rpx; border: 1rpx solid rgba(140,112,65,.18); border-radius: 14rpx; background: rgba(255,255,255,.72); }
.pricing-item.selected { border-color: #b88a3e; background: #fff; box-shadow: 0 6rpx 20rpx rgba(111,77,23,.08); }
.pricing-item > view { display: flex; align-items: center; gap: 9rpx; color: #5b4c32; font-size: 21rpx; }
.pricing-item > view:last-child text:first-child { color: #2f2617; font-size: 32rpx; font-weight: 700; }
.plan-radio { width: 22rpx; height: 22rpx; border: 2rpx solid #b7a47e; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 5rpx #fff; }
.pricing-item.selected .plan-radio { border-color: #9b6d20; background: #9b6d20; }
.pricing-badge { padding: 4rpx 10rpx; border-radius: 999rpx; background: #efe3c8; color: #8a6529; font-size: 18rpx; }
.rights-list { display: grid; gap: 18rpx; margin: 28rpx 0; padding: 24rpx 0; border: 1rpx solid rgba(140,112,65,.16); border-width: 1rpx 0; }
.rights-list view { display: grid; grid-template-columns: 34rpx 1fr; gap: 10rpx; color: #4c4437; font-size: 23rpx; }
.rights-list view text:first-child { color: #9b6d20; font-weight: 700; }
.subscribe-button { min-height: 82rpx; border-radius: 14rpx; background: #071827; color: #fff; font-size: 25rpx; line-height: 82rpx; }
.plan-note { display: block; margin-top: 16rpx; color: #806b45; font-size: 20rpx; line-height: 1.6; text-align: center; }
.exchange-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 24rpx; border: 1rpx solid #e5e8ec; border-radius: 18rpx; background: #fff; }
.exchange-card > view { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; }
.exchange-title { color: #071827; font-size: 27rpx; font-weight: 600; }
.exchange-copy { color: #6f7f8f; font-size: 21rpx; line-height: 1.5; }
.exchange-action { flex: 0 0 auto; color: #9b6d20; font-size: 23rpx; font-weight: 600; }
.rules-card { display: grid; gap: 10rpx; padding: 24rpx; border-left: 5rpx solid #c8a766; background: #f7f4ef; }
.rules-card text:first-child { color: #071827; font-size: 26rpx; font-weight: 600; }
.rules-card text:last-child { color: #516273; font-size: 22rpx; line-height: 1.7; }
.support-card { display: grid; grid-template-columns: 72rpx 1fr auto; align-items: center; gap: 18rpx; padding: 20rpx 24rpx; border: 1rpx solid #e5e8ec; border-radius: 18rpx; background: #fff; }
.support-qr { width: 72rpx; height: 72rpx; border-radius: 10rpx; background: #f7f4ef; }
.support-card > view { display: flex; min-width: 0; flex-direction: column; gap: 6rpx; }
.support-title { color: #071827; font-size: 25rpx; font-weight: 600; }
.support-copy { color: #6f7f8f; font-size: 20rpx; }
.support-action { color: #9b6d20; font-size: 21rpx; font-weight: 600; }
