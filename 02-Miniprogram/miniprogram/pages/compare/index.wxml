<view class="page-shell">
  <app-header title="融资比较" show-back right-label="复制摘要" bind:righttap="copyComparison" />
  <view wx:if="{{cards.length}}" class="compare-content">
    <view wx:if="{{contentLocked}}" class="content-access-gate">
      <text class="gate-kicker">会员功能</text><text class="gate-title serif">登录后使用完整融资比较</text>
      <text class="gate-copy">基础融资信息可见，累计融资、机构关系与观澜判断需登录后查看。</text>
      <button bindtap="openRegistration">注册并继续</button>
    </view>
    <scroll-view class="compare-scroll" scroll-x enhanced show-scrollbar="false">
      <view class="compare-track">
        <view wx:for="{{cards}}" wx:key="id" class="compare-card paper-card" data-id="{{item.id}}" bindtap="openCard">
          <view class="compare-head"><view class="avatar">{{item.initial}}</view><text class="company serif">{{item.company}}</text><text class="category">{{item.category}}</text><button class="remove-compare" data-id="{{item.id}}" catchtap="removeCard">取消比较</button></view>
          <view class="compare-fact"><text>本轮金额</text><text class="value mono">{{item.amount}}</text></view>
          <view class="compare-fact"><text>融资轮次</text><text class="value">{{item.round}}</text></view>
          <view class="compare-fact"><text>披露日期</text><text class="value mono">{{item.date}}</text></view>
          <view class="compare-fact"><text>累计融资</text><text class="value mono">{{item.cumulativeAmount}}</text></view>
          <view class="compare-fact"><text>总部</text><text class="value">{{item.headquarters}}</text></view>
          <view class="compare-block"><text class="label">主要投资方</text><text class="line">{{item.investorsText || '未披露'}}</text></view>
          <view class="compare-block"><text class="label">核心判断</text><text class="line">{{item.capitalJudgment || item.summary}}</text></view>
        </view>
      </view>
    </scroll-view>
    <view wx:if="{{cards.length < 2}}" class="compare-shortfall"><text class="title">还需选择 1 家公司</text><text class="copy">返回融资情报，在详情页加入另一家公司后即可继续比较。</text><button bindtap="backToFunding">返回融资情报</button></view>
    <view class="compare-note">左右滑动查看公司；点击卡片可打开完整融资详情。</view>
  </view>
  <view wx:else class="empty-state"><view class="title serif">暂无比较公司</view><view class="copy">返回融资情报，在详情页选择 2–3 家公司进行比较。</view><button class="empty-action" bindtap="backToFunding">返回融资情报</button></view>
  <registration-sheet visible="{{registrationOpen}}" required="{{true}}" bind:close="closeRegistration" bind:continue="continueAfterRegistration" />
</view>
