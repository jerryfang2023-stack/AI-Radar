.growth-content { padding-top: 24rpx; }
.wallet-card { padding: 32rpx; border-radius: 22rpx; background: linear-gradient(135deg, #071827, #0d355c); color: #fff; }
.wallet-card text { display: block; }
.wallet-label { color: rgba(255,255,255,.65); font-size: 22rpx; }
.wallet-value { margin-top: 8rpx; color: #d9bd82; font-size: 64rpx; font-weight: 600; }
.wallet-level { margin-top: 8rpx; font-size: 25rpx; }
.wallet-track { height: 8rpx; margin-top: 24rpx; overflow: hidden; border-radius: 99rpx; background: rgba(255,255,255,.16); }
.wallet-track view { height: 100%; background: #c8a766; }
.wallet-next { margin-top: 12rpx; color: rgba(255,255,255,.68); font-size: 21rpx; }
.task-list, .ledger-list { overflow: hidden; }
.task-row, .ledger-row { display: flex; min-height: 90rpx; align-items: center; justify-content: space-between; gap: 20rpx; padding: 14rpx 22rpx; border-bottom: 1rpx solid #e5e8ec; }
.task-row:last-child, .ledger-row:last-child { border-bottom: 0; }
.task-row > view, .ledger-row > view { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; }
.task-row > view text:first-child, .ledger-row > view text:first-child { color: #071827; font-size: 25rpx; font-weight: 600; }
.task-row > view text:last-child, .ledger-row > view text:last-child { color: #6f7f8f; font-size: 20rpx; }
.task-reward { color: #9b6d20; font-size: 22rpx; }
.task-reward.done, .income { color: #2f8c57; }
.expense { color: #b85c5c; }
.benefit-card { display: flex; min-height: 112rpx; align-items: center; justify-content: space-between; gap: 24rpx; margin-bottom: 16rpx; padding: 20rpx 22rpx; }
.benefit-card > view { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 8rpx; }
.benefit-title { color: #071827; font-size: 26rpx; font-weight: 600; }
.benefit-copy { color: #6f7f8f; font-size: 21rpx; line-height: 1.5; }
.redeem-button { min-height: 60rpx; margin: 0; padding: 0 16rpx; border-radius: 12rpx; background: #071827; color: #fff; font-size: 21rpx; line-height: 60rpx; }
.redeem-button.done { background: #eef1f3; color: #6f7f8f; }
.rules-note { margin-top: 30rpx; padding: 26rpx; border-left: 5rpx solid #c8a766; background: #f7f4ef; }
.rules-note text { display: block; }
.rules-note .serif { margin-bottom: 10rpx; font-size: 26rpx; font-weight: 600; }
.rules-note text:last-child { color: #516273; font-size: 22rpx; line-height: 1.7; }
