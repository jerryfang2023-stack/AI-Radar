.points-page { padding: 24rpx 28rpx 160rpx; }.leaderboard-hero,.detail-hero,.rules-hero { padding: 34rpx; border-radius: 28rpx; background: linear-gradient(140deg,#071827,#0d426c); color: #fff; }.leaderboard-hero > text,.rules-hero > text { display: block; }.leaderboard-hero > text:first-child,.rules-hero > text:first-child,.detail-hero > text:first-child { color: #d8b45e; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }.leaderboard-hero > text:nth-child(2),.rules-hero > text:nth-child(2) { margin-top: 14rpx; font-size: 39rpx; font-weight: 780; }.leaderboard-hero > view { display: grid; grid-template-columns: repeat(3,1fr); margin-top: 28rpx; border-top: 1rpx solid rgba(255,255,255,.2); }.leaderboard-hero span { display: flex; padding-top: 22rpx; align-items: center; border-right: 1rpx solid rgba(255,255,255,.18); flex-direction: column; }.leaderboard-hero span:last-child { border: 0; }.leaderboard-hero strong { color: #dfba5d; font-size: 31rpx; }.leaderboard-hero small { color: rgba(255,255,255,.62); font-size: 17rpx; }
.my-rank { display: flex; width: 100%; margin: 18rpx 0 30rpx; padding: 22rpx 26rpx; align-items: center; justify-content: space-between; border: 1rpx solid #d3ad59; border-radius: 20rpx; background: #fff7e6; text-align: left; }.my-rank > view { display: flex; flex-direction: column; gap: 6rpx; }.my-rank small { color: #8a7655; font-size: 18rpx; }.my-rank strong { color: #071827; font-size: 24rpx; }.my-rank > view:last-child { align-items: flex-end; }.my-rank > view:last-child strong { color: #a46f18; font-size: 36rpx; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 16rpx; }.section-head > view { display: flex; flex-direction: column; gap: 6rpx; }.section-head view text:first-child,.rule-heading text:first-child { color: #9b6d20; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }.section-head view text:last-child { color: #071827; font-size: 34rpx; font-weight: 760; }.section-head > text { color: #748394; font-size: 19rpx; }
.rank-list { overflow: hidden; border: 1rpx solid #e2d8c9; border-radius: 22rpx; }.rank-row { display: grid; grid-template-columns: 54rpx 62rpx 1fr auto; gap: 16rpx; min-height: 104rpx; padding: 16rpx 20rpx; align-items: center; border-bottom: 1rpx solid #e5ddd2; background: #fff; }.rank-row:last-child { border: 0; }.rank-row.me { background: #fff7e5; }.rank { color: #9b6d20; font-size: 20rpx; font-weight: 700; }.avatar { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border-radius: 50%; background: #f1dca6; color: #071827; font-weight: 700; }.rank-row > view { display: flex; flex-direction: column; gap: 5rpx; }.rank-row > view strong { color: #071827; font-size: 22rpx; }.rank-row > view small { color: #7a8896; font-size: 17rpx; }.rank-row > view:last-child { align-items: flex-end; }.rank-row > view:last-child strong { color: #0d355c; font-size: 27rpx; }
.detail-hero { display: flex; align-items: center; flex-direction: column; }.detail-hero > text:nth-child(2) { margin-top: 12rpx; color: #dfba5d; font-size: 76rpx; font-weight: 750; }.detail-hero > text:nth-child(3) { color: rgba(255,255,255,.65); font-size: 20rpx; }.detail-hero > view { display: grid; grid-template-columns: 1fr 1fr; width: 100%; margin-top: 24rpx; border-top: 1rpx solid rgba(255,255,255,.2); }.detail-hero span { display: flex; padding-top: 20rpx; align-items: center; flex-direction: column; }.detail-hero span:first-child { border-right: 1rpx solid rgba(255,255,255,.2); }.detail-hero span strong { color: #fff; font-size: 28rpx; }.detail-hero span small { color: rgba(255,255,255,.6); font-size: 17rpx; }.detail-title { display: block; margin: 34rpx 0 16rpx; color: #071827; font-size: 34rpx; font-weight: 760; }.ledger { overflow: hidden; border: 1rpx solid #e2d9cb; border-radius: 22rpx; }.ledger view { display: grid; grid-template-columns: 90rpx 1fr auto; gap: 18rpx; padding: 24rpx; border-bottom: 1rpx solid #e5ddd2; background: #fff; color: #718191; font-size: 20rpx; }.ledger view:last-child { border: 0; }.ledger view text:nth-child(2) { color: #071827; }.ledger strong { color: #a46f18; font-size: 25rpx; }
.rules-hero { min-height: 170rpx; display: flex; justify-content: center; flex-direction: column; }.rule-heading { display: flex; margin: 34rpx 0 16rpx; flex-direction: column; gap: 7rpx; }.rule-heading text:last-child { color: #071827; font-size: 34rpx; font-weight: 760; }.rule-list { overflow: hidden; border: 1rpx solid #e2d9cb; border-radius: 22rpx; }.rule-list > view { display: grid; grid-template-columns: 100rpx 1fr; gap: 20rpx; padding: 22rpx; align-items: center; border-bottom: 1rpx solid #e5ddd2; background: #fff; }.rule-list > view:last-child { border: 0; }.rule-list > view > text { display: flex; height: 76rpx; align-items: center; justify-content: center; border-radius: 18rpx; background: #f5ead5; color: #9b6d20; font-size: 29rpx; font-weight: 730; flex-direction: column; }.rule-list > view > text small { font-size: 15rpx; }.rule-list view view { display: flex; flex-direction: column; gap: 7rpx; }.rule-list strong { color: #071827; font-size: 23rpx; }.rule-list view view small { color: #718191; font-size: 19rpx; line-height: 1.55; }
