.bounty-page { padding: 24rpx 28rpx 160rpx; }.hero,.detail-hero { padding: 34rpx; border-radius: 28rpx; background: linear-gradient(140deg,#071827,#0d4169); color: #fff; }
.hero > text { display: block; }.hero > text:first-child,.kicker { color: #d8b45e; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }.hero > text:nth-child(2) { margin-top: 16rpx; font-size: 37rpx; font-weight: 760; line-height: 1.45; }
.hero > view { display: grid; grid-template-columns: repeat(3,1fr); margin-top: 30rpx; border: 1rpx solid rgba(255,255,255,.18); border-radius: 16rpx; }.hero span { display: flex; padding: 20rpx 6rpx; align-items: center; border-right: 1rpx solid rgba(255,255,255,.18); flex-direction: column; }.hero span:last-child { border: 0; }.hero strong { color: #dfba5d; font-size: 31rpx; }.hero small { margin-top: 6rpx; color: rgba(255,255,255,.65); font-size: 18rpx; }
.create { display: flex; width: 100%; margin: 18rpx 0; padding: 20rpx 26rpx; align-items: center; justify-content: space-between; border: 1rpx solid #d6b262; border-radius: 20rpx; background: #fff7e5; text-align: left; }.create view { display: flex; flex-direction: column; }.create small { color: #9b6d20; font-size: 17rpx; }.create strong { color: #071827; font-size: 24rpx; }.create > text { display: flex; width: 54rpx; height: 54rpx; align-items: center; justify-content: center; border-radius: 50%; background: #0d355c; color: #fff; font-size: 32rpx; }
.filters { display: flex; gap: 10rpx; margin: 20rpx 0; }.filters button { margin: 0; padding: 0 24rpx; border: 1rpx solid #ddd6cb; border-radius: 99rpx; background: #fff; color: #748394; font-size: 20rpx; line-height: 58rpx; }.filters button.active { border-color: #0d355c; background: #0d355c; color: #fff; }
.case-card { display: block; width: 100%; margin: 0 0 18rpx; padding: 26rpx; border: 1rpx solid #e2d7c6; border-radius: 22rpx; background: #fff; text-align: left; }.case-card > view:first-child,.footer { display: flex; justify-content: space-between; color: #9b6d20; font-size: 18rpx; }.question { display: block; margin: 18rpx 0 12rpx; color: #071827; font-size: 27rpx; font-weight: 720; line-height: 1.55; }.case-card > text:nth-child(3),.footer { color: #748394; font-size: 20rpx; }.footer { margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid #e7dfd2; }.footer text:last-child { color: #9b6d20; }
.detail-hero > view { display: flex; justify-content: space-between; color: #d8b45e; font-size: 20rpx; }.detail-question { display: block; margin: 22rpx 0 16rpx; font-size: 34rpx; font-weight: 760; line-height: 1.45; }.detail-hero > text:nth-child(3) { color: rgba(255,255,255,.7); font-size: 22rpx; line-height: 1.7; }.founder { display: flex!important; margin-top: 24rpx; align-items: center; justify-content: flex-start!important; gap: 14rpx; }.founder > text { display: flex; width: 54rpx; height: 54rpx; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.14); color: #fff; }.founder view { display: flex; flex-direction: column; }.founder strong { color: #fff; font-size: 22rpx; }.founder small { color: rgba(255,255,255,.6); font-size: 18rpx; }
.progress { display: grid; grid-template-columns: repeat(3,1fr); margin: 26rpx 0; }.progress view { position: relative; display: flex; align-items: center; flex-direction: column; gap: 8rpx; color: #83909c; font-size: 18rpx; }.progress view::after { position: absolute; top: 9rpx; right: -50%; left: 50%; height: 2rpx; background: #d8d5cf; content: ''; }.progress view:last-child::after { display: none; }.progress i { z-index: 1; width: 18rpx; height: 18rpx; border: 4rpx solid #d8d5cf; border-radius: 50%; background: #fffdf8; }.progress .done { color: #9b6d20; }.progress .done i { border-color: #c8a766; background: #c8a766; }.progress .done::after { background: #c8a766; }
.detail-card { margin-top: 20rpx; padding: 28rpx; border: 1rpx solid #e2d8c9; border-radius: 22rpx; background: #fff; }.title { display: block; margin: 12rpx 0 18rpx; color: #071827; font-size: 31rpx; font-weight: 740; }.copy { color: #5f7283; font-size: 22rpx; line-height: 1.7; }.questions { display: flex; margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid #e5ddd1; flex-direction: column; gap: 14rpx; color: #334b5e; font-size: 21rpx; line-height: 1.6; }
textarea { box-sizing: border-box; width: 100%; min-height: 210rpx; padding: 22rpx; border: 1rpx solid #d8dde1; border-radius: 15rpx; background: #f8fafb; color: #071827; font-size: 23rpx; }.primary-button { margin-top: 18rpx; }.cocreate { width: 100%; margin-top: 18rpx; border: 1rpx solid #c8a766; border-radius: 16rpx; background: #fffaf0; color: #9b6d20; font-size: 25rpx; line-height: 82rpx; }.cocreate[disabled] { opacity: .7; }
