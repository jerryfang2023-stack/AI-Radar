<view class="page-shell">
  <app-header title="观察列表" />
  <view wx:if="{{cards.length}}" class="watch-intro"><text class="serif">已收藏 {{cards.length}} 笔融资</text><text>收藏数据仅保存在当前微信设备。</text></view>
  <view wx:if="{{cards.length}}" class="watch-list"><funding-row wx:for="{{cards}}" wx:key="id" card="{{item}}" watched bind:open="openCard" bind:watch="toggleWatch" /></view>
  <view wx:else class="empty-state"><view class="title serif">还没有收藏融资</view><view class="copy">在融资终端点击“收藏”，即可建立你的观察列表。</view><button class="primary-button empty-action" bindtap="openTerminal">浏览融资终端</button></view>
</view>
