.report-content { padding-top: 18rpx; }
.report-intro { position: relative; padding: 22rpx 4rpx 28rpx; }
.intro-saved { position: absolute; top: 4rpx; right: 0; min-height: 58rpx; margin: 0; padding: 0; background: transparent; color: #9b6d20; font-size: 22rpx; line-height: 58rpx; }
.report-intro text { display: block; }
.intro-kicker { color: #9b6d20; font-size: 20rpx; font-weight: 600; letter-spacing: 4rpx; }
.intro-title { margin-top: 10rpx; color: #071827; font-size: 40rpx; font-weight: 600; line-height: 1.35; }
.intro-copy { max-width: 650rpx; margin-top: 14rpx; color: #6f7f8f; font-size: 23rpx; line-height: 1.75; }
.report-tabs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8rpx; padding: 7rpx; border-radius: 16rpx; background: #f0ede7; }
.report-tab { min-height: 66rpx; margin: 0; border-radius: 12rpx; background: transparent; color: #6f7f8f; font-size: 24rpx; line-height: 66rpx; }
.report-tab.active { background: #fff; color: #071827; font-weight: 600; box-shadow: 0 5rpx 16rpx rgba(7,24,39,.08); }
.featured-report { margin-top: 24rpx; overflow: hidden; padding: 28rpx 28rpx 0; border-radius: 22rpx; background: linear-gradient(135deg, #071827, #0d355c); color: #fff; box-shadow: 0 16rpx 34rpx rgba(7,24,39,.12); }
.featured-meta { display: flex; align-items: center; justify-content: space-between; color: #d8bd84; font-size: 21rpx; }
.featured-title { display: block; margin-top: 18rpx; font-size: 34rpx; font-weight: 600; line-height: 1.45; }
.featured-summary { display: -webkit-box; margin-top: 14rpx; overflow: hidden; color: rgba(255,255,255,.72); font-size: 23rpx; line-height: 1.7; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
.evidence-row { display: flex; gap: 14rpx; margin-top: 20rpx; }
.evidence-row text { padding: 7rpx 11rpx; border: 1rpx solid rgba(255,255,255,.17); border-radius: 999rpx; color: rgba(255,255,255,.68); font-size: 19rpx; }
.featured-action { display: flex; align-items: center; justify-content: space-between; margin: 24rpx -28rpx 0; padding: 19rpx 28rpx; background: rgba(255,255,255,.07); color: #e6d3aa; font-size: 22rpx; }
.featured-action .mono { color: rgba(255,255,255,.58); font-size: 19rpx; }
.archive-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 34rpx 2rpx 18rpx; }
.archive-heading .serif { color: #071827; font-size: 30rpx; font-weight: 600; }
.archive-heading text:last-child { color: #8996a3; font-size: 21rpx; }
.report-list { display: grid; gap: 16rpx; }
.report-card { display: grid; grid-template-columns: 104rpx minmax(0, 1fr); gap: 22rpx; padding: 22rpx; }
.report-date { display: flex; flex-direction: column; gap: 8rpx; padding-right: 18rpx; border-right: 1rpx solid #e5e8ec; color: #6f7f8f; font-size: 20rpx; }
.report-date .mono { color: #0d355c; font-size: 23rpx; font-weight: 600; }
.report-main { min-width: 0; }
.report-title { display: -webkit-box; overflow: hidden; color: #071827; font-size: 27rpx; font-weight: 600; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.report-summary { display: -webkit-box; margin-top: 10rpx; overflow: hidden; color: #6f7f8f; font-size: 21rpx; line-height: 1.6; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.report-footer { display: flex; justify-content: space-between; margin-top: 15rpx; color: #8996a3; font-size: 19rpx; }
.report-footer text:last-child { color: #9b6d20; }
