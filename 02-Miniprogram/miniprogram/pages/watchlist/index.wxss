.report-content { padding: 22rpx 30rpx 180rpx; }
.report-tabs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8rpx; padding: 6rpx; border-radius: 16rpx; background: #eeeae2; }
.report-tab { min-height: 66rpx; margin: 0; border-radius: 12rpx; background: transparent; color: #6f7f8f; font-size: 24rpx; line-height: 66rpx; }
.report-tab.active { background: #fff; color: #071827; font-weight: 600; box-shadow: 0 5rpx 16rpx rgba(7,24,39,.08); }
.featured-report { overflow: hidden; padding: 34rpx 32rpx 0; border-radius: 28rpx; background: linear-gradient(145deg, #071827, #0d355c); color: #fff; box-shadow: 0 18rpx 46rpx rgba(7,24,39,.12); }
.featured-meta { display: flex; align-items: center; justify-content: space-between; color: #d9bd82; font-size: 21rpx; }
.featured-meta .mono { color: rgba(255,255,255,.58); }
.featured-title { display: block; margin-top: 18rpx; font-size: 33rpx; font-weight: 700; line-height: 1.42; }
.featured-summary { display: -webkit-box; margin-top: 14rpx; overflow: hidden; color: rgba(255,255,255,.7); font-size: 22rpx; line-height: 1.65; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.evidence-row { display: flex; gap: 14rpx; margin-top: 20rpx; }
.evidence-row text { padding: 7rpx 11rpx; border-radius: 7rpx; background: rgba(255,255,255,.62); color: #5f5239; font-size: 19rpx; }
.featured-action { display: flex; align-items: center; justify-content: space-between; margin: 24rpx -32rpx 0; padding: 21rpx 32rpx; border-top: 1rpx solid rgba(255,255,255,.14); background: rgba(255,255,255,.05); color: #e5cf9d; font-size: 22rpx; font-weight: 600; }
.featured-action .mono { color: rgba(255,255,255,.58); font-size: 19rpx; font-weight: 400; }
.archive-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 34rpx 2rpx 18rpx; }
.archive-heading .serif { color: #071827; font-size: 30rpx; font-weight: 600; }
.archive-heading text:last-child { color: #8996a3; font-size: 21rpx; }
.report-list { display: grid; gap: 1rpx; overflow: hidden; border: 1rpx solid #e7e1d5; border-radius: 24rpx; background: #e7e1d5; }
.report-card { display: grid; grid-template-columns: 104rpx minmax(0, 1fr); gap: 22rpx; padding: 24rpx; background: #fff; }
.report-date { display: flex; flex-direction: column; gap: 8rpx; padding-right: 18rpx; border-right: 1rpx solid #e5e8ec; color: #6f7f8f; font-size: 20rpx; }
.report-date .mono { color: #0d355c; font-size: 23rpx; font-weight: 600; }
.report-main { min-width: 0; }
.report-title { display: -webkit-box; overflow: hidden; color: #071827; font-size: 27rpx; font-weight: 600; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.report-summary { display: -webkit-box; margin-top: 10rpx; overflow: hidden; color: #6f7f8f; font-size: 21rpx; line-height: 1.6; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.report-footer { display: flex; justify-content: space-between; margin-top: 15rpx; color: #8996a3; font-size: 19rpx; }
.report-footer text:last-child { color: #9b6d20; }
