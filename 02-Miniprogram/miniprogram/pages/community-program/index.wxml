<view class="page-shell">
  <app-header title="造浪者计划" show-back fallback-url="/pages/community/index" />
  <view class="program-page">
    <block wx:if="{{mode === 'list'}}">
      <view class="segment"><button class="{{activeTab === 'schedule' ? 'active' : ''}}" data-tab="schedule" bindtap="switchTab">分享排期</button><button class="{{activeTab === 'archive' ? 'active' : ''}}" data-tab="archive" bindtap="switchTab">分享实录</button></view>
      <view wx:if="{{activeTab === 'schedule'}}">
        <view class="hero"><text>ZAOLANG PROGRAM</text><text>把真实实践带到同一张桌上</text><view><strong>13</strong><small>已排期场次</small><strong>36</strong><small>分享成员</small></view></view>
        <text class="list-title">近期排期</text>
        <button wx:for="{{schedules}}" wx:key="id" class="program-card" data-id="{{item.id}}" bindtap="openSchedule"><view><text>{{item.issue}}</text><text>{{item.date}}</text></view><text class="title">{{item.title}}</text><text>{{item.speakers}}</text><text class="link">查看完整排期 ›</text></button>
      </view>
      <view wx:else>
        <view class="hero"><text>SHARING ARCHIVE</text><text>完整实录，沉淀每一次真实分享</text><view><strong>12</strong><small>期实录</small><strong>36</strong><small>分享成员</small></view></view>
        <text class="list-title">分享实录</text>
        <button wx:for="{{archives}}" wx:key="id" class="archive-card" data-id="{{item.id}}" bindtap="openArchive"><text class="issue">{{item.issue}}</text><view><text class="title">{{item.title}}</text><text>{{item.speakers}}</text><text>{{item.date}} · 已发布</text></view><text>›</text></button>
      </view>
    </block>
    <block wx:elif="{{mode === 'schedule'}}">
      <view class="detail-hero"><text>{{item.issue}} · {{item.status}}</text><text>{{item.title}}</text><text>{{item.date}}</text><text>{{item.speakers}}</text></view>
      <view class="detail-card"><text class="eyebrow">AGENDA</text><text class="detail-title">分享安排</text><view class="agenda"><text>20:00</text><view><strong>主题分享</strong><small>{{item.note}}</small></view></view><view class="agenda"><text>20:45</text><view><strong>现场问答</strong><small>围绕真实业务问题开放交流。</small></view></view><view class="agenda"><text>21:00</text><view><strong>实录整理</strong><small>经分享者确认后发布完整实录。</small></view></view></view>
      <button class="primary-button" bindtap="back">已加入排期</button>
    </block>
    <block wx:else>
      <view class="detail-hero archive"><text>SHARING ARCHIVE · {{item.issue}}</text><text>{{item.title}}</text><text>{{item.subtitle}}</text><text>{{item.speakers}}</text></view>
      <view class="detail-card"><text class="eyebrow">SUMMARY</text><text class="detail-title">本期摘要</text><text class="body-copy">{{item.summary}}</text></view>
      <view class="detail-card"><text class="eyebrow">SHARING NOTES</text><text class="detail-title">分享整理</text><view wx:for="{{item.chapters}}" wx:key="index" class="chapter"><text>{{item.index}}</text><view><strong>{{item.title}}</strong><small>{{item.copy}}</small></view></view></view>
      <view class="detail-card"><text class="eyebrow">SPEAKERS</text><text class="detail-title">本期分享者</text><text class="body-copy">{{item.speakers}}</text></view>
    </block>
  </view>
</view>
