<import src="../../templates/directory.wxml"/>
<view class="page-shell"><app-header title="{{title}}" show-back="{{true}}" fallback-url="/pages/market/index"/><view class="page-content directory-content"><view class="directory-form"><input placeholder="搜索公司、产品、机构、人物" value="{{directoryInput}}" bindinput="directoryInput" bindconfirm="searchDirectory" confirm-type="search"/><button bindtap="searchDirectory">搜索</button></view><template wx:if="{{isSearch}}" is="directory-tabs" data="{{directoryTabs,directoryType}}"/><view class="directory-filters"><view class="directory-market"><button class="{{directoryMarket==='china'?'active':''}}" data-market="china" bindtap="changeDirectoryMarket">中国</button><button class="{{directoryMarket==='global'?'active':''}}" data-market="global" bindtap="changeDirectoryMarket">全球</button></view><picker range="{{directoryCategories}}" value="{{directoryCategoryIndex}}" bindchange="changeDirectoryCategory"><view><text>{{directoryCategory==='全部赛道' && directoryType==='products'?'全部场景':directoryCategory}}</text><text>⌄</text></view></picker></view><block wx:if="{{isSearch && directoryType==='all' && directoryQuery}}"><block wx:for="{{directoryGroups}}" wx:key="id"><view class="directory-group-head"><text>{{item.name}}</text><button data-type="{{item.id}}" bindtap="changeDirectoryType">查看全部</button></view><template is="directory-rows" data="{{directoryItems:item.items}}"/><view wx:if="{{!item.items.length}}" class="directory-empty">暂无匹配结果</view></block></block><block wx:else><view class="directory-count">{{directoryTotal}} 个匹配对象</view><template is="directory-rows" data="{{directoryItems}}"/><button wx:if="{{directoryMore}}" class="directory-more" bindtap="moreDirectory">加载更多</button></block><view wx:if="{{!directoryTotal}}" class="directory-empty">没有找到匹配对象<button class="directory-more" bindtap="clearDirectory">清除筛选</button></view></view></view>
