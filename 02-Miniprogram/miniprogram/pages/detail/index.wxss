.detail-content { padding: 30rpx 28rpx 120rpx; }
.identity { display: flex; gap: 20rpx; align-items: center; }
.identity.entity-link { width: 100%; margin: 0; padding: 0 0 20rpx; border: 0; border-bottom: 1rpx solid #e5e8ec; border-radius: 0; background: transparent; color: inherit; line-height: 1.4; text-align: left; }
.entity-link-note { flex: none; color: #9b6d20; font-size: 20rpx; }
.avatar { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; border-radius: 50%; background: #071827; color: #fff; font-size: 34rpx; font-weight: 600; }
.identity-copy { display: flex; flex: 1; flex-direction: column; gap: 8rpx; min-width: 0; }
.company { overflow: hidden; color: #071827; font-size: 44rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.category { color: #6f7f8f; font-size: 23rpx; }
.hero-facts { display: grid; grid-template-columns: repeat(2, 1fr); margin-top: 28rpx; padding: 10rpx 24rpx; }
.hero-facts > view { display: flex; flex-direction: column; gap: 10rpx; padding: 22rpx 10rpx; border-bottom: 1rpx solid #e5e8ec; }
.hero-facts > view:nth-last-child(-n+2) { border-bottom: 0; }
.fact-label { color: #6f7f8f; font-size: 22rpx; }
.fact-value { color: #071827; font-size: 30rpx; }
.evidence-banner { display: flex; gap: 10rpx; align-items: center; margin-top: 18rpx; padding: 18rpx 22rpx; border-radius: 12rpx; background: rgba(47, 140, 87, 0.08); color: #2f8c57; font-size: 23rpx; }
.detail-actions { display: grid; grid-template-columns: .8fr 1.35fr; gap: 16rpx; margin-top: 18rpx; }
.favorite-action, .compare-action { min-height: 78rpx; margin: 0; border: 1rpx solid #0d355c; border-radius: 14rpx; background: #fff; color: #0d355c; font-size: 25rpx; font-weight: 600; line-height: 78rpx; }
.favorite-action { border-color: rgba(200, 167, 102, 0.72); color: #8c641f; }
.favorite-action.active { background: rgba(200, 167, 102, 0.14); }
.compare-action.active { border-color: rgba(200, 167, 102, 0.75); background: rgba(200, 167, 102, 0.12); color: #8c641f; }
.section { padding: 38rpx 2rpx 0; }
.section-title { display: block; margin: 0 0 18rpx; color: #071827; font-size: 34rpx; font-weight: 600; }
.section-kicker { display: block; margin-bottom: 8rpx; color: #a87827; font-size: 21rpx; font-weight: 600; letter-spacing: 0.12em; }
.body-copy { display: block; color: #33465a; font-size: 27rpx; line-height: 1.8; }
.meta-line { display: flex; flex-direction: column; gap: 8rpx; margin-top: 18rpx; color: #6f7f8f; font-size: 23rpx; }
.simple-list { border-top: 1rpx solid #e5e8ec; }
.simple-row { display: flex; gap: 20rpx; align-items: center; justify-content: space-between; min-height: 88rpx; border-bottom: 1rpx solid #e5e8ec; color: #071827; font-size: 26rpx; }
.row-note { max-width: 220rpx; color: #6f7f8f; font-size: 22rpx; text-align: right; }
.relation-row { width: 100%; margin: 0; border: 0; border-bottom: 1rpx solid #e5e8ec; border-radius: 0; background: transparent; line-height: 1.4; text-align: left; }
.relation-row > view { display: flex; flex-direction: column; gap: 7rpx; min-width: 0; }
.relation-row .row-note { max-width: none; text-align: left; }
.relation-note { flex: none; color: #9b6d20; font-size: 20rpx; }
.detail-list { border-top: 1rpx solid #e5e8ec; }
.detail-item { display: flex; flex-direction: column; gap: 12rpx; padding: 22rpx 0; border-bottom: 1rpx solid #e5e8ec; }
.detail-item-title { color: #071827; font-size: 27rpx; font-weight: 600; }
.detail-note { color: #6f7f8f; font-size: 22rpx; line-height: 1.6; }
.tag-list { display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag-list text { padding: 7rpx 11rpx; border-radius: 8rpx; background: #f3efe7; color: #6e5b37; font-size: 20rpx; }
.bullet-list { display: grid; gap: 0; }
.bullet-row { display: grid; grid-template-columns: 52rpx 1fr; gap: 14rpx; padding: 20rpx 0; border-bottom: 1rpx solid #e5e8ec; color: #33465a; font-size: 26rpx; line-height: 1.7; }
.bullet-index { color: #a87827; }
.risk-list .bullet-index { color: #b85c5c; }
.judgment { margin-top: 38rpx; padding: 28rpx 24rpx; border-left: 5rpx solid #c8a766; background: rgba(200, 167, 102, 0.08); }
.timeline { border-left: 2rpx solid #e5e8ec; }
.timeline-row { display: grid; grid-template-columns: 196rpx 1fr; gap: 20rpx; padding: 0 0 28rpx 24rpx; color: #516273; }
.timeline-row.current { border-left: 4rpx solid #c8a766; color: #071827; }
.timeline-row > view { display: flex; justify-content: space-between; }
.timeline-date, .timeline-amount { font-size: 22rpx; }
.timeline-round { font-size: 25rpx; font-weight: 600; }
.source-list { display: grid; gap: 18rpx; }
.source-card { display: flex; flex-direction: column; gap: 12rpx; padding: 24rpx; }
.source-publisher { color: #a87827; font-size: 21rpx; font-weight: 600; }
.source-title { color: #071827; font-size: 27rpx; font-weight: 600; line-height: 1.5; }
.source-quote { color: #516273; font-size: 23rpx; line-height: 1.65; }
.source-button { align-self: flex-start; min-height: 58rpx; margin: 6rpx 0 0; padding: 0 16rpx; border: 1rpx solid rgba(200, 167, 102, 0.65); border-radius: 10rpx; background: #fff; color: #8c641f; font-size: 22rpx; line-height: 58rpx; }
.missing { padding: 22rpx 0; color: #6f7f8f; font-size: 25rpx; }
