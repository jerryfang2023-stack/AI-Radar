.terminal-head { position: sticky; z-index: 8; top: 0; padding: 16rpx 28rpx 0; background: rgba(255, 253, 248, 0.98); }
.search-box { display: flex; gap: 16rpx; align-items: center; height: 88rpx; padding: 0 22rpx; border: 1rpx solid #d7dde3; border-radius: 16rpx; background: #fff; }
.search-box input { flex: 1; height: 100%; color: #071827; font-size: 28rpx; }
.clear-button { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; margin: 0; padding: 0; background: transparent; }
.quick-filters { width: 100%; margin-top: 18rpx; white-space: nowrap; }
.quick-filter-track { display: inline-flex; gap: 12rpx; padding-right: 24rpx; }
.chip { min-height: 70rpx; margin: 0; padding: 0 24rpx; border: 1rpx solid #dfe3e7; border-radius: 12rpx; background: #fff; color: #071827; font-size: 24rpx; line-height: 70rpx; }
.chip.active { border-color: #071827; background: #071827; color: #fff; }
.chip.gold { border-color: rgba(200, 167, 102, 0.75); color: #9b6d20; }
.summary-strip { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 18rpx; padding: 24rpx 6rpx; }
.summary-strip > view { display: flex; flex-direction: column; gap: 8rpx; align-items: center; border-right: 1rpx solid #e5e8ec; }
.summary-strip > view:last-child { border-right: 0; }
.summary-value { color: #071827; font-size: 38rpx; }
.summary-label { color: #6f7f8f; font-size: 22rpx; }
.list-toolbar { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; margin-top: 12rpx; border-bottom: 1rpx solid #e5e8ec; }
.toolbar-actions { display: flex; gap: 10rpx; }
.toolbar-button { min-height: 60rpx; margin: 0; padding: 0 14rpx; background: transparent; color: #071827; font-size: 24rpx; line-height: 60rpx; }
.result-note { padding: 18rpx 30rpx 6rpx; color: #6f7f8f; font-size: 22rpx; }
.funding-list { padding: 0 18rpx 180rpx; }
.load-note { padding: 28rpx 20rpx 180rpx; color: #6f7f8f; font-size: 22rpx; text-align: center; }
.selection-bar { position: fixed; z-index: 20; right: 22rpx; bottom: calc(112rpx + env(safe-area-inset-bottom)); left: 22rpx; display: grid; grid-template-columns: 1fr 170rpx 190rpx; gap: 12rpx; align-items: center; min-height: 104rpx; padding: 14rpx 18rpx; border: 1rpx solid #e5e8ec; border-radius: 18rpx; background: rgba(255, 255, 255, 0.98); box-shadow: 0 12rpx 40rpx rgba(7, 24, 39, 0.12); }
.selection-bar > text { font-size: 28rpx; }
.gold-number { color: #b68430; font-size: 34rpx; }
.selection-bar button { min-height: 72rpx; margin: 0; border-radius: 12rpx; font-size: 25rpx; line-height: 72rpx; }
.compare-button { background: #071827; color: #fff; }
.export-button { background: #c8a766; color: #fff; }
.sheet-overlay { position: fixed; z-index: 39; inset: 0; background: rgba(7, 24, 39, 0.34); }
.filter-sheet { position: fixed; z-index: 40; right: 0; bottom: 0; left: 0; height: 78vh; overflow: hidden; border-radius: 30rpx 30rpx 0 0; background: #fffdf8; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; height: 96rpx; padding: 0 30rpx; border-bottom: 1rpx solid #e5e8ec; }
.sheet-head > text { font-size: 34rpx; font-weight: 600; }
.sheet-head button { margin: 0; background: transparent; color: #9b6d20; font-size: 24rpx; }
.sheet-body { height: calc(78vh - 200rpx); }
.filter-group { padding: 26rpx 30rpx 8rpx; }
.filter-title { display: block; margin-bottom: 18rpx; color: #071827; font-size: 26rpx; font-weight: 600; }
.choice-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.choice { min-height: 68rpx; margin: 0; padding: 0 14rpx; border: 1rpx solid #e5e8ec; border-radius: 12rpx; background: #fff; color: #516273; font-size: 23rpx; line-height: 68rpx; }
.choice.active { border-color: rgba(200, 167, 102, 0.8); background: rgba(200, 167, 102, 0.12); color: #8c641f; }
.sheet-actions { height: 104rpx; padding: 12rpx 30rpx calc(12rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e5e8ec; background: #fff; }
