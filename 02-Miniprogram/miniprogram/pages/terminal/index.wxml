<view class="page-shell">
  <app-header title="融资情报" />

  <view class="page-content terminal-content">
    <view class="funding-metrics featured-panel">
      <view class="funding-metrics-head">
        <text>融资精选</text>
        <text>{{featuredCards.length ? featuredCards[featuredCurrent].dateShort : ''}} {{featuredCards.length ? (featuredCurrent + 1) + '/' + featuredCards.length : ''}}</text>
      </view>
      <swiper wx:if="{{featuredCards.length}}" class="featured-swiper" current="{{featuredCurrent}}" bindchange="changeFeatured" indicator-dots="{{featuredCards.length > 1}}" indicator-color="#62778a" indicator-active-color="#e2c57f">
        <swiper-item wx:for="{{featuredCards}}" wx:key="id">
          <view class="featured-card" data-id="{{item.id}}" bindtap="openFeatured" role="button" aria-label="查看{{item.company}}融资详情">
            <view class="featured-identity"><text class="featured-company">{{item.company}}</text><text wx:if="{{item.product}}" class="featured-product">{{item.product}}</text><text class="featured-arrow">›</text></view>
            <view class="featured-facts"><text class="featured-amount">{{item.amount}}</text><text class="featured-round">{{item.round}}</text><text class="featured-sector">{{item.sector}}</text></view>
            <view wx:if="{{item.observation}}" class="featured-observation"><text class="featured-label">观察 </text>{{item.observation}}</view>
          </view>
        </swiper-item>
      </swiper>
      <view wx:else class="featured-empty">暂无可展示的融资精选</view>
    </view>

    <view class="search-row category-search">
      <view class="search-box">
        <icon type="search" size="18" color="#071827" />
        <input value="{{filters.keyword}}" placeholder="公司 / 机构 / 产品" bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search" />
        <button wx:if="{{filters.keyword}}" class="clear-button" bindtap="clearSearch"><icon type="clear" size="16" /></button>
      </view>
      <picker class="category-picker" mode="selector" range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="changeCategory">
        <view class="category-select {{categoryIndex > 0 ? 'selected' : ''}}"><text class="category-label">{{categoryOptions[categoryIndex].label}}</text><text class="category-arrow">⌄</text></view>
      </picker>
    </view>

    <view class="scope-status-row">
      <view class="market-scope" role="tablist" aria-label="融资市场范围">
        <button class="market-scope-button {{selectedMarketRegion === 'global' ? 'active' : ''}}" data-region="global" bindtap="changeMarketRegion">
          <text>全球</text><text class="market-scope-count">{{scopeCounts.global}}</text>
        </button>
        <button class="market-scope-button {{selectedMarketRegion === 'china' ? 'active' : ''}}" data-region="china" bindtap="changeMarketRegion">
          <text>中国</text><text class="market-scope-count">{{scopeCounts.china}}</text>
        </button>
      </view>
      <view class="result-summary"><text>今日 {{todayCount}} 条融资动态</text></view>
    </view>

    <view wx:if="{{selectedIds.length}}" class="list-heading compare-heading">
      <view class="list-actions">
        <button wx:if="{{selectedIds.length >= 2}}" bindtap="openCompare">查看比较 {{selectedIds.length}}/3</button>
        <text wx:elif="{{selectedIds.length === 1}}">已选 1/3 · 继续选择</text>
      </view>
    </view>

    <view class="funding-list">
      <funding-row wx:for="{{cards}}" wx:key="id" card="{{item}}" show-watch="{{false}}" bind:open="openCard" />
    </view>
    <view wx:if="{{!filteredCount}}" class="empty-state"><view class="title">暂无符合条件的融资</view><view class="copy">调整关键词或筛选条件后再试。</view></view>
    <view wx:if="{{visibleCount < filteredCount}}" class="load-note">继续上拉加载 · 已显示 {{visibleCount}} 条</view>
  </view>

</view>
