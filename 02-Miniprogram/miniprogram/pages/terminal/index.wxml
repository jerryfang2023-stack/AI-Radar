<view class="page-shell">
  <app-header />

  <view class="page-content terminal-content">
    <view class="terminal-intro">
      <text class="intro-kicker">AI FUNDING · {{meta.latestDate}}</text>
      <view class="intro-title-row">
        <text class="intro-title">融资情报</text>
        <button class="saved-link" bindtap="openWatchlist">收藏 {{watchCount}}</button>
      </view>
      <text class="intro-copy">追踪全球 AI 融资动态，快速了解公司、赛道、轮次与投资机构。{{meta.live ? '数据已在线同步。' : ''}}</text>
    </view>

    <view class="search-row">
      <view class="search-box">
      <icon type="search" size="18" color="#071827" />
      <input value="{{filters.keyword}}" placeholder="搜索公司、赛道或投资方" bindinput="onSearchInput" confirm-type="search" />
      <button wx:if="{{filters.keyword}}" class="clear-button" bindtap="clearSearch"><icon type="clear" size="16" /></button>
      </view>
      <button class="filter-button {{activeFilterCount ? 'active' : ''}}" bindtap="openFilters">筛选<text wx:if="{{activeFilterCount}}"> {{activeFilterCount}}</text></button>
    </view>

    <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="false">
      <view class="category-track">
        <button class="category-chip {{filters.categoryId === 'all' ? 'active' : ''}}" data-value="all" bindtap="quickCategory">全部 {{meta.cardCount}}</button>
        <button wx:for="{{categories}}" wx:key="id" class="category-chip {{filters.categoryId === item.id ? 'active' : ''}}" data-value="{{item.id}}" bindtap="quickCategory">{{item.name}} {{item.count}}</button>
      </view>
    </scroll-view>

    <view class="list-heading">
      <view class="result-summary">
        <text>共 {{filteredCount}} 条结果</text>
        <text wx:if="{{selectedIds.length}}" class="compare-count">已加入比较 {{selectedIds.length}}/3</text>
      </view>
      <view class="list-actions">
        <button bindtap="changeSort">{{sort === 'latest' ? '最新' : sort === 'amount' ? '金额' : '名称'}}</button>
        <button bindtap="openCompare">比较 {{selectedIds.length}}/3</button>
      </view>
    </view>

    <view class="funding-list">
      <funding-row wx:for="{{cards}}" wx:key="id" card="{{item}}" selected="{{item.selected}}" watched="{{item.watched}}" bind:open="openCard" bind:watch="toggleWatch" />
    </view>
    <view wx:if="{{!filteredCount}}" class="empty-state"><view class="title">暂无符合条件的融资</view><view class="copy">调整关键词或筛选条件后再试。</view></view>
    <view wx:if="{{visibleCount < filteredCount}}" class="load-note">继续上拉加载 · 已显示 {{visibleCount}} 条</view>
  </view>

  <view wx:if="{{selectedIds.length}}" class="selection-bar">
    <text>已加入 <text class="gold-number mono">{{selectedIds.length}}</text> 家公司</text>
    <button class="compare-button" bindtap="openCompare">查看比较</button>
  </view>

  <view wx:if="{{filterOpen}}" class="sheet-overlay" bindtap="closeFilters"></view>
  <view wx:if="{{filterOpen}}" class="filter-sheet">
    <view class="sheet-head"><text class="serif">融资筛选</text><button bindtap="resetDraft">重置</button></view>
    <scroll-view class="sheet-body" scroll-y enhanced>
      <view class="filter-group">
        <text class="filter-title">时间范围</text>
        <view class="choice-grid"><button wx:for="{{periods}}" wx:key="id" class="choice {{draftFilters.period === item.id ? 'active' : ''}}" data-name="period" data-value="{{item.id}}" bindtap="chooseDraft">{{item.name}}</button></view>
      </view>
      <view class="filter-group">
        <text class="filter-title">市场范围</text>
        <view class="choice-grid"><button wx:for="{{marketRegions}}" wx:key="id" class="choice {{draftFilters.marketRegion === item.id ? 'active' : ''}}" data-name="marketRegion" data-value="{{item.id}}" bindtap="chooseDraft">{{item.name}}</button></view>
      </view>
      <view class="filter-group">
        <text class="filter-title">总部地区</text>
        <view class="choice-grid"><button wx:for="{{regions}}" wx:key="id" class="choice {{draftFilters.region === item.id ? 'active' : ''}}" data-name="region" data-value="{{item.id}}" bindtap="chooseDraft">{{item.name}}</button></view>
      </view>
      <view class="filter-group">
        <text class="filter-title">融资轮次</text>
        <view class="choice-grid"><button wx:for="{{roundGroups}}" wx:key="id" class="choice {{draftFilters.roundGroup === item.id ? 'active' : ''}}" data-name="roundGroup" data-value="{{item.id}}" bindtap="chooseDraft">{{item.name}}</button></view>
      </view>
      <view class="filter-group">
        <text class="filter-title">市场类别</text>
        <view class="choice-grid"><button class="choice {{draftFilters.categoryId === 'all' ? 'active' : ''}}" data-name="categoryId" data-value="all" bindtap="chooseDraft">全部市场</button><button wx:for="{{categories}}" wx:key="id" class="choice {{draftFilters.categoryId === item.id ? 'active' : ''}}" data-name="categoryId" data-value="{{item.id}}" bindtap="chooseDraft">{{item.name}}</button></view>
      </view>
    </scroll-view>
    <view class="sheet-actions"><button class="primary-button" bindtap="applyDraft">查看结果</button></view>
  </view>
</view>
