@import "../../utils/directory.wxss";
.ecosystem-content { min-height: 100vh; padding: 18rpx 30rpx 170rpx; background: #fbf8f2; }
.ecosystem-mode-tabs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6rpx; margin-bottom: 30rpx; padding: 6rpx; border-radius: 18rpx; background: #ebe7df; }
.ecosystem-mode-tabs button { min-height: 64rpx; margin: 0; padding: 0; border-radius: 14rpx; background: transparent; color: #6c7c8b; font-size: 22rpx; font-weight: 650; line-height: 64rpx; }
.ecosystem-mode-tabs button.active { background: #fffdfa; color: #0a3154; box-shadow: 0 5rpx 15rpx rgba(10, 35, 54, .09); }
.market-segment { display: grid; grid-template-columns: repeat(2, 1fr); width: 210rpx; padding: 4rpx; border-radius: 17rpx; background: #eeeae2; }
.market-segment button { min-height: 54rpx; margin: 0; padding: 0; border-radius: 13rpx; background: transparent; color: #708091; font-size: 22rpx; line-height: 54rpx; }
.market-segment button.active { background: #fff; color: #0d355c; font-weight: 700; box-shadow: 0 5rpx 16rpx rgba(7,24,39,.08); }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 34rpx 0 18rpx; }
.section-head > view:first-child { display: flex; flex-direction: column; gap: 5rpx; color: #9b6d20; font-size: 18rpx; letter-spacing: 1rpx; }
.section-title { color: #071827; font-family: "Songti SC", serif; font-size: 35rpx; font-weight: 700; letter-spacing: 0; }
.signal-head { align-items: center; margin: 0 0 18rpx; }.head-note { color: #7a8794; font-size: 19rpx; }.signal-scroller { width: 100%; white-space: nowrap; }
.signal-card { display: inline-flex; width: 568rpx; min-height: 326rpx; flex-direction: column; align-items: flex-start; margin: 0 18rpx 0 0; padding: 38rpx; border: 1rpx solid #e5e0d6; border-radius: 30rpx; background: #fff; text-align: left; vertical-align: top; white-space: normal; box-shadow: 0 15rpx 38rpx rgba(7,24,39,.07); }
.signal-card.primary { border: 0; background: linear-gradient(145deg,#081c2b,#0d355c); color: #fff; }.signal-card.rise { border-color: rgba(47,140,87,.3); background: #f9fcfa; }.signal-card.cool { border-color: rgba(168,93,93,.22); background: #fffbfa; }
.signal-eyebrow { color: #a57b32; font-size: 18rpx; font-weight: 700; letter-spacing: 1rpx; }.primary .signal-eyebrow { color: #d9b86e; }.signal-sector { margin-top: 32rpx; color: #071827; font-size: 36rpx; font-weight: 700; }.primary .signal-sector { color: #fff; }
.signal-value { display: flex; align-items: baseline; gap: 16rpx; margin-top: 31rpx; }.signal-value text:first-child { color: #071827; font-size: 58rpx; font-weight: 700; line-height: 1; }.primary .signal-value text:first-child { color: #fff; }.rise .signal-value text:first-child { color: #2f8c57; }.cool .signal-value text:first-child { color: #a85d5d; }.signal-value text:last-child, .signal-note { color: #758596; font-size: 20rpx; }.primary .signal-value text:last-child, .primary .signal-note { color: rgba(255,255,255,.62); }.signal-note { margin-top: 24rpx; }
.ranking-card, .heatmap-card { overflow: hidden; border: 1rpx solid #e1dbd1; border-radius: 25rpx; background: #fff; }.ranking-row { display: grid; grid-template-columns: 44rpx minmax(0,1fr) auto; gap: 20rpx; align-items: center; width: 100%; min-height: 100rpx; margin: 0; padding: 21rpx 24rpx; border-bottom: 1rpx solid #ece7dd; border-radius: 0; background: #fff; text-align: left; }.ranking-row:last-child { border-bottom: 0; }.rank { color: #9b6d20; font-size: 17rpx; }.ranking-main { min-width: 0; }.ranking-main > text { color: #071827; font-size: 25rpx; font-weight: 700; }.bar-track { height: 6rpx; margin-top: 13rpx; background: #ece7dd; }.bar-value { height: 100%; background: linear-gradient(90deg,#c8a766,#94691f); }.ranking-count { color: #667789; font-size: 19rpx; }
.heat-legend { display: flex; gap: 5rpx; }.heat-legend i { width: 22rpx; height: 9rpx; background: rgba(200,167,102,.26); }.heat-legend i:nth-child(2) { background: rgba(200,167,102,.58); }.heat-legend i:nth-child(3) { background: #9b6d20; }.heatmap-card { padding: 22rpx; }.heat-row { display: grid; grid-template-columns: 145rpx repeat(6, 1fr); gap: 7rpx; align-items: center; margin-top: 7rpx; }.heat-labels { margin-top: 0; }.heat-labels text { color: #718192; font-size: 16rpx; text-align: center; }.heat-sector { overflow: hidden; color: #071827; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }.heat-cell { height: 47rpx; border-radius: 5rpx; background: #f0ece4; }.heat-cell.l1 { background: rgba(200,167,102,.22); }.heat-cell.l2 { background: rgba(200,167,102,.38); }.heat-cell.l3 { background: rgba(200,167,102,.57); }.heat-cell.l4 { background: rgba(157,125,63,.75); }.heat-cell.l5 { background: #8f6724; }

.featured-report { display: block; width: 100%; margin: 0; padding: 34rpx 32rpx 0; overflow: hidden; border-radius: 29rpx; background: linear-gradient(145deg, #071f34, #0d416b); color: #fff; text-align: left; box-shadow: 0 18rpx 42rpx rgba(7, 31, 52, .14); }
.featured-meta { display: flex; align-items: center; justify-content: space-between; color: #dfbf70; font-size: 20rpx; font-weight: 700; }
.featured-meta .mono { color: rgba(255,255,255,.58); font-weight: 400; }
.featured-title { display: block; margin-top: 21rpx; color: #fff; font-size: 35rpx; font-weight: 800; line-height: 1.42; }
.featured-summary { display: -webkit-box; margin-top: 15rpx; overflow: hidden; color: rgba(255,255,255,.7); font-size: 21rpx; line-height: 1.65; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
.featured-action { display: flex; margin: 26rpx -32rpx 0; padding: 22rpx 32rpx; align-items: center; justify-content: space-between; border-top: 1rpx solid rgba(255,255,255,.14); background: rgba(255,255,255,.05); color: #e5cf97; font-size: 21rpx; font-weight: 650; }
.featured-action .mono { color: rgba(255,255,255,.58); font-size: 18rpx; font-weight: 400; }
.report-tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6rpx; margin-top: 26rpx; padding: 6rpx; border-radius: 17rpx; background: #ebe7df; }
.report-tab { min-height: 62rpx; margin: 0; padding: 0 4rpx; border-radius: 13rpx; background: transparent; color: #6f7f8f; font-size: 20rpx; line-height: 62rpx; }
.report-tab.active { background: #fffdfa; color: #0a3154; font-weight: 700; box-shadow: 0 5rpx 14rpx rgba(7,24,39,.08); }
.archive-heading { margin: 39rpx 2rpx 18rpx; }
.archive-heading text { color: #071827; font-size: 31rpx; font-weight: 800; }
.report-list { overflow: hidden; border-top: 1rpx solid #ded4c4; }
.report-card { display: grid; grid-template-columns: 104rpx minmax(0, 1fr); gap: 22rpx; width: 100%; margin: 0; padding: 25rpx 0; border-bottom: 1rpx solid #ded4c4; background: transparent; text-align: left; }
.report-date { display: flex; flex-direction: column; gap: 8rpx; padding-right: 18rpx; border-right: 1rpx solid #ded4c4; color: #728292; font-size: 18rpx; }
.report-date .mono { color: #0b365b; font-size: 22rpx; font-weight: 700; }
.report-main { min-width: 0; }
.report-title { display: -webkit-box; overflow: hidden; color: #071827; font-size: 26rpx; font-weight: 750; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.report-summary { display: -webkit-box; margin-top: 9rpx; overflow: hidden; color: #718192; font-size: 20rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.report-footer { display: flex; margin-top: 15rpx; justify-content: space-between; color: #8996a3; font-size: 18rpx; }
.report-footer text:last-child { color: #9b6d20; }

