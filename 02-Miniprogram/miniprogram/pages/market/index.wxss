.library-content { padding: 22rpx 30rpx 180rpx; }
.ecosystem-overview { overflow: hidden; border-radius: 28rpx; background: linear-gradient(145deg, #071827, #0d355c); color: #fff; box-shadow: 0 18rpx 46rpx rgba(7,24,39,.12); }
.ecosystem-overview-head { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 28rpx 20rpx; border-bottom: 1rpx solid rgba(255,255,255,.13); }
.ecosystem-overview-head text:first-child { font-family: "Songti SC", serif; font-size: 29rpx; font-weight: 700; }
.ecosystem-overview-head text:last-child { color: rgba(255,255,255,.58); font-size: 18rpx; }
.library-summary { display: grid; grid-template-columns: repeat(3, 1fr); }
.library-summary > view { display: flex; flex-direction: column; gap: 8rpx; align-items: center; padding: 26rpx 10rpx 30rpx; color: rgba(255,255,255,.68); font-size: 20rpx; }
.library-summary > view + view { border-left: 1rpx solid rgba(255,255,255,.12); }
.summary-value { color: #e2c57f; font-size: 44rpx; font-weight: 700; line-height: 1; }
.library-tabs { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 26rpx; border-bottom: 1rpx solid #e5e8ec; }
.library-tabs button { position: relative; min-height: 72rpx; margin: 0; padding: 0 8rpx; border-radius: 0; background: transparent; color: #6f7f8f; font-size: 22rpx; line-height: 72rpx; }
.library-tabs button.active { color: #0d355c; font-weight: 700; }
.library-tabs button.active::after { content: ""; position: absolute; right: 30%; bottom: -1rpx; left: 30%; height: 5rpx; border-radius: 5rpx 5rpx 0 0; background: #c8a766; }
.search-box { display: flex; gap: 16rpx; align-items: center; height: 86rpx; margin-top: 20rpx; padding: 0 22rpx; border: 1rpx solid #dfe3e7; border-radius: 16rpx; background: #fff; }
.search-box input { flex: 1; height: 100%; color: #071827; font-size: 25rpx; }
.clear-button { width: 52rpx; min-height: 52rpx; margin: 0; padding: 0; background: transparent; line-height: 52rpx; }
.result-line { display: flex; justify-content: space-between; padding: 26rpx 2rpx 16rpx; color: #7a8794; font-size: 20rpx; }
.entity-grid { display: grid; gap: 0; overflow: hidden; border: 1rpx solid #e5e8ec; border-radius: 24rpx; background: #fff; }
.entity-card { display: grid; grid-template-columns: 78rpx minmax(0,1fr) auto; gap: 18rpx; align-items: center; width: 100%; margin: 0; padding: 22rpx; border: 0; border-bottom: 1rpx solid #e5e8ec; border-radius: 0; background: #fff; text-align: left; }
.entity-card:last-child { border-bottom: 0; }
.entity-card:active { transform: scale(.99); background: #fffdf8; }
.entity-eyebrow { display: block; overflow: hidden; color: #9b6d20; font-size: 18rpx; font-weight: 600; letter-spacing: 1rpx; text-overflow: ellipsis; white-space: nowrap; }
.entity-avatar { display: flex; flex: none; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; border-radius: 15rpx; background: #edf2f6; color: #0d355c; font-size: 27rpx; font-weight: 700; }
.entity-name { overflow: hidden; color: #071827; font-size: 30rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.entity-copy { display: flex; min-width: 0; flex-direction: column; gap: 7rpx; }
.entity-sub, .entity-meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.entity-sub { color: #536576; font-size: 20rpx; }
.entity-meta { color: #7a8794; font-size: 18rpx; }
.entity-arrow { color: #9aa4ac; font-size: 32rpx; }
.load-note { padding: 28rpx 0; color: #8996a3; font-size: 20rpx; text-align: center; }
