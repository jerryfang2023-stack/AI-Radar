.market-content { padding-top: 6rpx; }
.metric-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rpx; overflow: hidden; border: 1rpx solid #e7e1d5; border-radius: 20rpx; background: #e7e1d5; }
.metric-grid > view { display: flex; flex-direction: column; gap: 8rpx; padding: 28rpx; background: #fff; }
.metric-value { color: #071827; font-size: 48rpx; font-weight: 700; line-height: 1; }
.metric-label { color: #6f7f8f; font-size: 21rpx; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 42rpx 2rpx 18rpx; }
.section-heading .serif { color: #071827; font-size: 30rpx; font-weight: 700; }
.section-heading text:last-child { color: #8996a3; font-size: 20rpx; }
.market-list { overflow: hidden; border: 1rpx solid #e7e1d5; border-radius: 20rpx; background: #fff; }
.market-row { display: grid; grid-template-columns: 220rpx minmax(0, 1fr); gap: 18rpx; align-items: center; width: 100%; min-height: 104rpx; margin: 0; padding: 20rpx 22rpx; border-bottom: 1rpx solid #e7e1d5; border-radius: 0; background: #fff; text-align: left; }
.market-row:last-child { border-bottom: 0; }
.market-copy { display: flex; flex-direction: column; gap: 5rpx; min-width: 0; }
.market-copy text:first-child { overflow: hidden; color: #071827; font-size: 24rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.market-copy text:last-child { color: #6f7f8f; font-size: 19rpx; }
.bar-track { height: 10rpx; overflow: hidden; border-radius: 999rpx; background: #eaf0f5; }
.bar-fill { height: 100%; border-radius: inherit; background: #c8a766; }
.round-list { border-top: 2rpx solid #071827; }
.round-row { display: grid; grid-template-columns: 58rpx minmax(0, 1fr) auto; align-items: center; min-height: 84rpx; padding: 0 4rpx; border-bottom: 1rpx solid #e7e1d5; }
.round-rank { color: #9b6d20; font-size: 20rpx; font-weight: 600; }
.round-name { color: #071827; font-size: 24rpx; font-weight: 600; }
.round-count { color: #6f7f8f; font-size: 21rpx; }
