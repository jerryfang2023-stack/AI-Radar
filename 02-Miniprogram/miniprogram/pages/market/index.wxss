.library-content { padding-top: 6rpx; }
.library-summary { display: grid; grid-template-columns: repeat(2, 1fr); overflow: hidden; border: 1rpx solid #e5e8ec; border-radius: 20rpx; background: #fff; }
.library-summary > view { display: flex; flex-direction: column; gap: 8rpx; padding: 26rpx 28rpx; color: #6f7f8f; font-size: 21rpx; }
.library-summary > view + view { border-left: 1rpx solid #e5e8ec; }
.summary-value { color: #071827; font-size: 44rpx; font-weight: 700; line-height: 1; }
.library-tabs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6rpx; margin-top: 24rpx; padding: 6rpx; border-radius: 16rpx; background: #eeeae2; }
.library-tabs button { min-height: 66rpx; margin: 0; border-radius: 12rpx; background: transparent; color: #6f7f8f; font-size: 23rpx; line-height: 66rpx; }
.library-tabs button.active { background: #fff; color: #071827; font-weight: 700; box-shadow: 0 4rpx 14rpx rgba(7, 24, 39, 0.07); }
.search-box { display: flex; gap: 16rpx; align-items: center; height: 86rpx; margin-top: 20rpx; padding: 0 22rpx; border: 1rpx solid #dfe3e7; border-radius: 16rpx; background: #fff; }
.search-box input { flex: 1; height: 100%; color: #071827; font-size: 25rpx; }
.clear-button { width: 52rpx; min-height: 52rpx; margin: 0; padding: 0; background: transparent; line-height: 52rpx; }
.result-line { display: flex; justify-content: space-between; padding: 26rpx 2rpx 16rpx; color: #7a8794; font-size: 20rpx; }
.entity-list { overflow: hidden; border: 1rpx solid #e5e8ec; border-radius: 20rpx; background: #fff; }
.entity-row { display: grid; grid-template-columns: 72rpx minmax(0, 1fr) 176rpx; gap: 16rpx; align-items: center; width: 100%; min-height: 142rpx; margin: 0; padding: 22rpx; border-bottom: 1rpx solid #edf0f2; border-radius: 0; background: #fff; text-align: left; }
.entity-row:last-child { border-bottom: 0; }
.entity-avatar { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 16rpx; background: #edf2f6; color: #0d355c; font-size: 28rpx; font-weight: 700; }
.entity-copy, .entity-metrics { display: flex; flex-direction: column; min-width: 0; }
.entity-copy { gap: 7rpx; }
.entity-name { overflow: hidden; color: #071827; font-size: 26rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.entity-secondary { overflow: hidden; color: #536576; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.entity-category { overflow: hidden; color: #9b6d20; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.entity-metrics { gap: 7rpx; align-items: flex-end; color: #7a8794; font-size: 18rpx; text-align: right; }
.metric-primary { max-width: 176rpx; overflow: hidden; color: #071827; font-size: 23rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.load-note { padding: 28rpx 0; color: #8996a3; font-size: 20rpx; text-align: center; }
