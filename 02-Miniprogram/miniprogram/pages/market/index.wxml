<import src="../../templates/directory.wxml"/>
<view class="page-shell">
  <app-header title="生态" />
  <view class="page-content ecosystem-content">
    <view class="ecosystem-mode-tabs">
      <button class="{{mode === 'map' ? 'active' : ''}}" data-mode="map" bindtap="setMode">生态图谱</button>
      <button class="{{mode === 'directory' ? 'active' : ''}}" data-mode="directory" bindtap="setMode">生态名录</button>
    </view>

    <block wx:if="{{mode === 'map'}}">
      <view class="cm-head"><view><text class="cm-title">资本热力图谱</text><text class="cm-sub">7 大赛道 · 45 子赛道</text></view><view class="market-segment"><button class="{{marketRegion === 'global' ? 'active' : ''}}" data-region="global" bindtap="changeMarket">全球</button><button class="{{marketRegion === 'china' ? 'active' : ''}}" data-region="china" bindtap="changeMarket">中国</button></view></view>
      <view wx:if="{{!capital}}" class="cm-loading">正在加载图谱</view>
      <view wx:elif="{{!capital.ready}}" class="cm-empty">图谱数据暂时不可用<button bindtap="retryMap">重新加载</button></view>
      <block wx:else>
        <view class="cm-overview"><view class="cm-between"><text>资本分布 · 近 {{mapRange}} 个月</text><text>截至 {{capital.date}}</text></view><view class="cm-numbers"><text class="cm-big">{{capital.count}}</text><text>笔融资</text><view class="cm-active"><text>{{capital.active}} / 7</text><text>活跃大赛道</text></view></view><view class="cm-distribution"><view wx:for="{{capital.distribution}}" wx:key="id" class="cm-dist-{{index}}" style="width:{{item.width}}%;"></view></view><view class="cm-insight" wx:if="{{capital.count}}">{{capital.leader.name}} 占已收录融资的 {{capital.leader.share}}%</view><view wx:else class="cm-insight">该范围暂无已收录融资</view></view>
        <view class="cm-head"><text class="cm-heading">全赛道看板</text><button class="cm-link" bindtap="toggleMapAll">{{mapExpanded.length === 7 ? '收起子赛道' : '展开全部子赛道'}}</button></view>
        <view class="cm-head"><view class="cm-tabs"><button class="{{mapMode === 'heat' ? 'active' : ''}}" data-mode="heat" bindtap="changeMapMode">月度热力</button><button class="{{mapMode === 'trend' ? 'active' : ''}}" data-mode="trend" bindtap="changeMapMode">赛道趋势</button></view><view class="cm-seg"><button class="{{mapRange === 3 ? 'active' : ''}}" data-range="3" bindtap="changeMapRange">3 个月</button><button class="{{mapRange === 6 ? 'active' : ''}}" data-range="6" bindtap="changeMapRange">6 个月</button></view></view>
        <block wx:if="{{mapMode === 'heat'}}">
          <view class="cm-head cm-legend"><view><text>低</text><text class="cm-l0"></text><text class="cm-l1"></text><text class="cm-l2"></text><text class="cm-l3"></text><text class="cm-l4"></text><text>高</text></view><button class="cm-link" bindtap="toggleMapUnit">{{mapUnit === 'count' ? '融资笔数' : '当月占比'}} ⇄</button></view>
          <view class="cm-matrix {{mapRange === 3 ? 'cm-three' : ''}}"><view class="cm-row cm-labels"><text>赛道 / 月份</text><text wx:for="{{capital.months}}" wx:key="key">{{item.label}}</text><text>合计</text></view><view wx:for="{{mapRows}}" wx:key="id" wx:for-item="row" class="cm-row {{row.child ? 'cm-child' : ''}}"><button wx:if="{{!row.child}}" class="cm-row-name" data-id="{{row.id}}" bindtap="toggleMapRow">{{row.expanded ? '−' : '+'}} {{row.name}}</button><button wx:else class="cm-row-name" data-id="{{row.id}}" bindtap="openMapDetail">{{row.name}}</button><button wx:for="{{row.cells}}" wx:key="key" class="cm-cell cm-l{{item.level}}" data-id="{{row.id}}" data-month="{{item.key}}" bindtap="openMapDetail" aria-label="{{row.name}} {{item.key}} {{item.count}}笔">{{item.label}}</button><text class="cm-total">{{row.count}}</text></view></view>
        </block>
        <view wx:else class="cm-trend-list"><view class="cm-sub">{{capital.comparison}}</view><view wx:for="{{mapRows}}" wx:key="id" wx:for-item="row" class="cm-trend-row {{row.child ? 'cm-child' : ''}}"><button wx:if="{{!row.child}}" data-id="{{row.id}}" bindtap="toggleMapRow">{{row.expanded ? '−' : '+'}} {{row.name}}<text>{{row.count}} 笔</text></button><button wx:else data-id="{{row.id}}" bindtap="openMapDetail">{{row.name}}<text>{{row.count}} 笔</text></button><canvas canvas-id="map-{{row.id}}" class="cm-spark"/><button class="cm-delta" data-id="{{row.id}}" bindtap="openMapDetail">{{row.deltaText}} 笔</button></view></view>
        <view class="cm-head"><text class="cm-heading">趋势聚焦</text><text class="cm-sub">月度融资笔数</text></view>
        <view class="cm-trend-card"><picker range="{{mapOptions}}" value="{{mapOptionIndex}}" bindchange="changeMapFocus"><view class="cm-picker">{{capital.focus.name}}<text>⌄</text></view></picker><view class="cm-metrics"><view><text>{{capital.focus.count}}</text><text>近 {{mapRange}} 个月 / 笔</text></view><view><text>{{capital.focus.deltaText}}</text><text>完整月变化 / 笔</text></view><view><text>{{capital.focus.share}}%</text><text>市场融资占比</text></view></view><canvas canvas-id="map-focus" class="cm-focus"/><view class="cm-between"><text class="cm-sub">{{capital.comparison}}</text><button class="cm-link" data-id="{{mapSelected}}" bindtap="openMapDetail">查看融资 ›</button></view></view>
        <view class="cm-head"><text class="cm-heading">近期活跃赛道</text><text class="cm-sub">{{capital.current}}</text></view><button wx:for="{{capital.ranking}}" wx:key="id" class="cm-rank" data-id="{{item.id}}" bindtap="openMapDetail"><text class="cm-rank-num">0{{index + 1}}</text><view>{{item.name}}<text>较 {{capital.previous}} {{item.deltaText}} 笔</text></view><text>{{item.now}} 笔 ›</text></button><view wx:if="{{!capital.ranking.length}}" class="cm-empty">该月份暂无已收录融资</view>
        <button class="cm-methods" bindtap="toggleMethods">统计口径与数据覆盖 {{methodsOpen ? '−' : '+'}}</button><view wx:if="{{methodsOpen}}" class="cm-sub cm-method-body">以 {{capital.date}} 为数据截至日，采用 7 大赛道、45 子赛道分类。每笔融资只计入一个大赛道和子赛道；全球不含中国。当月占比以所选市场当月已分类融资总笔数为分母。{{capital.partial ? '当前月数据尚未完整。' : ''}}变化比较采用 {{capital.comparison}}，空值代表暂无收录，统计不代表全市场规模。金额保留原币种，不混加。<text wx:if="{{capital.unclassified}}">另有 {{capital.unclassified}} 笔分类待核验，未计入图谱。</text></view>
        <button wx:if="{{refreshFailed}}" class="cm-methods" bindtap="retryMap">暂未完成更新，点击重试</button>
      </block>
    </block>

    <block wx:else>
      <view class="directory-hero"><button wx:for="{{directoryTypes}}" wx:key="id" data-type="{{item.id}}" bindtap="openDirectory"><image src="/assets/directory/{{item.icon}}.svg"/><text>{{item.name}}</text></button></view>
      <view class="directory-search-row"><view class="directory-market"><button class="{{directoryMarket === 'china' ? 'active' : ''}}" data-market="china" bindtap="changeDirectoryMarket">中国</button><button class="{{directoryMarket === 'global' ? 'active' : ''}}" data-market="global" bindtap="changeDirectoryMarket">全球</button></view><button class="directory-search" bindtap="openDirectory"><text>⌕</text><text>搜索公司、产品、机构、人物</text></button></view>
      <template is="directory-tabs" data="{{directoryTabs,directoryType}}"/>
      <template is="directory-rows" data="{{directoryItems,updates:true}}"/>
      <view wx:if="{{!directoryItems.length}}" class="directory-empty">暂无相关动态</view>
      <button wx:if="{{directoryMore}}" class="directory-more" bindtap="moreDirectory">加载更多</button>
    </block>
  </view>
</view>

<view wx:if="{{mapSheet}}" class="cm-overlay" bindtap="closeMapDetail"><view class="cm-sheet" catchtap="stopMapTap"><view class="cm-head"><text class="cm-heading">{{mapSheet.name}}</text><button class="cm-link" bindtap="closeMapDetail">关闭</button></view><text class="cm-sub">{{marketRegion === 'china' ? '中国' : '全球'}} · {{mapSheet.month || '近 ' + mapRange + ' 个月'}} · {{mapSheet.cards.length}} 笔融资</text><scroll-view scroll-y class="cm-sheet-scroll"><button wx:for="{{mapSheet.cards}}" wx:key="id" class="cm-funding" data-id="{{item.id}}" bindtap="openMapFunding"><view><text>{{item.company}}</text><text>{{item.date}} · {{item.round}}</text></view><text>{{item.amount || '未披露'}} ›</text></button><view wx:if="{{!mapSheet.cards.length}}" class="cm-empty">该范围暂无已收录融资</view></scroll-view></view></view>
