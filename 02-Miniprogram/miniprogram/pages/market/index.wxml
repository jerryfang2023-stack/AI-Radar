<view class="page-shell">
  <app-header title="生态" />
  <view class="page-content ecosystem-content">
    <view class="ecosystem-topline">
      <view><text>数据更新至</text><text class="date mono">{{latestDate}}</text></view>
      <view class="market-segment"><button class="{{marketRegion === 'global' ? 'active' : ''}}" data-region="global" bindtap="changeMarket">全球</button><button class="{{marketRegion === 'china' ? 'active' : ''}}" data-region="china" bindtap="changeMarket">中国</button></view>
    </view>
    <view class="section-head signal-head"><view><text>本期信号</text><text class="section-title">资本正在流向哪里</text></view></view>
    <scroll-view class="signal-scroller" scroll-x enable-flex show-scrollbar="{{false}}">
      <button wx:for="{{signals}}" wx:key="kind" class="signal-card {{item.kind}}" data-sector="{{item.sector}}" bindtap="openSector"><text class="signal-eyebrow">{{item.eyebrow}}</text><text class="signal-sector">{{item.sector}}</text><view class="signal-value"><text class="mono">{{item.value}}</text><text>{{item.kind === 'primary' ? '笔融资' : '个百分点'}}</text></view><text class="signal-note">{{item.note}}</text></button>
    </scroll-view>
    <view class="section-head"><view><text>市场子类 · 融资事件</text><text class="section-title">赛道热度榜</text></view><text class="head-note mono">Top 5</text></view>
    <view class="ranking-card"><button wx:for="{{ranking}}" wx:key="sector" class="ranking-row" data-sector="{{item.sector}}" bindtap="openSector"><text class="rank mono">{{item.rank}}</text><view class="ranking-main"><text>{{item.sector}}</text><view class="bar-track"><view class="bar-value" style="width: {{item.width}}%;"></view></view></view><text class="ranking-count mono">{{item.count}} 笔</text></button></view>
    <view class="section-head heat-head"><view><text>Top 5 × 近 6 个月</text><text class="section-title">热力趋势</text></view><view class="heat-legend"><i></i><i></i><i></i></view></view>
    <view class="heatmap-card"><view class="heat-row heat-labels"><text></text><text wx:for="{{months}}" wx:key="*this" class="mono">{{item}}</text></view><view wx:for="{{heatmap}}" wx:key="sector" class="heat-row" data-sector="{{item.sector}}" bindtap="openSector"><text class="heat-sector">{{item.sector}}</text><view wx:for="{{item.cells}}" wx:key="key" class="heat-cell l{{item.level}}"></view></view></view>
  </view>
</view>
