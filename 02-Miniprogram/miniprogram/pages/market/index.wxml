<view class="page-shell">
  <app-header title="市场概览" />
  <view class="page-content market-content">
    <view class="metric-grid">
      <view><text class="metric-value serif">{{meta.cardCount}}</text><text class="metric-label">融资事件</text></view>
      <view><text class="metric-value serif">{{meta.disclosedAmountCount}}</text><text class="metric-label">金额披露</text></view>
      <view><text class="metric-value serif">{{categoryCount}}</text><text class="metric-label">主要赛道</text></view>
      <view><text class="metric-value serif">{{roundCount}}</text><text class="metric-label">活跃轮次</text></view>
    </view>
    <view class="section-heading"><text class="serif">市场类别分布</text><text>点击查看融资</text></view>
    <view class="market-list"><button wx:for="{{categories}}" wx:key="id" class="market-row" data-id="{{item.id}}" bindtap="openCategory"><view class="market-copy"><text>{{item.name}}</text><text>{{item.count}} 笔融资</text></view><view class="bar-track"><view class="bar-fill" style="width: {{item.bar}}%;"></view></view></button></view>
    <view class="section-heading"><text class="serif">主要轮次分布</text><text>近期融资</text></view>
    <view class="round-list"><view wx:for="{{rounds}}" wx:key="name" class="round-row"><text class="round-rank mono">{{item.rank}}</text><text class="round-name">{{item.name}}</text><text class="round-count">{{item.count}} 笔</text></view></view>
  </view>
</view>
