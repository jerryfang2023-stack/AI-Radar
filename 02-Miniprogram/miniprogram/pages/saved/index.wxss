.watch-intro { display: flex; flex-direction: column; gap: 8rpx; padding: 30rpx 30rpx 18rpx; border-bottom: 1rpx solid #e5e8ec; }
.watch-intro .serif { color: #071827; font-size: 34rpx; font-weight: 600; }
.watch-intro > text:last-child { color: #6f7f8f; font-size: 22rpx; }
.watch-list { padding: 0 18rpx 160rpx; }
.empty-action { width: 320rpx; margin: 34rpx auto 0; }
