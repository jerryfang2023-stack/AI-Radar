<view class="page-shell">
  <app-header title="社群申请" show-back />
  <view class="page-content application-content">
    <view wx:if="{{community.status !== 'none'}}" class="result-card {{community.status}}">
      <text class="result-kicker">观澜社群</text>
      <text class="result-title serif">{{community.status === 'joined' ? '已加入社群' : community.statusLabel}}</text>
      <text wx:if="{{community.status === 'joined'}}" class="result-points mono">{{community.points}} 社群积分</text>
      <button wx:if="{{community.status === 'rejected'}}" class="secondary-button" bindtap="editAgain">重新申请</button>
    </view>

    <block wx:else>
      <view class="application-hero"><text>观澜社群</text><text class="serif">申请加入社群</text><view class="application-progress"><i></i><text>申请资料 1 / 3</text></view></view>
      <view class="form-section">
        <text class="section-index">01 · 基本信息</text><text class="section-title serif">认识你</text>
        <label>姓名 / 常用称呼 *</label><input value="{{form.name}}" data-field="name" bindinput="updateField" maxlength="80" />
        <label>手机号 *</label><input type="number" value="{{form.phone}}" data-field="phone" bindinput="updateField" maxlength="11" />
        <label>微信号 *</label><input value="{{form.wechat}}" data-field="wechat" bindinput="updateField" maxlength="100" />
        <label>所在城市 *</label><input value="{{form.city}}" data-field="city" bindinput="updateField" maxlength="100" />
        <label>当前身份 *</label><input value="{{form.role}}" data-field="role" bindinput="updateField" maxlength="40" />
      </view>
      <view class="form-section">
        <text class="section-index">02 · AI 实践</text><text class="section-title serif">正在做什么</text>
        <label>行业领域 *</label><input value="{{form.industry}}" data-field="industry" bindinput="updateField" maxlength="300" />
        <label>能力与经验 *</label><textarea value="{{form.skills}}" data-field="skills" bindinput="updateField" maxlength="2000"></textarea>
        <label>当前项目 *</label><textarea value="{{form.project}}" data-field="project" bindinput="updateField" maxlength="2000"></textarea>
        <label>AI 方向 *</label><input value="{{form.direction}}" data-field="direction" bindinput="updateField" maxlength="500" />
      </view>
      <view class="form-section">
        <text class="section-index">03 · 社群连接</text><text class="section-title serif">期待同行</text>
        <label>希望获得什么连接 *</label><textarea value="{{form.needs}}" data-field="needs" bindinput="updateField" maxlength="2000"></textarea>
        <label>你对行业的一个判断 *</label><textarea value="{{form.perspective}}" data-field="perspective" bindinput="updateField" maxlength="2000"></textarea>
      </view>
      <button class="primary-button submit-button" loading="{{submitting}}" bindtap="submit">提交申请</button>
    </block>
  </view>
</view>
