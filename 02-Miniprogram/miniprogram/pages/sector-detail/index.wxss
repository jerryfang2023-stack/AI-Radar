.sector-content { padding: 24rpx 30rpx 80rpx; }.sector-hero { padding: 35rpx 32rpx 0; border-radius: 29rpx; background: linear-gradient(145deg,#071827,#0d355c); color: #fff; }.sector-top { display: flex; align-items: center; justify-content: space-between; color: #d2ae5e; font-size: 18rpx; }.follow-button { min-height: 56rpx; margin: 0; padding: 0 22rpx; border: 1rpx solid rgba(255,255,255,.45); border-radius: 999rpx; background: transparent; color: #fff; font-size: 20rpx; line-height: 56rpx; }.follow-button.active { border-color: #d2ae5e; color: #d2ae5e; }.sector-title { display: block; margin-top: 27rpx; font-size: 48rpx; font-weight: 700; }.sector-deck { display: block; margin-top: 19rpx; color: rgba(255,255,255,.7); font-size: 22rpx; line-height: 1.7; }.sector-kpis { display: grid; grid-template-columns: repeat(3,1fr); margin: 31rpx -32rpx 0; border-top: 1rpx solid rgba(255,255,255,.12); }.sector-kpis view { display: flex; flex-direction: column; gap: 8rpx; align-items: center; padding: 24rpx 8rpx 27rpx; color: rgba(255,255,255,.6); font-size: 18rpx; }.sector-kpis view + view { border-left: 1rpx solid rgba(255,255,255,.12); }.sector-kpis text:first-child { color: #e0c176; font-size: 35rpx; font-weight: 700; }.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 36rpx 2rpx 17rpx; }.section-heading > view { display: flex; flex-direction: column; gap: 4rpx; color: #9b6d20; font-size: 17rpx; }.section-heading .serif { color: #071827; font-size: 34rpx; font-weight: 700; }.section-heading > text { color: #7a8794; font-size: 18rpx; }.company-list { overflow: hidden; border: 1rpx solid #e4ded4; border-radius: 25rpx; background: #fff; }.company-row { display: grid; grid-template-columns: 65rpx minmax(0,1fr) auto; gap: 17rpx; align-items: center; width: 100%; min-height: 116rpx; margin: 0; padding: 21rpx 22rpx; border-bottom: 1rpx solid #ece7dd; border-radius: 0; background: #fff; text-align: left; }.company-row:last-child { border-bottom: 0; }.company-avatar { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 14rpx; background: #edf2f6; color: #0d355c; font-size: 25rpx; font-weight: 700; }.company-copy,.company-amount { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; }.company-copy text:first-child { overflow: hidden; color: #071827; font-size: 25rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.company-copy text:last-child,.company-amount text:last-child { color: #7a8794; font-size: 17rpx; }.company-amount { align-items: flex-end; }.company-amount text:first-child { max-width: 180rpx; overflow: hidden; color: #071827; font-size: 20rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.investor-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }.investor-tags text { padding: 14rpx 20rpx; border-radius: 999rpx; background: #efebe3; color: #0d355c; font-size: 19rpx; }.investor-tags b { margin-left: 5rpx; color: #9b6d20; }
