.launch-page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 100vh;
  padding-right: 72rpx;
  padding-bottom: 80rpx;
  padding-left: 72rpx;
  background: radial-gradient(circle at 50% 48%, rgba(200, 167, 102, .13), transparent 34%), linear-gradient(180deg, #fffdf8 0%, #fbf5e8 100%);
  color: #071827;
}

.brand-stage {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 48rpx;
  animation: brand-enter 700ms ease-out both;
}

.brand-lockup { width: 470rpx; margin-bottom: 46rpx; }

.brand-slogan {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
}

.brand-description {
  margin-top: 22rpx;
  color: #6f7f8f;
  font-size: 23rpx;
  letter-spacing: 4rpx;
}


@keyframes brand-enter {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}
