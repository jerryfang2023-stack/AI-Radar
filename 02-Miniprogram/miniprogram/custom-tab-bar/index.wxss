.tab-bar {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 0 0 env(safe-area-inset-bottom);
  border-top: 1rpx solid #d2d9df;
  background: rgba(255, 253, 248, 0.98);
  box-shadow: none;
}

.tab-list {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
}

.tab-button {
  position: relative;
  display: flex;
  min-width: 0;
  min-height: 112rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #667789;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.tab-button.with-divider::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  width: 1rpx;
  height: 44rpx;
  background: #d5d0c6;
  transform: translateY(-50%);
}

.tab-button.active {
  border-radius: 14rpx 14rpx 0 0;
  background: #f4efe4;
  color: #0d355c;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: none;
}

.tab-button.active::after {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  width: 64rpx;
  height: 6rpx;
  border-radius: 0 0 6rpx 6rpx;
  background: #c8a766;
  transform: translateX(-50%);
}

.tab-button-pressed { opacity: 0.84; transform: scale(0.97); }
