
.directory-hero{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12rpx;padding:28rpx 24rpx;margin-bottom:32rpx;border-radius:30rpx;background:linear-gradient(135deg,#071f34,#0d416b);box-shadow:0 18rpx 42rpx rgba(7,31,52,.15)}.directory-hero button{display:flex;min-width:0;margin:0;padding:26rpx 0;flex-direction:column;align-items:center;gap:18rpx;border:1rpx solid rgba(229,207,151,.3);border-radius:18rpx;background:rgba(255,255,255,.05);color:#fffdf9;font-size:24rpx;font-weight:650;line-height:1.5}.directory-hero image{width:46rpx;height:46rpx}.directory-search-row{display:flex;gap:18rpx;align-items:center;margin-bottom:18rpx}.directory-market{display:grid;grid-template-columns:repeat(2,1fr);flex:0 0 235rpx;padding:6rpx;gap:4rpx;border-radius:18rpx;background:#ebe7df}.directory-market button{margin:0;padding:0;min-height:66rpx;line-height:66rpx;border-radius:14rpx;background:transparent;color:#708091;font-size:24rpx}.directory-market button.active{background:#fffdfa;color:#0d355c;font-weight:700;box-shadow:0 4rpx 12rpx rgba(7,24,39,.08)}.directory-search{display:flex;align-items:center;gap:14rpx;flex:1;min-width:0;min-height:80rpx;margin:0;padding:0 20rpx;border:1rpx solid #dbcdae;border-radius:18rpx;background:#fffdfa;color:#7a8791;text-align:left;font-size:23rpx}.directory-search text:last-child{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.directory-tabs{display:flex;justify-content:space-between;gap:12rpx;border-bottom:1rpx solid #ded4c4}.directory-tabs button{margin:0;padding:24rpx 0 20rpx;border-radius:0;background:transparent;color:#7c8590;font-size:23rpx;line-height:1.5;border-bottom:4rpx solid transparent}.directory-tabs button.active{border-bottom-color:#c8a766;color:#0d355c;font-weight:700}.directory-row{display:flex;gap:20rpx;width:100%;margin:0;padding:36rpx 0;border-radius:0;border-bottom:1rpx solid #ded4c4;background:transparent;text-align:left;line-height:1.6}.directory-avatar{width:70rpx;height:70rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:17rpx;background:#0d355c;color:#fff;font-size:29rpx}.directory-avatar.products{background:#eaeede;color:#566747}.directory-avatar.investors{background:#eee5d5;color:#937036}.directory-avatar.people{background:#e9e7f0;color:#686078}.directory-row-body{flex:1;min-width:0}.directory-row-head{display:flex;justify-content:space-between;gap:12rpx;align-items:baseline}.directory-row-head text:first-child{font-size:27rpx;color:#071827;font-weight:650;overflow-wrap:anywhere}.directory-row-head text:last-child{font-size:19rpx;color:#879098;white-space:nowrap}.directory-summary{display:block;margin:10rpx 0 12rpx;font-size:23rpx;line-height:1.7;color:#576775}.directory-meta{display:flex;justify-content:space-between;gap:18rpx;font-size:19rpx;color:#8b959c}.directory-meta text:first-child{color:#957944}.directory-meta text:last-child{white-space:nowrap}.directory-empty{text-align:center;padding:70rpx 15rpx;color:#7b8790;font-size:25rpx}.directory-more{background:transparent;color:#94783e;font-size:23rpx;margin:20rpx auto}.directory-form{display:flex;align-items:center;gap:14rpx;background:#fffdfa;border:1rpx solid #dbcdae;border-radius:18rpx;padding:10rpx 12rpx 10rpx 22rpx}.directory-form input{flex:1;min-width:0;font-size:25rpx;height:64rpx}.directory-form button{margin:0;background:#0d355c;color:white;font-size:23rpx;padding:0 20rpx;height:64rpx;line-height:64rpx}.directory-filters{display:flex;justify-content:space-between;gap:20rpx;margin:24rpx 0}.directory-filters picker{flex:0 1 290rpx;min-width:0;border:1rpx solid #dfd8cc;border-radius:17rpx;background:#fffdfa}.directory-filters picker view{padding:22rpx 18rpx;color:#0d355c;font-size:24rpx;display:flex;justify-content:space-between;gap:14rpx}.directory-group-head{display:flex;align-items:center;justify-content:space-between;margin:30rpx 0 0;font-size:30rpx;color:#071827}.directory-group-head button{background:transparent;color:#94783e;font-size:23rpx;margin:0;padding:0}.directory-count{font-size:22rpx;color:#879098;margin:22rpx 0 0}
