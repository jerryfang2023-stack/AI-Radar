<view wx:if="{{showBack}}" class="header" style="padding-top: {{statusBarHeight}}px;">
  <view class="header-row is-detail">
    <button wx:if="{{showBack}}" class="back-button" bindtap="back">返回</button>
    <text class="header-title {{showBack ? 'is-centered' : ''}}">{{title}}</text>
    <button wx:if="{{rightLabel}}" class="right-button" style="right: {{rightInset}}px;" bindtap="rightTap">{{rightLabel}}</button>
  </view>
</view>
<view wx:elif="{{title}}" class="tab-header" style="padding-top: {{menuTop}}px;">
  <view class="tab-header-row" style="height: {{menuHeight}}px;">
    <image class="tab-header-logo" src="/assets/brand/logo-wavesight-reference-horizontal.svg" mode="widthFix" aria-label="观澜 AI" />
    <text class="tab-header-title">{{title}}</text>
  </view>
</view>
<view wx:else class="tab-safe-top" style="height: {{tabSafeHeight}}px;"></view>
