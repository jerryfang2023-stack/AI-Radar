.registration-overlay { position: fixed; z-index: 180; inset: 0; display: flex; align-items: flex-end; background: rgba(7,24,39,.46); }
.registration-sheet { width: 100%; max-height: 90vh; box-sizing: border-box; padding: 34rpx 34rpx calc(28rpx + env(safe-area-inset-bottom)); overflow-y: auto; border-top: 6rpx solid #c8a766; border-radius: 34rpx 34rpx 0 0; background: linear-gradient(180deg, #fff6e4 0, #fffdf8 240rpx, #fffdf8 100%); box-shadow: 0 -18rpx 60rpx rgba(7,24,39,.15); }
.registration-kicker { display: inline-flex; margin-bottom: 12rpx; padding: 6rpx 13rpx; border-radius: 999rpx; background: rgba(200,167,102,.16); color: #8c641f; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }
.registration-title { color: #071827; font-size: 42rpx; font-weight: 700; line-height: 1.25; }
.registration-copy { margin-top: 12rpx; color: #6f7f8f; font-size: 24rpx; line-height: 1.65; }
.registration-benefits { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 28rpx 0 24rpx; overflow: hidden; border: 1rpx solid #ded7ca; border-radius: 20rpx; background: rgba(255,255,255,.9); box-shadow: 0 8rpx 24rpx rgba(7,24,39,.04); }
.registration-benefits view { display: flex; min-height: 110rpx; flex-direction: column; gap: 8rpx; justify-content: center; padding: 14rpx 16rpx; border-left: 1rpx solid #ece6dc; }
.registration-benefits view:first-child { border-left: 0; }
.registration-benefits view:nth-child(1) { background: rgba(13,53,92,.055); }
.registration-benefits view:nth-child(2) { background: rgba(200,167,102,.075); }
.registration-benefits view:nth-child(3) { background: rgba(13,53,92,.035); }
.registration-benefits text:first-child { color: #c8a766; font-family: "Songti SC", "STSong", serif; font-size: 20rpx; }
.registration-benefits text:last-child { color: #223445; font-size: 21rpx; line-height: 1.35; }
.registration-existing { width: 100%; min-height: 76rpx; margin: 0 0 18rpx; border: 1rpx solid rgba(200, 167, 102, 0.65); border-radius: 14rpx; background: #fffaf0; color: #7d5a1c; font-size: 23rpx; line-height: 76rpx; }
.registration-form { overflow: hidden; border: 1rpx solid #ded7ca; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(7,24,39,.04); }
.profile-input-row { display: flex; min-height: 104rpx; align-items: center; justify-content: space-between; padding: 0 22rpx; border-top: 1rpx solid #ece6dc; }
.profile-input-row:first-child { border-top: 0; }
.profile-input-row:first-child { background: rgba(13,53,92,.035); }
.profile-input-row.nickname-row { background: rgba(200,167,102,.045); }
.profile-input-row > view:first-child { display: flex; flex-direction: column; gap: 5rpx; }
.field-title { color: #071827; font-size: 25rpx; font-weight: 600; }
.field-note { color: #788897; font-size: 20rpx; }
.registration-avatar { position: relative; width: 72rpx; height: 72rpx; margin: 0; padding: 0; overflow: hidden; border: 1rpx solid #ded7ca; border-radius: 18rpx; background: #f7f4ef; line-height: normal; }
.registration-avatar image { width: 100%; height: 100%; opacity: .58; }
.registration-avatar.selected image { opacity: 1; }
.registration-avatar text { position: absolute; right: 0; bottom: 0; left: 0; padding: 3rpx 0; background: rgba(7,24,39,.7); color: #fff; font-size: 16rpx; text-align: center; }
.nickname-row input { width: 250rpx; height: 62rpx; box-sizing: border-box; padding: 0 16rpx; border: 1rpx solid #e5ded1; border-radius: 13rpx; background: rgba(255,255,255,.88); color: #071827; font-size: 24rpx; text-align: right; }
.registration-primary { min-height: 84rpx; margin: 24rpx 0 0; border-radius: 16rpx; background: #0d355c; color: #fff; font-size: 27rpx; font-weight: 700; line-height: 84rpx; }
.registration-primary[disabled] { background: #dce5ec; color: #82909c; }
.registration-secondary { min-height: 64rpx; margin: 10rpx 0 0; background: transparent; color: #0d355c; font-size: 23rpx; line-height: 64rpx; }
.registration-price { padding: 4rpx 16rpx 0; color: #8b96a1; font-size: 19rpx; line-height: 1.5; text-align: center; }
.success-mark { display: block; width: 112rpx; height: 112rpx; margin: 12rpx auto 28rpx; border: 1rpx solid #e5ded1; border-radius: 26rpx; background: #fff; }
.success-button { margin-top: 34rpx; }
