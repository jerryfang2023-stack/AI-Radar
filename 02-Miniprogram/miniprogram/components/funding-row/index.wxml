<view class="funding-row {{selected ? 'selected' : ''}} {{dense ? 'dense' : ''}}">
  <view class="avatar" bindtap="open"><text>{{card.initial}}</text></view>
  <view class="row-main" bindtap="open">
    <view class="company-line">
      <text class="company">{{card.company}}</text>
    </view>
    <view class="facts-line">
      <text>{{card.round}}</text><text class="divider">·</text><text>{{card.date}}</text>
    </view>
  </view>
  <view class="row-side {{showWatch ? '' : 'no-watch'}}">
    <text class="amount mono" bindtap="open">{{card.amount}}</text>
    <view wx:if="{{showWatch}}" class="side-actions">
      <text wx:if="{{selected}}" class="compare-state">比较中</text>
      <button class="watch-button {{watched ? 'watched' : ''}}" catchtap="watch">{{watched ? '已收藏' : '收藏'}}</button>
    </view>
  </view>
</view>
