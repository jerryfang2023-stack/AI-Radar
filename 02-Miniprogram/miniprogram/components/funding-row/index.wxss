.funding-row { display: grid; grid-template-columns: auto 74rpx minmax(0, 1fr) 164rpx; gap: 16rpx; align-items: center; min-height: 166rpx; padding: 22rpx 14rpx; border-bottom: 1rpx solid #e5e8ec; background: transparent; }
.funding-row.selected { margin: 6rpx 0; border: 1rpx solid rgba(200, 167, 102, 0.56); border-radius: 18rpx; background: rgba(200, 167, 102, 0.08); }
.funding-row.dense { min-height: 132rpx; padding-top: 14rpx; padding-bottom: 14rpx; }
.select-control { display: flex; align-items: center; justify-content: center; width: 50rpx; }
.avatar { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 50%; background: #071827; color: #fff; font-size: 26rpx; font-weight: 600; }
.row-main { min-width: 0; }
.company-line { display: flex; gap: 10rpx; align-items: center; min-width: 0; }
.company { max-width: 220rpx; overflow: hidden; color: #071827; font-size: 29rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.category { max-width: 138rpx; padding: 4rpx 8rpx; overflow: hidden; border-radius: 6rpx; background: #f1f3f5; color: #33465a; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.facts-line, .status-line { display: flex; gap: 10rpx; align-items: center; margin-top: 12rpx; overflow: hidden; color: #516273; font-size: 22rpx; line-height: 30rpx; white-space: nowrap; }
.divider { margin: 0 8rpx; color: #a7adb4; }
.investor { max-width: 180rpx; overflow: hidden; text-overflow: ellipsis; }
.status-line { margin-top: 8rpx; }
.evidence { display: inline-flex; gap: 6rpx; align-items: center; color: #2f8c57; }
.row-side { align-self: stretch; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; min-width: 0; padding: 4rpx 0; }
.amount { max-width: 164rpx; overflow: hidden; color: #071827; font-size: 30rpx; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.watch-button { min-height: 48rpx; margin: 0; padding: 0 12rpx; border: 1rpx solid rgba(200, 167, 102, 0.65); border-radius: 999rpx; background: #fff; color: #9b6d20; font-size: 20rpx; line-height: 48rpx; }
.watch-button.watched { background: #c8a766; color: #fff; }
.mono { font-family: "SFMono-Regular", Consolas, monospace; font-variant-numeric: tabular-nums; }
