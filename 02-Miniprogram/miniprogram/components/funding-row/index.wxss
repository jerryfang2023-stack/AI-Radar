.funding-row { display: grid; grid-template-columns: 82rpx minmax(0, 1fr) 168rpx; gap: 18rpx; align-items: center; min-height: 150rpx; padding: 22rpx; border: 1rpx solid #e5e8ec; border-radius: 20rpx; background: #fff; }
.funding-row.selected { border-color: rgba(200, 167, 102, 0.75); box-shadow: inset 5rpx 0 0 #c8a766; }
.funding-row.dense { min-height: 132rpx; padding-top: 16rpx; padding-bottom: 16rpx; }
.avatar { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; border-radius: 16rpx; background: #edf2f6; color: #0d355c; font-family: "Songti SC", "STSong", serif; font-size: 30rpx; font-weight: 700; }
.row-main { min-width: 0; }
.company-line { display: flex; gap: 10rpx; align-items: center; min-width: 0; }
.company { max-width: 300rpx; overflow: hidden; color: #071827; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.market-badge { flex: none; padding: 4rpx 8rpx; border-radius: 6rpx; background: #e8f2ec; color: #2f7650; font-size: 18rpx; white-space: nowrap; }
.facts-line { display: flex; gap: 10rpx; align-items: center; margin-top: 14rpx; overflow: hidden; color: #6f7f8f; font-size: 22rpx; line-height: 30rpx; white-space: nowrap; }
.divider { color: #a7adb4; }
.row-side { align-self: stretch; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; min-width: 0; padding: 3rpx 0; }
.row-side.no-watch { justify-content: center; }
.amount { max-width: 168rpx; overflow: hidden; color: #071827; font-size: 28rpx; font-weight: 600; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.side-actions { display: flex; gap: 10rpx; align-items: center; }
.compare-state { color: #9b6d20; font-size: 18rpx; white-space: nowrap; }
.watch-button { min-height: 48rpx; margin: 0; padding: 0 13rpx; border: 1rpx solid rgba(200, 167, 102, 0.65); border-radius: 999rpx; background: #fff; color: #9b6d20; font-size: 19rpx; line-height: 48rpx; }
.watch-button.watched { background: #c8a766; color: #fff; }
.mono { font-family: "SFMono-Regular", Consolas, monospace; font-variant-numeric: tabular-nums; }
