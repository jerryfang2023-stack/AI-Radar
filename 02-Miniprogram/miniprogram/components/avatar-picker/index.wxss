.avatar-overlay { position: fixed; inset: 0; z-index: 300; display: flex; align-items: flex-end; background: rgba(7,24,39,.46); }
.avatar-panel { width: 100%; box-sizing: border-box; padding: 32rpx 30rpx calc(24rpx + env(safe-area-inset-bottom)); border-top: 5rpx solid #c8a766; border-radius: 30rpx 30rpx 0 0; background: #fffdf8; color: #071827; }
.avatar-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26rpx; font-size: 34rpx; font-weight: 600; }
.avatar-heading button { margin: 0; padding: 0 12rpx; min-width: 80rpx; font-size: 24rpx; line-height: 60rpx; color: #6f7f8f; background: transparent; }
.wechat-avatar { width: 100%; margin: 0; border-radius: 16rpx; background: #0d355c; color: #fff; font-size: 28rpx; line-height: 86rpx; }
.system-heading { display: block; margin: 30rpx 0 20rpx; color: #6f7f8f; font-size: 24rpx; }
.system-avatars { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 16rpx; }
.system-avatars button { display: flex; flex-direction: column; align-items: center; gap: 10rpx; width: 100%; margin: 0; padding: 12rpx 4rpx; border-radius: 16rpx; background: #f3efe6; color: #0d355c; font-size: 22rpx; line-height: 1.6; }
.system-avatars image { width: 104rpx; height: 104rpx; border-radius: 24rpx; }
.avatar-message { display: block; margin-top: 20rpx; color: #8b6423; font-size: 24rpx; line-height: 1.6; }
.avatar-cancel { margin: 22rpx 0 0; color: #6f7f8f; background: transparent; font-size: 26rpx; line-height: 72rpx; }
button::after { border: 0; }
button[disabled] { opacity: .6; }
