{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision",
          "evidence_path",
          "rationale",
          "evidence_quote"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "evidence_path": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "evidence_quote": {
            "type": "string"
          }
        }
      }
    }
  }
}
