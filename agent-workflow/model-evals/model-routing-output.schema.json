{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "evidence_path", "rationale"],
        "properties": {
          "id": { "type": "string" },
          "decision": { "type": "string", "enum": ["pass", "fail"] },
          "evidence_path": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
