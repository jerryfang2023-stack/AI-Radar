    "products": [
      {
        "name": "主权AI三层架构",
        "description": "深度内核将主权AI的构建拆解为三层：第一层计算层基于密码学、可信芯片与分布式系统，为AI训练和推理基础设施建立可强制执行的信任边界；第二层学习层构建覆盖执行、评估、学习与编排的Agentic Learning Infrastructure，把真实世界的AI运行转化为企业可控的智能复利；第三层交互层构建智能体互联网的核心协议栈，覆盖身份、能力、授权、问责、结算五大关键能力。",
        "target_customers": "企业客户与平台伙伴",
        "features": [
          "可信计算边界（Trusted Computing Boundary）",
          "Agentic Learning Infrastructure",
          "智能体互联网核心协议栈"
        ],
        "evidence_refs": [
          {
