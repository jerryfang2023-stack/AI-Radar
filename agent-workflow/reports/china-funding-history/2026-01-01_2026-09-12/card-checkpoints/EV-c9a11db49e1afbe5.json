        "evidence_signals": [
          "由清华大学与北京雁栖湖应用数学研究院联合孵化，系北京市“专精特新”企业及国家级高新技术企业",
          "自研场景级物理引擎在同等精度下动态距离与碰撞计算效率达到主流物理引擎Newton的5.2倍",
          "柔性体形变计算效率在同等精度下高出一个量级，且材料适应性显著领先",
          "相关成果覆盖NeurIPS 2025、ICLR 2026、IROS 2026等学术会议",
          "完成数亿元A轮融资，由君联资本领投，苏创投、宁波亿时跟投"
        ],
        "risks": [
          "来源未披露具体客户、商业化收入或规模化部署案例，技术演示与学术成果尚未被证实可转化为真实世界长期可靠作业的商业产品。",
          "物理AI从实验室演示到规模化部署面临泛化性、可靠性、持续学习三道门槛，清雁科技自身也承认单次成功不等于可部署，技术路线仍处于早期验证阶段。"
        ],
        "institutional_rationale_status": "disclosed"
      }
