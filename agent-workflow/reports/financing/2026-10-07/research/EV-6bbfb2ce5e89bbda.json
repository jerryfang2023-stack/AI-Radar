    "products": [
      {
        "name": "Cleavr AI原生应收账款自动化平台",
        "description": "AI原生平台，自动跟踪和催收未结发票，与现有ERP系统集成，管理邮件、电话和短信跟进，减少应收账款周转天数。",
        "target_customers": "企业财务团队",
        "features": [
          "与ERP系统集成",
          "邮件、电话和短信跟进",
          "自动处理争议和信用票据",
          "AI理解债务人回复并分类处理"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-597e7f2ec015219b",
            "quote": "Cleavr provides an AI-native platform designed to automate the tracking and collection of outstanding invoices. The software integrates with existing ERP systems to manage email, phone, and SMS follow-ups, reducing days sales outstanding for its customers.",
