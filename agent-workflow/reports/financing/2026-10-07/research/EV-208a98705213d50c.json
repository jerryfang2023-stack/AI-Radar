    "products": [
      {
        "name": "TorchPass",
        "description": "将工作从故障 GPU 迁移到健康 GPU 的容错软件，使训练无需回滚即可继续；新增多节点平台快照和异步应用检查点能力。",
        "target_customers": "企业平台团队、云服务商、neocloud",
        "features": [
          "GPU 故障时实时迁移工作负载",
          "多节点平台快照，无需修改训练代码",
          "异步应用检查点，加速强化学习权重传递"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-bffca0091f22129f",
            "quote": "TorchPass moves work from a failing GPU to a healthy one so training continues instead of rolling back.",
            "source_content_hash": "e22fa368aac97459de6e31993e95c70d6b18d275b6c9a1c777d51a5f414caf25",
            "quote_hash": "53de8cf17e1c3c50931ca1c830550974607630ccf8c99b591409bca81d8855ac"
          },
          {
            "source_id": "FISRC-bffca0091f22129f",
            "quote": "Multi-node platform snapshots, an industry first for training, save an entire running job across every node without changes to the training code and preserve it for recovery.",
            "source_content_hash": "e22fa368aac97459de6e31993e95c70d6b18d275b6c9a1c777d51a5f414caf25",
            "quote_hash": "7553ac306dbf53eaee25857b9ae4e572080d83afa10f4b8ae4e155e700cd34d2"
          }
        ],
        "entity_id": null
      },
      {
        "name": "LinkPass",
        "description": "网络容错软件，在链路故障发生时重新路由流量，使分布式训练和多节点推理不受影响。",
        "target_customers": "企业 AI 基础设施团队、云服务商",
        "features": [
          "拦截链路故障并重新平衡流量",
          "以 NCCL 插件形式交付，无需修改模型"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-bffca0091f22129f",
            "quote": "LinkPass reroutes traffic around a failed link so the job never sees the fault.",
            "source_content_hash": "e22fa368aac97459de6e31993e95c70d6b18d275b6c9a1c777d51a5f414caf25",
            "quote_hash": "23601abefdf3f327ca4a063addfb0cbf8eda6f549498e6be4f78277c3f19fbf7"
          },
          {
            "source_id": "FISRC-9539c638516ce9ef",
            "quote": "LinkPass intercepts link failures the moment they happen and rebalances traffic across the node’s other NICs",
            "source_content_hash": "ba0b357e3228f452",
            "quote_hash": "6d59159566ef275e26386f26f6b006ce5bb79717a8ad6f1b3269f4e9bece7ccd"
          }
        ],
        "entity_id": null
      },
      {
        "name": "FleetLens",
        "description": "AI 集群可观测性平台，检测慢速或故障作业，定位具体链路、交换机或网卡问题。",
        "target_customers": "企业 AI 基础设施团队、云服务商",
        "features": [
          "纳秒级遥测",
          "定位故障链路、交换机或网卡",
          "集群上线前验证"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-9539c638516ce9ef",
            "quote": "FleetLens detects slow or failing jobs and definitively rules whether the fabric is to blame. When it is, FleetLens pinpoints the exact link, switch or NIC at fault.",
