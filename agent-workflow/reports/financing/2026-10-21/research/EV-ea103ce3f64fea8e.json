    "analysis": {
      "investment_rationale": [
        {
          "institution": "Andreessen Horowitz",
          "speaker": "Raghu Raghuram",
          "speaker_role": "a16z 普通合伙人",
          "rationale": "认为 Eka 的视觉-力-动作模型是首个真正解决操作问题、具备部署所需泛化性和吞吐量的方法，团队具备推动机器人研究前沿并扩展商业运营的理想基因。",
          "quote": "Eka’s Vision-Force-Action model is the first approach I’ve seen that truly solves manipulation with the generality and throughput needed for deployments",
          "evidence_refs": [
            {
              "source_id": "FISRC-446b932b6460b1a7",
              "quote": "Eka’s Vision-Force-Action model is the first approach I’ve seen that truly solves manipulation with the generality and throughput needed for deployments",
