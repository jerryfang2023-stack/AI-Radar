    "products": [
      {
        "name": "Vision-Force-Action (VFA) 模型",
        "description": "一种将视觉感知与力反馈结合的机器人操作基础模型，通过物理仿真和大规模强化学习训练，使机器人能根据接触力调整抓取和操作动作。",
        "target_customers": "工业客户，用于拾取放置、线缆操作等任务",
        "features": [
          "结合视觉与力反馈",
          "通过物理仿真和强化学习训练",
          "可泛化到训练分布外的物体和任务"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-5c947a61567ff990",
            "quote": "the schema here is a vision-force-action model, which focuses on the relationship between language, force inputs, and actions.",
            "source_content_hash": "e3b9ebd758bd3007981110c15582ea048d239f4a03f89682f8fae82a97fbd2f4",
            "quote_hash": "d590da737a92feb2d5768c2ec1e0065fa20a68aa65e36cf591911e1f6b3841cf"
          }
        ],
        "entity_id": null
      },
      {
        "name": "力敏感夹爪",
        "description": "Eka 设计的独特机械手，比传统夹爪更灵活，包含更多力传感器，能对接触做出反应，避免压碎易碎物体。",
        "target_customers": "工业客户",
        "features": [
          "成本低于 $1,000",
          "额定 500 万次工作循环",
          "目标达到 2000 万次工业标准"
        ],
        "evidence_refs": [
          {
