            "quote_hash": "c6350edcedca67f16ae6b39bce82f9655d7275353278bbf3789fe55e0b8e05f1"
          },
          {
            "source_id": "FISRC-f2db783543989a75",
            "quote": "Developers can connect a robot through the Dream API, which runs Dream Labs’ models in data centres worldwide, or send a small batch of demonstration data to a fine-tuning service that returns a tailored model within hours.",
            "source_content_hash": "3b7a378312835e65c53b869b65ce91eb72a41e517204250bc81a07d35e3ccb12",
            "quote_hash": "8428501c83fb9f0f6401c48bec29c92c458a1dde616cd9d155d9900fefebbcc3"
