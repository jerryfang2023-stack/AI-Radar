    "products": [
      {
        "name": "Dream-1",
        "description": "机器人基础模型，基于人类执行日常任务的视频训练，预测后续画面并推导机器人动作，据称可零样本控制带夹爪的双臂机器人。",
        "target_customers": "机器人硬件厂商与开发者",
        "features": [
          "基于人类任务视频训练",
          "零样本控制带夹爪机器人",
          "支持桌面抓取放置与叠衣任务"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-9460824b44abe360",
            "quote": "Dream-1, a robot foundation model trained on videos of people performing everyday tasks rather than on robot-specific teleoperation data alone",
            "source_content_hash": "ae52443c36749a4e66d5b3117ccb71120accf821cf3978801c7c55c62971eb4a",
            "quote_hash": "628fe8636dd584e6ed8e603e51a53319da2a72c1263a3165fcafb5cd1edfdfd1"
          }
        ],
        "entity_id": null
      },
      {
        "name": "Dream API",
        "description": "公开可用的机器人基础模型API，将机器人摄像头画面与自然语言指令转换为电机指令，并可在未见过的硬件上运行。",
        "target_customers": "机器人开发者与硬件合作伙伴",
        "features": [
          "摄像头画面加自然语言指令转电机指令",
          "支持未见过的硬件",
          "提供微调服务与浏览器Robot Playground"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-9460824b44abe360",
            "quote": "Dream API takes a robot’s camera feed plus a plain-English instruction and converts both into motor commands, including on hardware the underlying model has never seen before.",
