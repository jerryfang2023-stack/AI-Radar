    "products": [
      {
        "name": "AI原生稳定币外汇基础设施",
        "description": "以交易对手方身份同时承接交易两侧，将多段外汇交易合并为单笔直接定价交易，并利用深度学习模型预测市场状况。",
        "target_customers": "支付服务提供商（PSP）、汇款运营商、稳定币发行方、交易场所及其他平台",
        "features": [
          "作为交易双方的本金方（act as principal on both sides of the trade）",
          "将多个外汇交易环节合并为单笔直接定价交易",
          "深度学习模型可预测超过10,000种工具的市场状况",
          "支持通过报价请求（RFQ）、API流式报价或公开场所接入"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-38fc428924367197",
            "quote": "IMMIX’s solution: act as principal on both sides of the trade. The company collapses multiple FX legs into a single, directly priced transaction.",
