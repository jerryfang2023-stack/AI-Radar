    "products": [
      {
        "name": "AI Sales Operating System",
        "description": "一套完整的AI销售操作系统，支持顾问在客户会议前、中、后开展工作。其助手实时转录会议，转录内容匿名化且不存储音频，并基于顾问自己的模板自动生成符合IDD要求的文档。",
        "target_customers": "金融和保险顾问",
        "features": [
          "实时转录会议，匿名化且不存储音频",
          "基于顾问模板自动生成IDD合规文档",
          "实时辅助功能在通话中提供异议处理回应和下一步最佳行动提示",
          "AskTODAY允许顾问通过聊天查询全部对话历史"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-12ea6fdfef5a4fb0",
            "quote": "With TODAY, the founders have built a full AI Sales Operating System that supports advisors before, during, and after client meetings.",
            "source_content_hash": "795e7f8ddef8040d0815f8977f22b85037f30a3f6cfd04a97e2675b3a6470f62",
            "quote_hash": "45c551245bceb8dd54a69509771c03389b70453bba03c032e21aaa9c24f681ab"
          },
          {
            "source_id": "FISRC-12ea6fdfef5a4fb0",
            "quote": "Its assistant transcribes meetings in real time, which is anonymised with no audio stored, and automatically generates IDD-compliant documentation based on the advisor’s own templates.",
            "source_content_hash": "795e7f8ddef8040d0815f8977f22b85037f30a3f6cfd04a97e2675b3a6470f62",
            "quote_hash": "7a1a221de473ae4a5a72e08468ebcec1699bac92d9ff9a3b07cbcb7057a3fe8e"
          },
          {
            "source_id": "FISRC-12ea6fdfef5a4fb0",
            "quote": "A real-time assist feature surfaces objection-handling responses and next-best-action prompts during live calls, while AskTODAY lets advisors query their entire conversation history by chat.",
            "source_content_hash": "795e7f8ddef8040d0815f8977f22b85037f30a3f6cfd04a97e2675b3a6470f62",
            "quote_hash": "1bc98c761d4b902dd0db2eb2f267b9013a5ef35d7fe57ff42d2a22d2b2adeac1"
          }
        ],
        "entity_id": null
      },
      {
        "name": "Simulation product",
        "description": "一个AI培训环境，顾问可以在其中与可配置的AI客户进行语音对话，覆盖DISC性格画像，并在此过程中获得IDD继续教育学分。",
        "target_customers": "金融和保险顾问",
        "features": [
          "与可配置的AI客户进行语音对话",
          "覆盖DISC性格画像",
          "获得IDD继续教育学分"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-12ea6fdfef5a4fb0",
            "quote": "Alongside the assistant, there is also a simulation product, which is an AI training environment where advisors can hold voice conversations with configurable AI customers across DISC personality profiles, earning IDD continuing education credits in the process.",
            "source_content_hash": "795e7f8ddef8040d0815f8977f22b85037f30a3f6cfd04a97e2675b3a6470f62",
            "quote_hash": "d3db89cbdecddd928ebf77550168e113f5a9cf2686c365d3e8c9d64caa194c83"
          }
        ],
        "entity_id": null
      },
      {
        "name": "Compliant AI agents",
        "description": "合规的AI智能体，通过转录客户会议、处理日常后台任务、接听来电，甚至辅导顾问的销售表现，将行政工作从顾问的桌面上移走。",
        "target_customers": "金融和保险顾问",
        "features": [
          "转录客户会议",
          "处理日常后台任务",
          "接听来电",
          "辅导顾问销售表现"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-12ea6fdfef5a4fb0",
            "quote": "TODAY addresses these concerns with compliant AI agents that take administrative work off advisors’ desks by transcribing client meetings, handling routine back-office tasks, answering incoming calls, and even coaching advisors on their sales performance.",
