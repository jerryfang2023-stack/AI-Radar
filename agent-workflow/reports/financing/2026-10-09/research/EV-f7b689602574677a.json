    "products": [
      {
        "name": "Controlled Microbial Upcycling",
        "description": "结合合成生物学与AI的受控微生物升级循环工艺，将有机废弃物转化为脂肪酸，作为可持续航空燃料（SAF）生产的关键原料。",
        "target_customers": "沼气厂运营商、可持续航空燃料生产商",
        "features": [
          "利用AI优化有机废弃物向脂肪酸的转化",
          "可整合至现有厌氧消化基础设施，包括欧洲各地沼气厂",
          "使用更丰富的废弃物原料，如食物垃圾、农业残余物和林业副产品",
          "与现有HEFA生产工艺兼容"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-d4882614e143350f",
            "quote": "The startup’s Controlled Microbial Upcycling process combines advances in synthetic biology with AI to optimise the conversion of organic waste into fatty acids.",
            "source_content_hash": "d00757ae0cb1ee65a0d004562b0c216c37cda223494a5d49bf2ecc6cf4641053",
            "quote_hash": "97808bce344712003175b3c5dd56d472ca3c3ddc4169c2fb27bbaadb09d3a8ce"
          }
        ],
        "entity_id": null
      }
