            "quote_hash": "421dadf3d2d0d93e9b98ec4b7f9f8000488aa59a26d9c8720275b4178d85f4c0"
          },
          {
            "source_id": "FISRC-646d5346067a2ff2",
            "quote": "Owners pay a single 20% fee, which Fairly splits with the caretaker, compared with the 25% to 40% the company says other managers typically charge.",
