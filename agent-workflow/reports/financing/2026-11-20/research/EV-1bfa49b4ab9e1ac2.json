    "products": [
      {
        "name": "双摄像头数据采集硬件与标注软件",
        "description": "Humyn Labs 自研双摄像头硬件记录人们执行日常任务，再用软件处理并标注影像，追踪手部动作、物体交互等细节，把原始录像转化为AI模型可学习的训练数据。",
        "target_customers": "前沿AI实验室、机器人公司、世界模型开发者",
        "features": [
          "自研双摄像头采集硬件",
          "软件处理与标注",
          "追踪手部动作和物体交互",
          "将人类活动转化为视觉、声音、运动等多模态信号基元"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-7910f56b348bc37f",
            "quote": "Humyn Labs has developed its own two-camera hardware to record people performing everyday tasks. It then uses its software to process and label the footage",
