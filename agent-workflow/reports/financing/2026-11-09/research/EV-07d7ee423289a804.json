    "products": [
      {
        "name": "Finpilot 机构资本 AI 操作系统",
        "description": "把机构的投资组合管理系统、文档存储等来源的数据汇入统一记录，用户通过聊天窗口提问并配置智能体处理季度经理报告、对账、委员会材料、客户报告等重复工作，关键步骤需人工审批。",
        "target_customers": "捐赠基金、基金会、养老金、家族办公室、OCIO、RIA 与财富管理机构的内部投资团队",
        "features": [
          "统一记录与实体匹配",
          "聊天式问答与智能体工作流",
          "每个数字可回溯到来源文档",
          "人工审批节点",
          "不将客户数据用于模型训练"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-6e0cc8a5dd051546",
            "quote": "Finpilot pulls an institution’s data from its portfolio management system, document storage and other sources into a single record, matching each fund, holding and client to one identifier.",
            "source_content_hash": "29850c8142ef2e46ade0320eb9ea2246751f7266231d77ada18c7a4c07ff36ed",
            "quote_hash": "047ce5224307bfeb254fe65635a47e4ae037e21ac4825de9f244dd87d6cdf66d"
          },
          {
            "source_id": "FISRC-5d39d872ae9161f7",
            "quote": "Agents finish the work and stop where you're needed. On your templates, in your voice, paused for your approval.",
            "source_content_hash": "c3aebdc1a842cf9f",
            "quote_hash": "e5fee106318560fb7336ff4bce47359e1998f65d68ce7369216c256eb8a8c730"
          }
        ],
        "entity_id": null
      }
    ],
