    "products": [
      {
        "name": "Epsilon",
        "description": "AI 设计智能体，可解析通俗英语表述的设计需求，读取元器件数据手册和制造商规格，选择元器件并提供备选方案，生成原理图和自定义符号或封装，进行 PCB 布局和布线，并依据电气规则检查、设计规则检查及制造约束验证设计。",
        "target_customers": "个人工程师、初创公司、设计服务提供商和大型企业",
        "features": [
          "在工程师已有的 EDA 工具内自动化工作流，支持 KiCad、Altium 和 LTspice",
          "可通过 Claude Code、Cursor 和 Codex 等 AI 编程智能体访问",
          "生成审查报告，区分阻塞性问题和非阻塞性问题并按优先级排列修复项",
          "可连接 GitHub 和工单系统，支持可复用技能"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-0b078eb71cb87b58",
