    "products": [
      {
        "name": "Cygrid身份执行平台",
        "description": "将人类、非人类和AI智能体身份映射到统一图谱，关联每个身份的授权、实际行为及代表对象，并在操作执行前实时检查、阻止或收窄权限。",
        "target_customers": "部署AI智能体的企业安全团队",
        "features": [
          "统一身份图谱",
          "逐操作实时执行",
          "秒级撤销遗忘令牌",
          "阻止高风险AI智能体命令"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-880e4507b090ae93",
            "quote": "It also maps human, non-human and AI agent identities into a single intelligence graph, correlating what each identity is entitled to, what it actually does, and on whose behalf it acts.",
            "source_content_hash": "340a05305bf0fe617b7d882af05ee95f37f9abdb10b5b029bd6558a9e0f05c0f",
            "quote_hash": "072e31d6694cff5eb7e327be2252231df376bab73b480d5c5e82340336607919"
          },
          {
            "source_id": "FISRC-efcc936261bf8ff6",
            "quote": "It maps human, non-human and AI agent identities into one graph, scores what each one can do, and enforces it wherever an identity can act.",
            "source_content_hash": "f5056ddce22c4a41",
            "quote_hash": "3a7803279c8371c3fb9e465b8743872072300d6bfd944294b1d7b4bfb744764a"
          }
        ],
        "entity_id": null
      },
      {
        "name": "MCP Gateway",
        "description": "在智能体工具调用到达目标系统前评估其操作，并允许、改写或阻止该请求。",
        "target_customers": "使用MCP工具调用的企业安全团队",
        "features": [
          "操作前评估",
          "允许/改写/阻止请求"
