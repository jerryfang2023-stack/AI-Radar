    "products": [
      {
        "name": "Simplismart推理平台",
        "description": "位于AI模型与算力基础设施之间的软件层，按客户应用需求自动配置模型部署与运行方式，优化响应速度、吞吐量和算力消耗，支持在自有平台或客户既有云及本地基础设施上运行。",
        "target_customers": "AI应用公司、企业、云服务商",
        "features": [
          "按工作负载自动配置推理服务栈",
          "自动扩缩容与性能监控",
          "支持模型微调",
          "支持BYOC及本地部署",
          "帮助云服务商构建自有品牌托管推理服务"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-72e188139d846686",
            "quote": "Simplismart’s software sits between AI models and the computing infrastructure they run on and adjusts how models are deployed and managed to meet customers’ requirements",
            "source_content_hash": "5f8a7c2fb447ecfe448729eb9c8c45c570944a677360d4738340c557b478753d",
            "quote_hash": "ca0626c17185b98d8ae7c03eaff2fcf0696b9bbbb32965c8630ad0efb148d5ed"
          },
          {
            "source_id": "FISRC-26e008b10708f9d1",
            "quote": "Our modular inference engine configures the serving stack around the workload. Our orchestration platform gets it into production and manages capacity as demand changes.",
            "source_content_hash": "e4a83260d3f2c3c8",
            "quote_hash": "ad418c35062e7a972e96d79181cef40214e6c6d12a9ced36d67c3971d8e44066"
          }
        ],
        "entity_id": null
      },
      {
        "name": "AI token factories（云服务商方案）",
        "description": "面向云服务商和数据中心运营商的软件方案，将第三方GPU算力转化为可对外销售的托管AI推理服务，并以运营商自有品牌交付。",
        "target_customers": "云服务商、数据中心运营商、主权AI基础设施参与者",
        "features": [
          "将GPU容量转化为托管AI服务",
          "运营商自有品牌交付",
          "serverless推理层"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-26e008b10708f9d1",
            "quote": "This is the software behind what we call AI token factories: turning GPU capacity into services for running models, under the provider’s own brand.",
            "source_content_hash": "e4a83260d3f2c3c8",
            "quote_hash": "a5dc82a763ff6632136414209d615d1c42675a0229bc7aabe1b817403dbb6696"
          },
          {
            "source_id": "FISRC-060d3a287a3a0dbd",
            "quote": "it supplies the software layer that enables third-party GPU infrastructure to run production AI workloads",
            "source_content_hash": "e9cf887f4c945e38",
            "quote_hash": "10e8bd8d963bb13706c478220700b4d6b3404116c7c44481cc6f6233d96621ba"
          }
        ],
        "entity_id": null
      }
