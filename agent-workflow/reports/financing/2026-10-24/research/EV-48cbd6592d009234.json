    "products": [
      {
        "name": "Mach9 AI CAD 软件",
        "description": "面向土木工程的 AI CAD 软件，上传用现有设备采集的道路、公用设施和施工现场三维扫描后，自动绘制路缘、标志、杆件、车道标线和线缆等物理要素，精度达厘米级，测量师和工程师再用编辑工具复核、修改和定稿。",
        "target_customers": "土木工程与测量团队、交通机构",
        "features": [
