    "products": [
      {
        "name": "Hunar Voice",
        "description": "对话式AI语音代理，用于一线劳动力工作流中的候选人沟通与筛选。",
        "target_customers": "一线劳动力密集型企业",
        "features": [
          "语音对话",
          "候选人筛选"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-21f1e0578f986661",
            "quote": "Hunar’s platform comprises Hunar Voice and Hunar Connect, which use conversational AI agents to manage workforce workflows through voice, WhatsApp and chat.",
            "source_content_hash": "bf76342df2cb27fe2159ad0ba6e91e1329271f4b769c5e5822a9c1665330ca5b",
            "quote_hash": "5a63271bc4a2c38ae70004941a92521bd545ad2df213ef0fc9a1017d96d8b863"
          }
        ],
        "entity_id": null
      },
      {
        "name": "Hunar Connect",
        "description": "通过WhatsApp和聊天等渠道执行一线劳动力工作流的对话式AI系统。",
        "target_customers": "一线劳动力密集型企业",
        "features": [
          "WhatsApp与聊天渠道",
          "招聘与入职工作流",
          "培训与员工参与"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-21f1e0578f986661",
            "quote": "Workflows include candidate sourcing and screening, interview scheduling, onboarding, training, employee engagement and worker retention.",
            "source_content_hash": "bf76342df2cb27fe2159ad0ba6e91e1329271f4b769c5e5822a9c1665330ca5b",
            "quote_hash": "6183dfffbe8787be243d5a913e573b9e0c028e9b2aea60b3dcf516b685e1eb92"
          },
          {
            "source_id": "FISRC-843bd654b889e181",
            "quote": "We moved workers from apps to tools they already use, like WhatsApp. We built systems of record while everyone else was building only agents.",
            "source_content_hash": "f1c3e664510458a5",
            "quote_hash": "f997ccc9ca8d2b89fbebf3ed7e3259dcd94be8c44fc269b6b7bf0378be1a7706"
          }
        ],
        "entity_id": null
      }
    ],
