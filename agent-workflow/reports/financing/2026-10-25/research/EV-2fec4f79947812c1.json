    "products": [
      {
        "name": "垂直氮化镓（GaN）FinFET平台",
        "description": "基于垂直架构的氮化镓功率晶体管平台，旨在降低功率转换过程中的能量损耗和发热，并缩小电力基础设施的物理占用空间。",
        "target_customers": "AI数据中心运营商、高性能计算基础设施提供商、关键能源基础设施企业",
        "features": [
          "垂直GaN FinFET架构",
          "兼容标准硅CMOS制造工艺",
          "支持100V至1.2kV器件",
          "已在8英寸晶圆上验证"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-16aa4356f2e7d63d",
            "quote": "Vertical Semiconductor is developing a vertical gallium nitride FinFET platform intended to deliver greater power efficiency and higher power density than conventional semiconductor power conversion approaches.",
