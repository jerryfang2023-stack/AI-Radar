    "products": [
      {
        "name": "Holo营销自动驾驶平台",
        "description": "用户输入公司网站后，Holo学习企业销售内容与品牌风格，结合业主目标提出营销计划，并生成广告、社交媒体帖子、邮件和SEO内容，组织在日历中供审核、修改或批准发布；选定任务可切换为自动执行。",
        "target_customers": "小企业主",
        "features": [
          "输入网站自动生成营销计划",
          "以品牌自身语气生成广告、社交帖子、邮件和SEO内容",
          "内容日历审核与批准",
          "选定任务自动驾驶",
          "跟踪结果并建议调整预算或内容形式"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-964061dbde0b373c",
            "quote": "To get started, the business owner enters the company’s website. Holo learns what the business sells and how the brand looks and communicates, then uses that information, along with the owner’s goals, to suggest a marketing plan.",
            "source_content_hash": "4f038f57b55b1e7f623f35e4c17f3b6478081716e3ed4a0860aff12696fa58dc",
            "quote_hash": "3adc19e7b80bd0883794e612b2eed88b2ba659b5cfc8c363288a04aceca1ebab"
          },
          {
            "source_id": "FISRC-fd7c98a3f90f7292",
            "quote": "The platform produces ads, social posts, emails, and SEO content, organising them in a content calendar for review and approval.",
            "source_content_hash": "c5c4e9ef6673ae7d",
            "quote_hash": "0771381e2432fa601577f28dee5011dd68b23861a7c6b31dd8b53e14da333394"
          }
        ],
