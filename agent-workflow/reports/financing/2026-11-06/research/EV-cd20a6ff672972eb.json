    "products": [
      {
        "name": "Siggy心理健康服务",
        "description": "患者先通过免费AI对话回答病史问题，随后由持证临床医生视频复诊、诊断并按需开药；就诊间隙患者可与AI对话并每日打卡睡眠、情绪、用药和身体感受，结合可穿戴设备数据生成每日百分制Siggy Score。",
        "target_customers": "寻求心理健康诊疗与用药管理的患者",
        "features": [
          "AI对话采集病史",
          "持证临床医生视频诊疗与处方",
          "每日打卡与可穿戴设备数据整合",
          "每日Siggy Score评分并向临床医生标记变化"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-98dccdb46867778c",
            "quote": "Patients begin by answering questions about their history through a free AI conversation. They then meet a licensed clinician by video, who reviews that information.",
            "source_content_hash": "c5f60ff043880e09bedebdeb0d139a7ae8bc0e4b9638049f9b8b0a072fb85252",
            "quote_hash": "4071eb6914d933191066fe9a2ca0560f6f4c6a2fea1979b5c7c5ccc5d80d2af9"
          },
          {
            "source_id": "FISRC-98dccdb46867778c",
            "quote": "The company combines those answers with data from connected wearable devices to produce a daily “Siggy Score” out of 100.",
            "source_content_hash": "c5f60ff043880e09bedebdeb0d139a7ae8bc0e4b9638049f9b8b0a072fb85252",
            "quote_hash": "ad6f449dced2b1a67733ba313cd7c48cfdac033425b2b019d31c67a712a62295"
          }
        ],
        "entity_id": null
      }
    ],
