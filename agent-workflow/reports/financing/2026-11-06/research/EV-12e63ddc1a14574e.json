    "products": [
      {
        "name": "Shackleton 智能体操作系统",
        "description": "面向开发与施工管理的智能体操作系统，将开发、预施工、项目与现场管理、财务和沟通统一到单一系统，AI 智能体跨共享数据处理行政任务。",
        "target_customers": "中型总承包商，以及多地点品牌、业主和开发商",
        "features": [
          "AI 智能体起草 RFI、跟进逾期提交文件、在付款申请审批前标记预算偏差、将现场记录转为日报",
          "覆盖从选址到项目移交的施工全生命周期",
          "通过审查与审批流程保留人工监督",
          "支持离线读取和标注图纸，恢复连接后同步"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-48ad2f372a4431f7",
            "quote": "AI agents handle many of the administrative tasks that consume project managers' time, including drafting RFIs, following up on overdue submittals, flagging budget variances before payment requests are submitted for approval and converting field notes into daily reports.",
