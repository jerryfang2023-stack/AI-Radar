    "products": [
      {
        "name": "Kanu AI 平台",
        "description": "自动将员工日常工作流程转化为定制企业级软件，在客户自有云环境中构建、部署和更新工作流。",
        "target_customers": "企业客户，覆盖商业地产、保险、金融服务和科技行业。",
        "features": [
          "员工演示工作方式，平台自动构建工作流",
          "在客户自有云基础设施内运行，数据保留在现有防火墙后",
          "包含人工审批步骤，为每个自动化输出提供完整审计追踪",
          "通过 AWS 和 Google Cloud 市场提供"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-2600408f2e0d32d7",
            "quote": "Rather than forcing companies to buy rigid off-the-shelf software or spend months on custom engineering, Kanu lets staff demonstrate how they complete work. The platform then builds, deploys, and updates those workflows directly within the customer’s cloud.",
            "source_content_hash": "72b0d57fbc3389cbdeb2ae193aabff25a09c59cf93a65c3a6a7a425a5e8e9c1c",
            "quote_hash": "c3bebcec82256adaae54a137a8176666ff9e617d55c4d7cbddd702d7b25df5ac"
          },
          {
            "source_id": "FISRC-2600408f2e0d32d7",
            "quote": "To meet enterprise security standards, Kanu runs entirely inside the client’s own cloud infrastructure, ensuring data stays behind existing firewalls. The platform also includes human approval steps and provides full audit trails for every automated output.",
            "source_content_hash": "72b0d57fbc3389cbdeb2ae193aabff25a09c59cf93a65c3a6a7a425a5e8e9c1c",
            "quote_hash": "b31eaa3d345854070d3c75da3a011cdcc053acb4541cb7de31bc5fc3cbc01a7d"
          }
        ],
        "entity_id": null
      }
    ],
    "customers": [
