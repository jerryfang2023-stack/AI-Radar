    "products": [
      {
        "name": "Wabi 2.0 个人 AI 智能体",
        "description": "Wabi 2.0 是一款个人 AI 智能体，可作为 AI 即时通讯工具，构建用户完成任务所需的界面，并支持将对话转化为共享工具。",
        "target_customers": "个人消费者",
        "features": [
          "通过提示词构建迷你应用",
          "将助手引入群聊以协调活动",
          "将对话转化为共享工具如旅行行程",
          "处理预约或购物退货等请求"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-bc01622ffa1cd4de",
            "quote": "The idea now is that the new Wabi — or Wabi 2.0, as it was called — could build the interfaces you need to get things done as part of its role as your personal AI agent.",
            "source_content_hash": "23c10dda6f07e5b9c44625c71399ea47dafc1e57e4bc4b8f87d6c3992821f0f6",
            "quote_hash": "c8568aa1e34608bcee9f84de1a29c8d86991f691983e58c07e9455898bf3ef3d"
          },
          {
            "source_id": "FISRC-8c9c7bf4acbab387",
            "quote": "Users can bring the assistant into group chats to help plan trips, line up schedules and manage day-to-day tasks. It can turn conversations into shared tools like travel itineraries, handle requests like booking appointments or making shopping returns.",
            "source_content_hash": "1e5b6df22dfd59a3",
            "quote_hash": "5ffe77d52c7e9d6fd73494a69ca146308187b48ccfbd1cb2848e80c4e14df8b4"
          }
        ],
        "entity_id": null
      },
      {
        "name": "Wabi 迷你应用平台",
        "description": "Wabi 最初是一个允许任何人通过提示词构建应用的平台，用户可生成、混编和消费个人软件，并选择底层模型如 ChatGPT 或 Gemini。",
        "target_customers": "个人消费者",
        "features": [
          "通过自然语言提示词生成应用",
          "选择底层模型如 ChatGPT 或 Gemini",
          "编辑 Wabi 的提示词",
          "社交发现功能：点赞、评论、混编、浏览个人资料"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-bc01622ffa1cd4de",
            "quote": "Wabi originally focused on allowing anyone to build apps using prompts.",
            "source_content_hash": "23c10dda6f07e5b9c44625c71399ea47dafc1e57e4bc4b8f87d6c3992821f0f6",
            "quote_hash": "fc1a23161ad9ba7329f070c9b12c448c2bbf7a0f4ee51090deb8ec1fcf3094ca"
          },
          {
            "source_id": "FISRC-f974c6bd67d9cec9",
            "quote": "Users can generate apps from natural-language prompts while selecting underlying models such as ChatGPT or Gemini for AI-generated content, with the option to edit Wabi’s prompts.",
            "source_content_hash": "ce78884b677a7fe7",
            "quote_hash": "86784bbc5165ccd0e8ebba082d7efe85aa15d54a720f807ab7183453365a2de6"
          }
        ],
        "entity_id": null
      }
