    "products": [
      {
        "name": "Clueso",
        "description": "AI 智能体视频平台，可规划、创建、编辑并持续更新企业视频，同时将同一内容转化为分步指南。",
        "target_customers": "企业中的营销、客户成功、教育、入职培训、销售赋能、产品、运营等团队。",
        "features": [
          "AI 智能体理解公司产品、流程、品牌和上下文，创建并维护视频",
          "从屏幕录制自动生成脚本、AI 配音、视觉效果和字幕",
          "将视频内容转化为带截图和说明的分步指南",
          "支持 150+ 种语言的翻译和本地化",
          "Clueprints 捕获视频风格和结构，实现可复用的一致性"
        ],
        "evidence_refs": [
