    "products": [
      {
        "name": "Scinode",
        "description": "Scimplify 自研的 AI 平台，通过专用 AI 智能体协调研发、制造和质量控制，识别合适的生产路线与制造设施，并跟踪质量与法规要求。",
        "target_customers": "特种化学品与先进材料客户，包括半导体、国防、能源、电子等行业制造商",
        "features": [
          "使用专用 AI 智能体分别处理研究、制造和质量控制等不同职能",
          "从客户需求出发反向推导生产方案",
          "识别合适的生产路线和制造设施",
          "跟踪质量与法规要求",
          "记忆客户上下文以供未来参考"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-1cf1a3388554a4ca",
            "quote": "Its proprietary AI platform, Scinode, helps coordinate the work by identifying suitable production routes and manufacturing facilities, while tracking quality and regulatory requirements.",
