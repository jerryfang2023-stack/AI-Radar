            "quote_hash": "09a76495696538474412e8f42bc8d06c8f3772f776d3cb8ab15d335f1c7e8833"
          }
        ],
        "entity_id": null
      },
      {
        "name": "特种化学品与先进材料端到端开发制造服务",
