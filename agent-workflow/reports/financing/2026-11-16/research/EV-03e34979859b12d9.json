    "products": [
      {
        "name": "Nebuly AI ROI 平台",
        "description": "分析企业内部员工工具和面向客户的助手等 AI 智能体的实际行为，将结果汇总到单一视图，衡量 AI 带来的效率提升、释放的新任务、影响的收入以及流失风险和增购机会。",
        "target_customers": "大型企业，多数客户收入超过 10 亿美元",
        "features": [
          "衡量员工端 AI 节省的工时和释放的产能",
          "识别 AI 用于高价值工作还是常规任务",
          "追踪客户助手影响的收入和流失风险",
          "所有假设保持可见且可调整",
          "可本地部署或在客户私有云运行"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-a6794f376969c20a",
            "quote": "Nebuly measures what AI is really worth to a business. It analyzes what AI agents actually do inside an organization, across internal employee tools and customer-facing assistants, and brings the results into a single view.",
            "source_content_hash": "5ca76d37a202d850",
            "quote_hash": "243ccee72c3308733f805b04b3ad4b74884479e75c091f18ccaea70b2a3ce193"
          },
          {
            "source_id": "FISRC-a6794f376969c20a",
            "quote": "For employee-facing AI, it measures two kinds of value: the efficiency AI creates, in hours saved and capacity freed up, and the new tasks it unlocks that teams could not take on before.",
            "source_content_hash": "5ca76d37a202d850",
            "quote_hash": "15cfdc46a6f2c25bb7f35690a41ac809ca7507c6880973d4900cb05000160eb6"
          }
        ],
        "entity_id": null
      },
