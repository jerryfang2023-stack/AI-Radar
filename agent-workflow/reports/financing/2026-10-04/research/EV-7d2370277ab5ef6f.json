    "products": [
      {
        "name": "AI 辅助自闭症与发育筛查系统",
        "description": "面向 16 个月至 9 岁儿童的初步筛查层，使用标准笔记本电脑和摄像头采集围绕九个刺激模块的短视频，通过计算机视觉分析注视、对名字的反应和面部表情反应等行为信号，生成风险报告以提示是否需要正式临床评估，不提供诊断。",
        "target_customers": "儿科医生、政府初级卫生中心、学校医务室、私营医疗机构",
        "features": [
          "使用标准笔记本电脑和网络摄像头",
          "九个刺激模块的短视频采集",
          "计算机视觉分析注视、对名字的反应和面部表情反应",
          "生成风险报告，提示是否需要正式临床评估",
          "不提供诊断"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-ff1952b8850f6680",
            "quote": "Aignosis' system is designed to provide an initial screening layer for children aged 16 months to nine years. It uses a standard laptop and webcam to capture a short video built around nine stimulus modules, with computer vision analysing behavioural signals such as gaze, response to name and reactions to facial expressions.",
            "source_content_hash": "2c11d79204059801e36a2c97b161439e0495580d4d0dade47635c04fe4711b09",
            "quote_hash": "007b3f876a6981e4cc721574aae6ece040da01759aee37846f93798fc6106012"
          },
          {
            "source_id": "FISRC-ff1952b8850f6680",
            "quote": "The resulting risk report indicates whether a formal clinical assessment may be warranted and is not intended to provide a diagnosis.",
            "source_content_hash": "2c11d79204059801e36a2c97b161439e0495580d4d0dade47635c04fe4711b09",
            "quote_hash": "cb2ceca00f1eaa76c8b7c5ea9683a4ae5d00dedc0bc85efb35d83646bb4ddb83"
          }
        ],
        "entity_id": null
      }
