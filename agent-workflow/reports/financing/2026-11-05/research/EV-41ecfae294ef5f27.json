    "products": [
      {
        "name": "Tallia AI研究与起草平台",
        "description": "面向税务与会计专业人士的AI平台，将AI生成回答与相关税务法规、监管指引和判例法关联，支持核验，并结合事务所内部文档、合同、模板和既往工作成果。",
        "target_customers": "税务与会计专业人士及专业事务所",
        "features": [
          "自定义检索系统将AI回答关联税务权威来源",
          "结合外部税务知识与事务所内部知识",
          "结构化审查工作流供资深人员核查推理与证据",
          "支持Microsoft Word、Excel、PowerPoint和Outlook工作流"
        ],
        "evidence_refs": [
