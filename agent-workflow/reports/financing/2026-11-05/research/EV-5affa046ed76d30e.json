    "quotes": [
      {
        "speaker": "Leon Rauch",
        "quote": "I suffered from jaw pain myself for years and saw how little you can do between two dental appointments. That is exactly the gap we close. With this funding, we are now starting the clinical trial and taking the next step towards reimbursement",
        "evidence_refs": [
          {
            "source_id": "FISRC-5a11f19d8df5938f",
            "quote": "I suffered from jaw pain myself for years and saw how little you can do between two dental appointments. That is exactly the gap we close. With this funding, we are now starting the clinical trial and taking the next step towards reimbursement",
