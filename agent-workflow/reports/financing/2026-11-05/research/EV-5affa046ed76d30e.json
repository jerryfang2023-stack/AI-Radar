    "products": [
      {
        "name": "JawBuddy应用",
        "description": "面向下颌疼痛、磨牙症及颞下颌关节紧张人群的个性化居家自我治疗应用，提供物理治疗师设计的引导式训练，并通过智能手机摄像头追踪进展。",
        "target_customers": "下颌疼痛、磨牙症及颞下颌关节紧张患者",
        "features": [
          "物理治疗师设计的循证训练",
          "根据初始评估、每日反馈和症状持续调整训练计划",
          "通过智能手机摄像头测量进展",
          "生成可导出的医疗报告供牙医、医生或物理治疗师使用",
          "依据EU MDR注册为Class I医疗器械"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-5a11f19d8df5938f",
            "quote": "guides patients through a personalised self-therapy programme at home and measures progress via the smartphone camera",
            "source_content_hash": "99fe08fbcdf78fd9900b44e1365a62c93e81ba8a00b733435709221b0628c03c",
            "quote_hash": "fa5fa217382ec3d7b63cb13809f35be1dc7f2e2052a317cd310edff2f632df91"
          },
          {
            "source_id": "FISRC-5a11f19d8df5938f",
            "quote": "It also generates exportable medical reports that users can share with their dentist, doctor, or physiotherapist to support treatment.",
            "source_content_hash": "99fe08fbcdf78fd9900b44e1365a62c93e81ba8a00b733435709221b0628c03c",
            "quote_hash": "adb8012da44313f26a0d708b4b6e45e023997fd80d6c6cdf0d5faa05e592835d"
          },
          {
            "source_id": "FISRC-5a11f19d8df5938f",
            "quote": "The app is registered as a Class I medical device under the EU MDR and complements dental care.",
            "source_content_hash": "99fe08fbcdf78fd9900b44e1365a62c93e81ba8a00b733435709221b0628c03c",
            "quote_hash": "fd3dbde29c4875d6c05b84b95f5c1c2bea331cb9489f48dab031377b6b204603"
          }
        ],
        "entity_id": null
      }
