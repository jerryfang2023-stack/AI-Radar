    "quotes": [
      {
        "speaker": "Dr. Claudio Consul",
        "quote": "Freight is one of the world’s largest industries, and digitalisation has transformed large parts of it. But the industry is full of edge cases and decisions that depend on context, which has made true end-to-end automation difficult with traditional software. AI changes that.",
        "evidence_refs": [
          {
