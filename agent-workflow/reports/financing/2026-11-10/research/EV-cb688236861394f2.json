    "products": [
      {
        "name": "Nominal硬件智能平台",
        "description": "连接遥测、视频、日志与文件等硬件测试数据，并保留工程上下文，支持实时分析、协作与可追溯决策。",
        "target_customers": "航空航天、国防、机器人、能源和先进制造领域的工程团队",
        "features": [
          "遥测、视频、日志和文件统一采集与存储",
          "时间序列、视频、音频和表格对齐到同一时间线",
          "实时监控、趋势跟踪与可共享报告",
          "支持云端、本地、气隙和边缘部署"
        ],
        "evidence_refs": [
          {
