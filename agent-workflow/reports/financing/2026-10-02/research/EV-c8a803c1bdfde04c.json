    "products": [
      {
        "name": "Deepslate Opal",
        "description": "Deepslate 开发的原生语音到语音模型，直接处理语音输入并生成语音输出，无需单独的 STT、LLM 或 TTS 组件，支持 27 种语言，延迟 440 毫秒，托管在欧盟境内。",
        "target_customers": "面向语音代理、应用和平台的开发者，以及联络中心、保险公司和运行数百万分钟语音的平台。",
        "features": [
          "原生语音到语音处理，无需 STT、LLM、TTS 分离组件",
          "440 毫秒延迟",
          "支持 27 种语言",
          "欧盟境内托管，GDPR 合规，ISO 27001 认证",
          "支持自托管和隔离环境部署",
          "提供 LiveKit、Pipecat、Python、Node SDK、WebSocket、WebRTC、SIP 集成"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-11d05d552811b9ac",
            "quote": "Deepslate is a native speech-to-speech voice AI model built in Europe. It listens, reasons and responds in 27 languages with 440 ms latency, hosted in the EU.",
