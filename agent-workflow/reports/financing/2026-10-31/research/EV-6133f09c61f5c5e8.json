    "products": [
      {
        "name": "Ares AI访谈平台",
        "description": "部署AI访谈员，以70多种语言与组织内每位员工进行保密语音对话，数周内向管理层交付按优先级排序、基于证据的AI采用路线图。",
        "target_customers": "欧洲和美国的制造、汽车、私募股权等行业企业",
        "features": [
          "AI语音访谈员，支持70多种语言",
          "保密对话与匿名化控制（隐去姓名、遮蔽声音、剥离角色元数据）",
          "符合GDPR和SOC 2",
          "可部署在客户自有云或Ares的欧盟/美国基础设施",
          "企业可设定数据保留窗口"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-136361268f61dfb3",
            "quote": "The platform deploys an AI interviewer that holds confidential, voice-based conversations with every employee in an organisation, in more than 70 languages.",
            "source_content_hash": "02c2a5695376e72fa47fb1ba4010e5d45a2c296a1c07c7e45e43d22116a52229",
            "quote_hash": "4cc14ddfad3f38e14542365da5724a7d7a01d95756a7546c3b92133a1affb72f"
          },
          {
            "source_id": "FISRC-136361268f61dfb3",
            "quote": "Ares’ platform is GDPR- and SOC 2-compliant, with anonymisation controls that let businesses mask names, redact voices, or strip role metadata before reports reach leadership.",
            "source_content_hash": "02c2a5695376e72fa47fb1ba4010e5d45a2c296a1c07c7e45e43d22116a52229",
            "quote_hash": "6dc9c8e083edd649269894b2e06aeadb864346ebc0139e34669602d32c6fb99e"
          }
        ],
        "entity_id": null
      }
    ],
