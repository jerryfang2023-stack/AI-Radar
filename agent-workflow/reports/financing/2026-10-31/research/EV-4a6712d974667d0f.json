    "products": [
      {
        "name": "VUSE XR Hub",
        "description": "企业软件平台，将现有CAD模型、工程数据和产品文档转换为逼真的3D模型，用户可通过AI辅助工具或拖拽功能编排交互式培训序列，并在浏览器、移动设备或XR头显上分发培训，结果集中追踪，内容可随时更新和重新部署。",
        "target_customers": "工业与生命科学企业",
        "features": [
          "将CAD模型、工程数据和产品文档转换为逼真3D模型",
          "AI辅助工具或拖拽式交互培训编排",
          "通过浏览器、移动设备或XR头显交付培训",
          "集中追踪培训结果",
          "内容可跨组织更新和重新部署"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-6ecc4ec7180547da",
            "quote": "The VUSE XR Hub works by converting existing CAD models, engineering data and product documentation into photorealistic 3D models, which users can then arrange into interactive training sequences using AI-assisted tools or drag-and-drop functionality.",
            "source_content_hash": "56236d74743318070c61480368d0f7675c39e1f908c62c5b4065508261e0cc62",
            "quote_hash": "963081a4def9f6cc81490d55b2ae8787a82c29c46f465f7f800dd29840b70e2f"
          },
          {
            "source_id": "FISRC-6ecc4ec7180547da",
            "quote": "training can be delivered via a web browser, mobile devices, or fully immersive XR headsets such as Meta Quest. The results are tracked centrally, and content can be updated and redeployed across an organisation at any time.",
            "source_content_hash": "56236d74743318070c61480368d0f7675c39e1f908c62c5b4065508261e0cc62",
            "quote_hash": "43e6c7cc9dc7afc46d86c2847078a1e7aa69479ba8f7e2ee6e92a394afd350ea"
