            "quote_hash": "60054ad2fdf5c4e1126d6cac798b2855eed22d0e645331e5d59c2680cffe9961"
          },
          {
            "source_id": "FISRC-cf38198e12772dce",
            "quote": "Vinci operates zero-shot across new designs without customer-specific training or fine-tuning.",
