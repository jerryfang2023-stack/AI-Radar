    "products": [
      {
        "name": "Autentic AI 市场研究平台",
        "description": "AI驱动的定性市场研究平台，部署对话式AI代理进行真实语音或产品内访谈，自动完成转录、主题分析、情绪检测、引文提取和洞察综合，并由人工研究员解读发现。",
        "target_customers": "消费品品牌、咨询公司、投资者、产品团队",
        "features": [
          "对话式AI代理进行语音或视频访谈并自适应追问",
          "自动分析：转录、主题分析、情绪检测、引文提取、洞察综合",
          "平台内自有筛选过的消费者与行业专家小组",
          "可并行运行数百场访谈，支持40多种语言",
          "符合GDPR、SOC 2 Type II、ISO 27001等企业级安全标准"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-110fcb07b7a71e99",
            "quote": "Autentic AI is an AI-powered qualitative research platform that helps teams collect deep customer insights at scale. By deploying conversational AI agents to conduct real voice or in-product conversations, the platform replaces manual qualitative workflows with AI-moderated interviews and automated insight synthesis.",
