    "products": [
      {
        "name": "Jev",
        "description": "Jev 是 TypeSafe AI 的首个 System One 模型，面向软件自动化场景，接收类型化问题并基于给定状态返回结构化决策结果，不生成或解析文本。输出为带概率分布的类型化值，代码可直接用于分支、排序和路由。",
        "target_customers": "财富 500 强企业、开发者、软件系统",
        "features": [
          "三种原语：Choice 从给定列表中选择一项；Score 按评分标准对状态评分；Noul 返回给定陈述为真的 0–1 概率",
          "Choice 和 Score 返回置信度值，三种问题类型可在一次 API 调用中组合",
          "端到端响应时间 70 至 500 毫秒",
          "定价为每百万输入 token 0.042 美元，输出 token 免费",
          "输出为预先定义的类型安全结构化值，模型不会产生类型错误且无法幻觉"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-0e76615878e34cb3",
            "quote": "Jev takes typed questions and evaluates them against a supplied state, returning structured results without generating or parsing text.",
            "source_content_hash": "b3fc50f20c3de21a",
            "quote_hash": "4236dd1536c4fbf3c75da7660f9eb5b25bf919e06f7f2fdd875a51aa2d909b45"
          },
          {
            "source_id": "FISRC-0e76615878e34cb3",
            "quote": "The company exposes three primitives: Choice picks one option out of a provided list; Score grades the state against a rubric; and Noul returns a 0–1 answer to whether a given statement is true.",
            "source_content_hash": "b3fc50f20c3de21a",
            "quote_hash": "32cfabc77d083af7cc49d5db0cc4fabc8267ef2fdd6be8469536421d627045c3"
          },
          {
            "source_id": "FISRC-0e76615878e34cb3",
            "quote": "Published pricing is $0.042 per million input tokens, with output tokens free.",
            "source_content_hash": "b3fc50f20c3de21a",
            "quote_hash": "4c5a500c5519dcb5a9b048a921e123c7390b07219c5700ac0a23937c28733e44"
          }
        ],
