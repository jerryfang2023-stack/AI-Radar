    "products": [
      {
        "name": "Klarent",
        "description": "企业级AI软件测试平台，通过多智能体系统实现自主化质量保证测试，覆盖Web、iOS和Android应用。",
        "target_customers": "企业级工程与QA团队，覆盖媒体、电商、SaaS、银行、保险、旅游等行业。",
        "features": [
          "多智能体系统（Explorer、Planner、Coder、Verifier、Runner、Notifier）",
          "确定性自主：LLM仅用于编写测试代码，测试执行确定性可重复",
          "人工在环验证层",
          "自愈测试",
          "CI/CD集成",
          "支持云、私有云或本地部署",
          "SOC 2合规、ISO 27001认证"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-1f26571d6981733f",
            "quote": "Instead of leaning on large language models to run tests directly, Klarent’s agents use LLMs only to author test code. Once written, the test code executes in a deterministic, repeatable manner, combining the adaptability of AI with the rigour expected in production engineering.",
            "source_content_hash": "7018e7f6eff743a6e2868eaef34ee07f4311388ca318103f18c602e78f804de0",
            "quote_hash": "9901cd51e0250f7e3a3494edd1f8db58f2006f57cd183a040eeaf715bbc6c090"
          },
          {
            "source_id": "FISRC-07bbad4e1419e0e6",
            "quote": "Klarent is an AI test automation company. We build an AI-powered software testing platform that lets enterprise teams automate the entire testing lifecycle with autonomous AI agents, across web, iOS, and Android applications.",
            "source_content_hash": "05e56479e45c08be",
            "quote_hash": "3fc952346a889af6a7f65721e9accaa907ff3f221ea36a49890de427f7959ebd"
          }
        ],
        "entity_id": null
      }
    ],
