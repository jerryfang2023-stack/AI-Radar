    "products": [
      {
        "name": "AI Virtual Cell (AIVC)",
        "description": "一个世界模型，旨在预测人类细胞在体外对药物或基因变化的反应，减少物理湿实验室实验的需求。",
        "target_customers": "制药和生物技术公司、研究机构",
        "features": [
          "预测细胞对药物和基因变化的反应",
          "基于多模态、时间分辨的单细胞数据训练",
          "跨疾病适应症（肿瘤学、免疫学、罕见病、心血管代谢疾病）"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-75b750c64b12ceb9",
            "quote": "AIVC is a world model designed to predict how human cells respond to a drug or genetic change in silico, reducing the overall need for physical wet-lab experiments significantly.",
            "source_content_hash": "6858a34647e259de",
            "quote_hash": "eddc15c4f6b0eec51004aeb0767d54307bd7c16ea51e97e5866792e94af2fa9b"
          },
          {
            "source_id": "FISRC-97c1450f87294e7e",
            "quote": "Those datasets will train its “virtual cell”: a model intended to simulate how cells respond to treatments before researchers test them physically.",
            "source_content_hash": "621f9441414320b4",
            "quote_hash": "0042b54619ad0c1e54c48fe99ec4de1147f4bcc3db01224ca6832eb664db2840"
          }
        ],
        "entity_id": null
      },
      {
        "name": "专有数据生成平台",
        "description": "一个专有的内部平台，能够大规模生成干预性、时间分辨、多模态的单细胞数据，用于预训练AI世界模型。",
        "target_customers": "内部使用，用于训练AI模型",
        "features": [
