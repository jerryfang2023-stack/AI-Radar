    "products": [
      {
        "name": "Field Foundation Models (FFMs)",
        "description": "一类专为具身智能构建的“物理优先”基础模型，从底层设计以应对不确定性、风险和现实世界的物理约束，使机器人无需地图、GPS或预定义路径即可在动态、非结构化环境中安全可靠地自主运行。",
        "target_customers": "建筑公司、数据中心运营商、国防企业，以及能源、制造、城市配送和巡检等行业客户",
        "features": [
          "硬件无关设计，同一核心智能可驱动四足机器人、人形机器人、轮式机器人和乘用车级车辆",
          "无需重新编程即可安全动态适应新条件和意外情况",
          "在边缘端由模型直接实时自主决策"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-51ce1e151d0b9865",
            "quote": "At the core of FieldAI’s platform are Field Foundation Models (FFMs): a new class of “physics-first” foundation models built specifically for embodied intelligence.",
