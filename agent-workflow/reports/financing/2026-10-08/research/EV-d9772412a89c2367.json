    "products": [
      {
        "name": "TensorBench",
        "description": "开源AI硬件基准，对硬件施加不同负载并记录功耗、发热、持续性能与恢复情况，将物理响应与满足服务要求的请求比例、每个被接受输出token的能耗及成本关联起来。",
        "target_customers": "数据中心运营商、GPU云、推理服务商、企业与研究基础设施团队",
        "features": [
          "开源基准",
          "记录功耗、温度、时钟与恢复",
          "估算每百万token成本",
          "支持受控变更后的重复测试"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-678ad07c7dcec106",
            "quote": "Tensor's benchmark recipe applies different loads and records how hardware draws power, heats up, sustains performance and recovers.",
            "source_content_hash": "1563c5ece20b6c66",
            "quote_hash": "e3a160d78684830f11d964eb75c4d1fa7b2e18426c3285888977b02c8e737a4f"
          },
          {
            "source_id": "FISRC-8a18c4c6e359c45b",
            "quote": "TensorBench records GPU and server telemetry across baseline, load, cooldown, and recovery.",
            "source_content_hash": "00753134a4d8e3fa",
            "quote_hash": "58a64c695f2c7bb7205d478b850490a8ef0eec4f76f2a235e313f282342b91a4"
          }
        ],
        "entity_id": null
      },
      {
        "name": "物理信息模型",
        "description": "专有物理模型，分析功耗、热量、性能与硬件退化之间的关系，用于估计每块GPU的性能包络并指导频率、功耗、冷却与工作负载放置决策。",
        "target_customers": "裸金属提供商与新型云设计合作伙伴（私有测试阶段）",
        "features": [
          "物理信息建模",
          "预测性能包络",
          "支持配置与放置决策"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-678ad07c7dcec106",
            "quote": "Tensor Machines' proprietary physics-based models support this work by analyzing the relationships between power, heat, performance and hardware degradation.",
            "source_content_hash": "1563c5ece20b6c66",
            "quote_hash": "ce39ec874e4b27abb5f0c24220065543e5438c212b46fa6928948d10bab718b7"
          },
          {
            "source_id": "FISRC-8a18c4c6e359c45b",
            "quote": "The goal is to estimate the performance envelope of each GPU: the throughput, latency, energy, and thermal outcomes it can attain for a workload as operating conditions change.",
            "source_content_hash": "00753134a4d8e3fa",
            "quote_hash": "821bf5f5f3a4ed96e54a6fd61c6d103f5081ff936949565b951fc195cfc148e1"
          }
        ],
        "entity_id": null
      }
    ],
