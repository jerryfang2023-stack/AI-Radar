    "quotes": [
      {
        "speaker": "Réza Malekzadeh",
        "quote": "Managed services have always scaled with headcount. Netsec breaks that link, pairing a single operator with automation that absorbs the volume work. The team at Netsec has the operating depth to make the model hold as it grows. That is a rare combination and we are pleased to join the founders in their journey.",
        "evidence_refs": [
          {
            "source_id": "FISRC-429ccc47b81019aa",
            "quote": "“Managed services have always scaled with headcount. Netsec breaks that link, pairing a single operator with automation that absorbs the volume work. The team at Netsec has the operating depth to make the model hold as it grows. That is a rare combination and we are pleased to join the founders in their journey,” said Réza Malekzadeh, General Partner, Partech.",
