    "products": [
      {
        "name": "Healthleap AI 住院患者风险筛查平台",
        "description": "该平台接入医院电子健康记录系统，使用语言模型从临床医生书面笔记中提取信息，结合实验室报告和生命体征等结构化数据，输入风险模型，每天夜间分析每位成年住院患者的记录，次日早晨将风险评分写入护理团队现有工作流。软件不诊断患者，仅标记需要进一步查看的项目。",
        "target_customers": "医院、护理团队、营养师",
        "features": [
          "接入电子健康记录系统",
          "使用语言模型提取临床笔记信号",
          "每日夜间分析每位成年住院患者记录",
          "次日早晨将风险评分写入护理团队工作流",
          "不诊断患者，仅标记需进一步查看的项目"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-576f8703e59d7c0a",
            "quote": "Healthleap plugs into a hospital’s electronic health record system and uses language models to pull information from written notes",
            "source_content_hash": "dd3f508c26a35a9ea3719adeef20176779a1b8e6ff16bdd776eb136e375ecdf5",
            "quote_hash": "701b276e49d19fbb99ccb4501e93adc545f66ff1af23478a8d4437b5390447de"
          },
          {
            "source_id": "FISRC-576f8703e59d7c0a",
            "quote": "Each night, we analyze every adult inpatient’s record",
