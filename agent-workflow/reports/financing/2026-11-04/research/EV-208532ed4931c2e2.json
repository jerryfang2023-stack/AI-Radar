    "products": [
      {
        "name": "Marble Coworkers",
        "description": "AI智能体，观察团队工作方式，将每个流程转化为AI可读的结构化地图，并在团队现有工具中端到端执行流程，在需要判断处保留人工介入。",
        "target_customers": "企业团队，包括技术独角兽、PE支持的组织和AI roll-ups",
        "features": [
          "观察团队工作并将流程转化为结构化地图",
          "在现有工具中端到端运行流程",
          "在需要判断处保留人工介入",
          "桌面应用记录屏幕活动、点击和按键，仅限工作应用与工作时间",
          "捕获数据在任何人或AI模型看到前匿名化"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-e4d48c3df0a25149",
            "quote": "It observes how teams work, turning every process into a structured map that AI can read like code. It then builds Marble Coworkers that run the process end to end in the tools teams already use, with humans in the loop where judgement matters.",
