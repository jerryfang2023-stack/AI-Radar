    "products": [
      {
        "name": "Trajectory后训练平台",
        "description": "企业可从开源模型起步，把平台接入自身应用以收集模型表现反馈，Trajectory据此重训模型，使其在专业任务上随时间改进。",
        "target_customers": "需要把通用模型适配到法律、金融等专业领域的AI原生公司及行业专家团队",
        "features": [
          "接入应用收集真实使用反馈",
          "基于反馈持续重训开源模型",
          "面向非技术专家的后训练界面"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-c8564f3a68709075",
            "quote": "Businesses using Trajectory can start with an open source AI model and connect the platform to their applications, allowing it to collect feedback on how the model performs. Trajectory then uses that information to retrain the model, helping it improve at specialized tasks over time.",
            "source_content_hash": "1d679eb607fa321ec07a4522df60180cf9e512ca31af4ede53b3fc82e62b8776",
            "quote_hash": "8defdeec6b75fb97b6e8780590658ce36e106d95773a3d0d4a42f085c7c20918"
          },
          {
            "source_id": "FISRC-c8564f3a68709075",
            "quote": "Karanam says the startup has developed an interface that makes post-training more accessible to its nontechnical customers.",
            "source_content_hash": "1d679eb607fa321ec07a4522df60180cf9e512ca31af4ede53b3fc82e62b8776",
            "quote_hash": "705fe34dd7386bb90078659aa9ef728c13a5f53c0a607e41d6e6aeb1faefa6f2"
          }
        ],
        "entity_id": null
      }
