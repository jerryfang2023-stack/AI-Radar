    "products": [
      {
        "name": "Othello",
        "description": "实时 AI 销售辅导平台，在通话中通过桌面应用叠加显示实时建议和会议提示，帮助销售代表在买家仍在通话时调整策略。",
        "target_customers": "大型企业销售团队",
        "features": [
          "基于专有模型 Hamlet，在 500 毫秒内提供实时建议",
          "桌面应用在通话开始时启动，在任何在线会议中显示实时弹窗，不以参与者身份加入",
          "提供实时建议和会议提示，包括下一个发现性问题、遗漏的 MEDDPICC/Challenger/playbook 步骤、如何回答产品和技术问题、如何处理异议、如何脱颖而出、分享哪个案例研究、买家何时准备推进",
          "与 Google Workspace、Salesforce、Slack 和 ServiceNow 等业务软件平台集成",
          "客户数据不用于训练与其他企业共享的 AI 模型"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-a6e1e76d3e6bb0dc",
            "quote": "Othello runs on Hamlet, a proprietary model built for live sales calls. A desktop app starts when a call begins and shows live pop-ups in any online meeting, without joining as a participant.",
            "source_content_hash": "c18df6763da17100e551d4d546c4e6b8c78f71eee89b64bcd7b5029c3600b3e4",
            "quote_hash": "2a5d2407e488ef10e52ef5e7bc2b1770e1c2b6ba0aeabbaff2ed0abb98a3d6a6"
          },
          {
            "source_id": "FISRC-6667915df1c0d6a4",
            "quote": "Othello listens in on video calls and uses AI trained on a company's uploaded sales and product materials to suggest questions to ask, answer tricky queries, and flag missed opportunities in real time through an on-screen overlay.",
            "source_content_hash": "aca27b3ee09129ef",
            "quote_hash": "b63c2ad7cad9064bda0d0a903ddb6af532bec125d47d57d8e435a01c006b1427"
          }
        ],
