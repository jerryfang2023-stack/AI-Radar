    "products": [
      {
        "name": "North v3",
        "description": "North 的平台版本，将云、AI 和数据支出纳入单一系统，覆盖 AWS、GCP 和 Microsoft Azure 三大超大规模云厂商，并原生集成 OpenAI、Anthropic 和 Snowflake。",
        "target_customers": "财务与工程团队",
        "features": [
          "覆盖 AWS、GCP、Azure 三大超大规模云厂商",
          "原生集成 OpenAI、Anthropic 和 Snowflake",
          "扩展 Autobot 自动化承诺阶梯引擎"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-d44602a17801a99d",
            "quote": "The financing follows the launch of North v3, which expanded the platform to Microsoft Azure, completing coverage across all three major hyperscalers. The release also introduced native integrations with OpenAI, Anthropic, and Snowflake, and extended Autobot, North's automated commitment laddering engine.",
            "source_content_hash": "1cd50eb9dd50f4d5d0618d28986ba1cb1b7b48f131e77dc028ca7e63a8a2f582",
            "quote_hash": "1aca876accee093ef1679439949834b3c420db087dfe9d2080409b56265fcd47"
          }
        ],
        "entity_id": null
      },
      {
        "name": "TokenFlow",
        "description": "将模型使用量、归因、预算和财务控制带入企业用于管理云基础设施的同一系统，反映 North 认为云与 AI 支出正成为同一财务问题的观点。",
        "target_customers": "管理 AI 支出的企业团队",
        "features": [
          "跟踪跨模型、提供商和团队的使用量",
          "将成本归因到产生成本的工作负载",
          "应用限制或策略以控制使用量"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-d44602a17801a99d",
            "quote": "TokenFlow brings model usage, attribution, budgets, and financial controls into the same system companies use to manage cloud infrastructure",
            "source_content_hash": "1cd50eb9dd50f4d5d0618d28986ba1cb1b7b48f131e77dc028ca7e63a8a2f582",
            "quote_hash": "6296d07574b8d71bd113bd34d7ac92f1c0277b617618c0d7841be361b910c987"
          },
          {
            "source_id": "FISRC-bc0306d2f5b2b0be",
            "quote": "The TokenFlow product page describes tracking usage across models, providers, and teams, assigning costs to the workloads that generate them, and applying limits or policies to cap usage.",
            "source_content_hash": "8f2406c82f213f5d",
            "quote_hash": "0fbe518d23a1e8b1bcd493ffaa9d74804e7b189916254c89ce2570193a08fc14"
          }
        ],
        "entity_id": null
      },
      {
        "name": "Autobot",
        "description": "North 的自动化承诺阶梯引擎，管理客户拥有的承诺，根据使用量和业务目标逐步做出购买决策，并提供模拟能力以在购买前评估节省和灵活性。",
        "target_customers": "需要管理云承诺购买的工程与财务团队",
        "features": [
          "管理客户拥有的承诺",
          "根据使用量和业务目标逐步做出购买决策",
