    "quotes": [
      {
        "speaker": "Mathias Ockenfels",
        "quote": "We are backing Ambio not only because of the talented team led by Tommi and Elmo but also because of the compounding competitive moat the business is built on: a proprietary dataset on recyclate quality, a principal model that builds trust with buyers and sellers, and an agentic engine that turns every transaction and quality data point into improved matchmaking. We are convinced that Ambio will become the central marketplace for recycled plastics in Europe and beyond",
        "evidence_refs": [
          {
            "source_id": "FISRC-3ffe20a27f770579",
            "quote": "We are backing Ambio not only because of the talented team led by Tommi and Elmo but also because of the compounding competitive moat the business is built on: a proprietary dataset on recyclate quality, a principal model that builds trust with buyers and sellers, and an agentic engine that turns every transaction and quality data point into improved matchmaking. We are convinced that Ambio will become the central marketplace for recycled plastics in Europe and beyond",
