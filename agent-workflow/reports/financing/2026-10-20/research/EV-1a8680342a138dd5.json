    "products": [
      {
        "name": "AI原生再生塑料端到端采购平台",
        "description": "覆盖从材料发现、取样、质量验证到长期交付的完整采购周期，通过结构化质量数据和匹配引擎让再生塑料采购更可预测。",
        "target_customers": "欧洲工业买家",
        "features": [
          "材料经样品、文档和既定质量协议进行资格认定",
          "匹配引擎从每笔交易中学习材料、供应商、价格与结果数据",
          "作为单一责任供应方承担材料所有权、交易融资与质量保证"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-3ffe20a27f770579",
