    "products": [
      {
        "name": "reebuild AI原生后台自动化平台",
        "description": "垂直AI平台，逐行读取PDF、照片、扫描件和电子发票等商业文档，将其转换为结构化数据，并自动化发票审核、成本管理和材料跟踪。送货单、发票和订单确认自动匹配，软件从商务经理的决策中逐步学习，减少重复性行政工作量。",
        "target_customers": "建筑公司和房地产开发商",
        "features": [
          "逐行读取PDF、照片、扫描件和电子发票并转换为结构化数据",
          "自动匹配送货单、发票和订单确认",
          "自动化发票审核、成本管理和材料跟踪",
          "从商务经理决策中逐步学习",
          "移动应用支持现场工长拍照上传送货单",
          "AI agents准备工作、标记重复任务并推荐下一步行动"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-758e0c3d0da748e7",
            "quote": "reebuild operates as a vertical AI platform that reads every incoming document line by line, whether a PDF, photo, scan, or e-invoice, and converts it into structured data and automates invoice review, cost management, and material tracking.",
