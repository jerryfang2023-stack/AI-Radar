    "products": [
      {
        "name": "Jenz AI coworker platform",
        "description": "面向电商团队的AI同事平台，可通过Slack访问，能检索店铺数据、运行分析、生成报告和文件、编写并执行代码、构建小型Web应用并自动化重复工作流。",
        "target_customers": "电商与零售团队",
        "features": [
          "通过Slack访问",
          "检索店铺数据",
          "运行分析",
          "生成报告和文件",
          "编写并执行代码",
          "构建小型Web应用",
          "自动化重复工作流"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-01eb801f31065932",
            "quote": "Jenz is an AI coworker for e-commerce teams, accessible via Slack. It can retrieve store data, run analysis, generate reports and files, write and execute code, build small web applications, and automate recurring workflows.",
            "source_content_hash": "fb75562d3fc3a5b8",
            "quote_hash": "578b80012a9ff7384227db2dbf12ea5eaff6bc13286630b39dd91b9dcdd0103f"
          }
        ],
        "entity_id": null
      },
      {
        "name": "零售数据整合与自动化平台",
        "description": "连接零售商多个业务系统的数据，让AI代理分析信息并处理日常事务，涉及花钱的操作需先获得批准。",
        "target_customers": "零售商",
        "features": [
          "连接webshop、POS、库存、会计和营销系统",
          "统一数据层",
          "AI代理分析",
          "执行前审批"
        ],
        "evidence_refs": [
          {
