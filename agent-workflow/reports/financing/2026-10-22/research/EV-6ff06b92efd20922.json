    "products": [
      {
        "name": "Plinto AI代理财务管控平台",
        "description": "Plinto的AI代理运行在企业现有ERP、银行、文档和协作工具之上，持续核对交易与合同、预算及内部规则是否一致；发现偏差后进行调查、收集证据并跟进处理。",
        "target_customers": "企业财务团队、CFO",
        "features": [
          "持续核对交易与合同、预算和内部规则",
          "发现偏差后自动调查并收集证据",
          "直接联系供应商或客户跟进处理",
          "从对话中学习并应用到未来交易",
          "集成Microsoft Business Central、Xero、Visma等ERP及2,700多家银行"
        ],
