        "features": [
          "AI 智能体自动执行采购与寻源",
          "核验合规文件并跟踪采购订单",
          "代品牌向供应商付款，品牌需在 90 天内还款",
          "结合供应商网络与市场数据比较价格和交期"
        ],
        "evidence_refs": [
          {
