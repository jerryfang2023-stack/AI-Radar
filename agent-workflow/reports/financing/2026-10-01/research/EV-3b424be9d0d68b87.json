    "products": [
      {
        "name": "Dazzle",
        "description": "Dazzle是一款个人AI助手，通过分析用户手机相册中的照片来理解用户的爱好、兴趣、饮食和风格偏好，并提供即时任务处理和个性化建议。用户可以通过应用或短信与Dazzle互动。",
        "target_customers": "消费者用户",
        "features": [
          "从相机胶卷获取全部上下文",
          "扫描近期照片提取细节，如从活动传单填充日历",
          "挖掘照片库生成个性化建议，如假期推荐和生日礼物",
          "通过应用或短信互动",
          "优先隐私，丢弃AI标记为敏感的个人信息"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-5b7f912406e2d494",
            "quote": "Dazzle’s AI assistant gets all its context from a single source: your camera roll.",
            "source_content_hash": "24982ae6f5cbe54bbeff882a9983b83e898785c57a6ea4dabcf95f769bf7a13c",
            "quote_hash": "72c06c104e2428e4b0a29adabe9de124b93144ddb24936c43345bd3d3c9cd3e1"
          },
          {
            "source_id": "FISRC-5b7f912406e2d494",
            "quote": "For immediate tasks, it can scan recent photos to pull details — like populating your calendar from an event flyer, or finding a repair person after spotting a broken garage door in your camera roll.",
            "source_content_hash": "24982ae6f5cbe54bbeff882a9983b83e898785c57a6ea4dabcf95f769bf7a13c",
            "quote_hash": "5f0175427fccf81d4518f516b8fb72d1a8bf7e2719954ea14cf15092213d04f0"
          },
          {
            "source_id": "FISRC-5b7f912406e2d494",
            "quote": "Second, it mines your photo library to come up with personalized ideas for everything from holiday vacations to birthday gifts.",
            "source_content_hash": "24982ae6f5cbe54bbeff882a9983b83e898785c57a6ea4dabcf95f769bf7a13c",
            "quote_hash": "ecc9218a75db5d6992f43b6ff648f4e18778ec809e30101ff6362da3bb50a630"
          }
        ],
        "entity_id": null
      }
