    "comparisons": [
      {
        "name": "Temporal",
        "product": "Temporal 持久执行平台",
        "scenario": "持久工作流和分布式应用编排",
        "target_customer": "需要持久执行基础设施的企业开发者",
        "funding_summary": "Temporal 于 2026 年 9 月宣布完成 5.5 亿美元 E 轮融资，估值 125.5 亿美元",
        "core_difference": "Temporal 以工作流和活动为中心的应用模型，而 Restate 通过可组合的服务、工作流、键控状态、RPC、消息和队列使整个系统持久化；Restate 以单二进制运行且无需外部数据库，而 Temporal 需要外部数据库支撑。",
        "evidence_refs": [
          {
            "source_id": "FISRC-32de5b12bdde4fb9",
            "quote": "The fresh capital will help Restate take on Temporal, the heavyweight in the durable infrastructure space. Temporal, which was founded in 2019, announced a $550 million Series E at a $12.55 billion valuation earlier this month.",
            "source_content_hash": "ce24b87fe266c679159d33ab6c8259293300502d15d5bad088c96b5066cd55da",
            "quote_hash": "47f29627135e000552bead6303b643349f5cd428364dbab59e0c389c01cb1ce8"
          },
          {
            "source_id": "FISRC-b724e942c54b0962",
            "quote": "Temporal centers the application model on workflows and activities; Restate makes the wider system durable through composable services, workflows, keyed state, RPC, messaging, and queues. Restate also runs as a self-contained binary without an external database, while your services remain ordinary applications that can run on servers, containers, or serverless platforms.",
            "source_content_hash": "5c127cd6441e9873",
            "quote_hash": "1a4c89fa303ca47b993ffed00d897db64998ebc3e6f043cc3252ba6fb160346d"
          }
        ],
        "entity_id": null
      }
    ],
