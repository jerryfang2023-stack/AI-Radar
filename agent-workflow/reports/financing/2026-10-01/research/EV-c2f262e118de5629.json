    "products": [
      {
        "name": "Restate",
        "description": "Restate 是一个持久执行运行时（durable execution runtime），提供 Durable Execution、Virtual Objects、Durable Promises/Futures 等构建块，使开发者能够以普通应用代码构建具备弹性的服务、工作流和 AI 智能体，并在故障后自动恢复。",
        "target_customers": "开发者、AI 公司、企业客户（包括财富 500 强企业）",
        "features": [
          "Durable Execution（workflow-as-code）",
          "Virtual Objects 状态管理",
          "Durable Promises/Futures 弹性通信",
          "单二进制部署，无需外部数据库",
          "支持 TypeScript、Python、Java、Kotlin、Go、Rust、Ruby SDK",
          "与 AWS Lambda、Cloudflare Workers 等 FaaS 平台互操作"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-897ee0f062e50b23",
            "quote": "Restate takes the guesswork out of building distributed applications. Core to the system is a unique take on workflows-as-code (also called Durable Execution) implemented on a specialized event log",
            "source_content_hash": "01508a456a92b8fc",
            "quote_hash": "f0f38c93f818322a89e9e5d1f466a5099a9b61eb962692184f73b0c89cc2082e"
          },
          {
            "source_id": "FISRC-b724e942c54b0962",
            "quote": "Restate is a durable execution runtime for building resilient services, workflows, and AI agents.",
            "source_content_hash": "5c127cd6441e9873",
            "quote_hash": "95387673bdb454622f4d1ac9aff0f068c423f286ea95db5260f400fe008629d0"
          }
        ],
        "entity_id": null
      },
      {
        "name": "Restate Cloud",
        "description": "Restate Cloud 是 Restate 的全托管无服务器产品，用户无需管理集群、分区或队列，即可创建 Restate 环境并连接应用。",
        "target_customers": "希望免运维使用 Restate 的开发者与团队",
        "features": [
          "全托管无服务器",
          "免费层支持两个环境",
          "SOC 2 合规、企业 SSO、RBAC、客户端加密、HIPAA 支持"
        ],
        "evidence_refs": [
          {
