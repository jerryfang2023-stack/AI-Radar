    "products": [
      {
        "name": "EDEN",
        "description": "EDEN是Basecamp Research的生物基础模型，基于Trillion Gene Atlas训练，旨在提供对DNA在所有生命中如何运作的通用理解，能够直接从疾病信息生成潜在治疗候选物，能力包括设计细胞和基因疗法、酶和肽。",
        "target_customers": "制药和生物技术公司，以及内部治疗管线开发",
        "features": [
          "设计细胞和基因疗法",
          "设计酶和肽",
          "设计长且复杂的DNA序列",
          "抗生素设计和抗原免疫原性预测（通过Claude提供）"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-ecd2ea74974f4ff3",
            "quote": "EDEN models aim to deliver a universal understanding of how DNA works across all of life. This means that the models can generate potential therapeutic candidates directly from information about a disease",
            "source_content_hash": "e53f1e2c96a09a59b3d2c0250baa37098aa57f90132cd42ed81a40d86422cf50",
            "quote_hash": "3968b26f9d57eb7130fe9f51624b8751dc971f949ecb4474a50db08dcd1bbb10"
          }
        ],
        "entity_id": null
      },
      {
        "name": "Trillion Gene Atlas",
        "description": "世界上最大的专有生物AI训练数据集，通过与NVIDIA、Anthropic、PacBio和Ultima Genomics合作构建，数据来自30多个国家、七大洲的获取与惠益分享伙伴关系。",
        "target_customers": "内部模型训练和药物发现",
        "features": [
          "超过1000亿个新基因",
          "超过100T tokens",
          "覆盖七大洲30多个国家"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-ecd2ea74974f4ff3",
            "quote": "At the centre of Basecamp Research's AI platform is the Trillion Gene Atlas, the world's largest proprietary biological AI training dataset.",
            "source_content_hash": "e53f1e2c96a09a59b3d2c0250baa37098aa57f90132cd42ed81a40d86422cf50",
            "quote_hash": "746fff1c700cf55d49518e90965ed310a928e4728f5fa26afc7d559011280674"
          },
          {
            "source_id": "FISRC-308a00ce9ed1e503",
            "quote": "Over 100 billion novel genes discovered from across all 7 continents. At over 100T tokens, this is the largest biological AI training dataset created to date.",
            "source_content_hash": "9bf6b132c4c3f4bf",
            "quote_hash": "b431eea6d2f28d3d694ebdfbb5f2486c9b16746a7aaff6c18dba748cc083ad27"
          }
        ],
        "entity_id": null
      },
      {
        "name": "aiPGI™",
        "description": "基因插入平台，EDEN设计重组酶（LSR），可在安全、可预测且明确的基因组位点插入长且复杂的DNA载荷，无需双链断裂，可通过LNP和/或AAV在体内递送。",
        "target_customers": "内部治疗管线及潜在合作伙伴",
        "features": [
          "设计可插入长复杂DNA载荷的重组酶",
          "无双链断裂",
          "可通过LNP和/或AAV体内递送"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-5bbedbc77c74b158",
            "quote": "Gene insertion (aiPGI™) EDEN designs recombinases (LSRs) that can insert long, complex DNA payloads at safe, predictable and well defined genomic sites, without double stranded breaks.",
