            "quote_hash": "7ff0bcc9a8aac5e32e23ce3cccfa22f264e79c7895c59eb523f4374704e13c71"
          },
          {
            "source_id": "FISRC-ace822f737b70be1",
            "quote": "It runs a wholly owned NBFC subsidiary that handles loan disbursals, while a separate operating entity serves lease and service-based requirements.",
