    "products": [
      {
        "name": "清洁能源资产融资与部署平台",
        "description": "整合融资、交钥匙解决方案和设备租赁，覆盖屋顶光伏、电池储能、能效改造和废水处理四类资产，客户无需承担前期资本开支。",
        "target_customers": "商业与工业客户，包括工厂、医院、数据中心等",
        "features": [
          "覆盖屋顶光伏、电池储能、能效改造、废水处理四类资产",
          "通过全资NBFC子公司放款，另有运营实体提供租赁和服务",
          "与OEM和EPC合作，由平台通过技术和合同监督执行"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-ace822f737b70be1",
            "quote": "Two Point O offers financing, turnkey solutions and equipment leasing across four asset classes: rooftop solar, battery energy storage systems (BESS), energy efficiency upgrades for heating, cooling and air compressors, and wastewater treatment.",
