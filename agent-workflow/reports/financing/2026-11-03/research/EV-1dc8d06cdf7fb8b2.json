    "products": [
      {
        "name": "统一可后装自主性平台",
        "description": "一套通用软硬件栈，通过视觉优先导航、AI 定位、VLM 推理、自主移动与机械臂操作，使不同机器实现自主作业，并支持基于 VLA 的示教部署。",
        "target_customers": "工厂、仓库、机场、医院、商场及商业园区的工业与商业运营方",
        "features": [
          "视觉优先导航",
          "AI 定位",
          "VLM 推理",
          "自主移动",
          "机械臂操作",
          "VLA 示教部署",
          "可后装改造既有设备"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-3347f1018b936c8b",
            "quote": "Tensrai is developing a unified, retrofittable autonomy platform that enables industrial and commercial robots, vehicles and machines to perform physical tasks autonomously.",
            "source_content_hash": "688657a34893d5266681511dd1b11169c1dfbf75d489ff809c4aafbc7d6f1b4a",
            "quote_hash": "50894d70cd80cc45c50e68cd55da2ef81f1ba294fd6cc7783732d83c08b56170"
          },
          {
            "source_id": "FISRC-117b4311d9be89a2",
            "quote": "The platform combines vision-first navigation, AI-based localisation, reasoning powered by vision-language models (VLMs), autonomous mobility and robotic arm manipulation.",
            "source_content_hash": "ac126532010752b3",
            "quote_hash": "039dfcfd88d8af73468e6ca80e4607833fa238a4172bc08c9b172d4129a56ce4"
          }
        ],
        "entity_id": null
      },
      {
        "name": "通用移动操作机器人",
        "description": "结合自主移动与机械臂的通用移动操作机器人，面向物料搬运、清洁、制造和建筑任务。",
        "target_customers": "制造、建筑、物料搬运与清洁场景客户",
        "features": [
          "自主移动",
          "机械臂操作"
        ],
        "evidence_refs": [
          {
