    "analysis": {
      "investment_rationale": [
        {
          "institution": "Gresham House Ventures",
          "speaker": "Rohit Mathur",
          "speaker_role": "Partner, Gresham House Ventures",
          "rationale": "认为随着企业将 AI 投入实际运营，AI 治理与保障将成为必要基础设施，企业需要独立于模型提供商的测试与控制工具，而 Disseqt 覆盖 AI 应用全生命周期并已服务欧洲高要求受监管客户。",
          "quote": "We see AI governance and assurance becoming essential infrastructure as enterprises put AI into live operations. Companies need to test and control their AI with tools that sit apart from the model providers they rely on. Disseqt does that across the full life of an AI application, and its early customers include some of the most demanding regulated buyers in Europe.",
          "evidence_refs": [
            {
              "source_id": "FISRC-7d29c53fb0419b3d",
              "quote": "We see AI governance and assurance becoming essential infrastructure as enterprises put AI into live operations. Companies need to test and control their AI with tools that sit apart from the model providers they rely on. Disseqt does that across the full life of an AI application, and its early customers include some of the most demanding regulated buyers in Europe.",
              "source_content_hash": "1b744610aca8aeb130b6aad7482979838c3cee159eccfaedc8eda3381b41d227",
              "quote_hash": "e1f6cfad8ce600b420196b914f0e2f7225e7a3a5ddeba314cdaf990b6f448566"
            }
          ]
        }
      ],
      "capital_judgment": "本轮资本押注的核心变量是：企业将 AI 智能体投入生产后，对独立于模型提供商的测试、实时控制与审计证据的需求能否成为受监管企业的标准支出。已验证信号包括：Disseqt 已为覆盖 8000 万球迷的体育联盟互动智能体提供保障，并将安全响应率从 80% 提升至 99%；同时为一家欧洲大型银行信用卡服务项目提供保障。证据边界在于：来源未披露本轮轮次、累计融资额、收入或合同金额，也未披露客户付费规模；Gresham House Ventures 引用的企业 AI 部署支出数据属于其投资陈述中的行业口径，不能视为 Disseqt 自身业绩。",
      "validated_signals": [
        "已为覆盖 8000 万球迷的全球体育联盟球迷互动智能体提供保障，安全响应率从 80% 提升至 99%",
        "为一家欧洲大型银行信用卡服务项目提供 AI 保障",
        "入选 NVIDIA Open Models AI Codefest EMEA 五名获胜者之一，项目为公共部门 AI 合规平台"
      ],
