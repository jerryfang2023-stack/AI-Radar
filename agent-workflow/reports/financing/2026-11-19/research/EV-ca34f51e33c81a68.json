    "products": [
      {
        "name": "Noeri企业AI自适应系统",
        "description": "研究企业数据与工作流，针对具体任务提出对指令、工具、各步骤所用模型乃至模型本身的改动建议；每项改动附带解释并交由人工审批，类似代码评审。兼容闭源与开放权重模型。",
        "target_customers": "希望摆脱“最贵模型与更差结果”二选一困境的企业，以及科研团队",
        "features": [
          "分析企业数据与工作流并提出系统改动建议",
          "改动覆盖指令、工具、模型路由及模型本身",
          "每项改动附带解释并经人工审批",
          "兼容闭源与开放权重模型",
          "客户保留所开发工作流与模型的所有权"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-ea7b0f44d05b19b1",
            "quote": "Noeri’s software studies a company’s data and workflows, then proposes changes to the system around a specific task: the instructions, the tools, which model handles each step and, in some cases, the models themselves.",
            "source_content_hash": "29e10db17f2da1980446cbe8ece4fa842305c02feaabceaf6788d1805843b34d",
            "quote_hash": "f7e7688ff1afe740c77fad9b0dffe806d78051d962f60b4d47068661e1a8e7fe"
          },
          {
            "source_id": "FISRC-d234bdf83871392e",
            "quote": "The system works with both closed and open-weight models and is designed to keep adapting as new models are released.",
            "source_content_hash": "4d527d39a26352c4",
            "quote_hash": "a494fcf251bd6109ce3fd7e520d21b868ba87535f8f01c711011804dba2135fe"
          }
        ],
        "entity_id": null
      }
