    "products": [
      {
        "name": "Hone Engine",
        "description": "持久化AI智能体，被分配一个业务结果后，可自主探索公司系统、研究过往工作、编写自己的技能和工具，并在上线前用历史决策进行测试，持续从错误和纠正中改进，基于事件而非提示行动。",
        "target_customers": "领先AI公司及大型企业",
        "features": [
          "自主探索公司系统并编写技能和工具",
