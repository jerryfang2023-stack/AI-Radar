    "products": [
      {
        "name": "Fleuret 智能体渗透测试平台",
        "description": "利用两个AI智能体Emile和Champollion自动化渗透测试，将一次性审计转变为持续安全测试，覆盖暴露系统测绘、漏洞识别、可利用性验证、修复协助和修复验证五个环节。",
        "target_customers": "各类企业，尤其是无法负担定期人工渗透测试的组织，以及受NIS2、DORA等监管要求约束的欧洲企业。",
        "features": [
          "两个AI智能体Emile和Champollion自动测绘环境、探索应用、API和基础设施",
          "尝试利用发现的漏洞并提供可复现的入侵证明",
          "持续监控攻击面并在系统变化时触发新测试",
          "按可利用性排序、与工程团队工具集成、自动复测并验证修复",
          "在欧洲基础设施上运行，满足数据主权要求"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-d53e6de7830c8d74",
            "quote": "Fleuret automates the pentester's work with two AI agents, Emile and Champollion. They map a company's environment, explore its applications, APIs and infrastructure, then try to exploit the vulnerabilities they find.",
            "source_content_hash": "b7f15ba9a80ac1c7",
            "quote_hash": "63ebdf2508f318aecded120f4344f8e0699e58457ab42083af4d9b34a7d720c2"
          },
          {
            "source_id": "FISRC-c0f73e8fd5d11413",
            "quote": "The platform also provides proof of compromise for its findings and supports remediation through prioritisation, integrations with engineering tools and automated re-testing.",
            "source_content_hash": "13c60c04daee1fcd",
            "quote_hash": "7105eb37048a9c856164ccb58c6afbac3355134c776f3635c5e7508dcfe180e5"
          }
        ],
        "entity_id": null
      }
    ],
