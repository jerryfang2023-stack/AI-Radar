    "products": [
      {
        "name": "Ambi",
        "description": "一款能够持续在后台聆听用户、提供实时智能与洞察的 AI 应用，可作为会议记录工具，并能在会议进行中主动提供建议或呈现相关知识。",
        "target_customers": "个人用户、专业人士",
