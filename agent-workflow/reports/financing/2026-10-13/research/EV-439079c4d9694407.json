        "evidence_refs": [
          {
            "source_id": "FISRC-84410a602fe52654",
            "quote": "The app aims to provide real-time intelligence and insights to people by listening to them all the time.",
            "source_content_hash": "d1499bba80f4453b6c498ff4e005a94fbfb817c40afa1d4b169c64bd865a0ed2",
            "quote_hash": "04fee2d55660fc2621b035ebae09f9eb5cea7723cef4b53a470dbc47c284f1a7"
          },
          {
            "source_id": "FISRC-84410a602fe52654",
            "quote": "These apps act like meeting notetakers, but users can choose to have them listening so they can capture context all day.",
            "source_content_hash": "d1499bba80f4453b6c498ff4e005a94fbfb817c40afa1d4b169c64bd865a0ed2",
            "quote_hash": "fc58831b27d9396ac81c78b3bb91091ecde5d59129222e5de8e69a38781fe83e"
          },
          {
            "source_id": "FISRC-84410a602fe52654",
            "quote": "Ambi wants to take this a step further by having its agent start the work during the meeting itself.",
            "source_content_hash": "d1499bba80f4453b6c498ff4e005a94fbfb817c40afa1d4b169c64bd865a0ed2",
            "quote_hash": "0088101b1dcc3c30f1c5f4c47e9be2ec6e0cb1d7bd5a72df1e996e5582f5d3e4"
          },
          {
            "source_id": "FISRC-84410a602fe52654",
            "quote": "Users can also start a task on one device and continue it on another.",
            "source_content_hash": "d1499bba80f4453b6c498ff4e005a94fbfb817c40afa1d4b169c64bd865a0ed2",
            "quote_hash": "0030994e5dcd6401b5665b5476b26fe280525b148239a15cad69adbeac3dd88a"
          }
        ],
