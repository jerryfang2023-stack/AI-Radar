    "products": [
      {
        "name": "AI 医疗器械认证服务",
        "description": "Scarlet 作为认证机构，客户可上传任意格式的技术文档，由合格审查员对照法规核查，决定产品能否上市；订阅服务包含持续监督、年度审计和产品调整。",
        "target_customers": "AI 与软件医疗器械制造商",
        "features": [
          "客户上传任意格式技术文档",
          "合格审查员对照法规核查",
          "订阅包含持续监督、年度审计与产品调整",
          "记录所有发现供监管机构随时审查决策理由"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-9196fce596a4d511",
            "quote": "Customers upload technical documentation in any format, and qualified reviewers check it against regulations to decide if a product can ship. The subscription includes continuous surveillance, annual audits, and product adjustments.",
            "source_content_hash": "b834b2e132701625",
            "quote_hash": "9cab2243d59ac4c5d251d769f2ce18c6c0b544c848574d4513bd2fd01b99e739"
          },
          {
            "source_id": "FISRC-5f20202ab3b889f7",
            "quote": "Scarlet says it records all findings, enabling regulators to examine the reasons for each decision at any time.",
            "source_content_hash": "e2e353c5cf497e02",
            "quote_hash": "57f3791e85fc9930d570d8d579cb5ec5eb6dbfc0c475b36b357ffb4e2c33ef4d"
          }
        ],
        "entity_id": null
      },
      {
        "name": "AI 原生认证流程",
        "description": "Scarlet 通过专家评估团队配合 AI agents 提升评估效率，将认证从人工节奏推进到 AI 节奏，适配 AI 与软件产品快速迭代的更新需求。",
        "target_customers": "需要频繁更新产品的 AI 医疗器械企业",
        "features": [
          "专家评估团队配合 AI agents",
          "适配 AI 产品迭代式更新",
          "快速处理产品更新与变更"
