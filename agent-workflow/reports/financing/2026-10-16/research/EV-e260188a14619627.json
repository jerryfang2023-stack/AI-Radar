    "products": [
      {
        "name": "Holo AI营销平台",
        "description": "Holo是一个AI营销平台，为小企业规划并执行营销，涵盖广告、社交媒体、邮件和SEO内容。平台结合第三方AI模型与自有技术，包括品牌记忆、策略引擎和创意系统。",
        "target_customers": "小企业",
        "features": [
          "输入网站后学习业务和品牌，生成营销计划",
          "创建广告、社交媒体帖子、邮件和SEO内容",
          "内容日历组织，支持审核、修改和批准",
          "选定任务可切换为自动运行",
          "跟踪活动效果并推荐下一步调整"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-1e7e3d8e53cc437b",
            "quote": "Holo plans and runs marketing for small businesses, from choosing channels to creating ads, social media posts, emails and SEO content in each business’s own voice.",
            "source_content_hash": "554c5b61db955f1c",
            "quote_hash": "25e3e697095574ab84356f5e07158d7d1947284b7e0ce1b9fd153eab8e7e6f05"
          },
          {
            "source_id": "FISRC-1e7e3d8e53cc437b",
            "quote": "Holo uses third-party AI models, with its own technology built on top: a brand memory that retains each business's tone and visual identity, a strategy engine that decides the plan, and a creative system informed by what has performed across millions of pieces of content created on the platform.",
            "source_content_hash": "554c5b61db955f1c",
            "quote_hash": "32ae0e16fcec37624da57c1875296d78917363147e2eeefa026bad2971b5a834"
          }
        ],
