    "products": [
      {
        "name": "AI-native engineering firm",
        "description": "Solvera 作为工程记录公司（engineering firm of record）运营，提供从初始需求到施工就绪设计的端到端服务，利用专有 AI 代理自动化机械、电气和管道（MEP）设计流程，人类工程师负责判断性决策。",
        "target_customers": "建筑行业客户",
        "features": [
          "端到端设计服务",
          "专有 AI 代理自动化 MEP 设计",
