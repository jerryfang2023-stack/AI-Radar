    "products": [
      {
        "name": "上下文推理层（context reasoning layer）",
        "description": "Uvi 构建的公司自有“上下文推理层”，即统一的机构记忆，供每个 AI 工具调用；它把 Slack、Jira、Confluence、Salesforce、代码仓库和会议纪要等系统连接成知识图谱，映射决策如何做出及为何做出。",
        "target_customers": "企业 AI 智能体部署方",
        "features": [
          "连接 Slack、Jira、Confluence、Salesforce、代码仓库与会议纪要",
          "构建映射决策与依赖关系的知识图谱",
          "语义层编码公司术语",
          "访问控制与数据标记保留边界"
        ],
        "evidence_refs": [
          {
            "source_id": "FISRC-8f60534aa7e0f6bc",
            "quote": "Uvi is building a \"context reasoning layer\" that each company owns, a unified institutional memory every AI tool can tap.",
