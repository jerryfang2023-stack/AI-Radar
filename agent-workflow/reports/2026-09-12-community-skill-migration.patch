+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from quote_validation import validate_quotes
+
+
+class QuoteValidationTests(unittest.TestCase):
+    source = "先验证需求。再做产品。保留人工复核。"
+
+    def quotes(self):
+        return [{"text": text} for text in ["先验证需求。", "再做产品。", "保留人工复核。"]]
+
+    def test_exact_source_and_optional_highlight(self):
+        quotes = self.quotes()
+        quotes[0]["highlight"] = "验证需求"
+        validate_quotes(quotes, self.source)
+
+    def test_empty_whitespace_and_wrong_type_are_rejected(self):
+        for invalid in ["", "  ", None, 0]:
+            with self.subTest(invalid=invalid), self.assertRaisesRegex(ValueError, "nonempty"):
+                quotes = self.quotes()
+                quotes[0]["text"] = invalid
+                validate_quotes(quotes, self.source)
+
+    def test_missing_or_wrong_cardinality(self):
+        for quotes in [None, {}, [], self.quotes()[:2], self.quotes() * 2]:
+            with self.subTest(quotes=quotes), self.assertRaisesRegex(ValueError, "3 to 5"):
+                validate_quotes(quotes, self.source)
+
+    def test_duplicate(self):
+        with self.assertRaisesRegex(ValueError, "duplicate"):
+            validate_quotes([self.quotes()[0]] * 3, self.source)
+
+    def test_paraphrase_and_stitched_quote(self):
+        for text in ["先验证需求再做产品。", "先确认需求。"]:
+            with self.subTest(text=text), self.assertRaisesRegex(ValueError, "verbatim"):
+                quotes = self.quotes()
+                quotes[0]["text"] = text
+                validate_quotes(quotes, self.source)
+
+    def test_foreign_highlight(self):
+        with self.assertRaisesRegex(ValueError, "highlight"):
+            quotes = self.quotes()
+            quotes[0]["highlight"] = "商业模式已验证"
+            validate_quotes(quotes, self.source)
+
+    def test_builder_and_batch_fail_before_rendering_empty_evidence(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            (root / "source.md").write_text(self.source, encoding="utf-8")
+            (root / "manifest.json").write_text(json.dumps({
+                "source": "source.md", "quotes": [{"text": ""}] * 3,
+                "speaker": {"tags": ["a", "b", "c", "d"]},
+            }), encoding="utf-8")
+            scripts = Path(__file__).parent
+            for script, target in [("build_card.py", root / "manifest.json"), ("validate_batch.py", root)]:
+                run = subprocess.run([sys.executable, "-X", "utf8", str(scripts / script), str(target)], capture_output=True, text=True, encoding="utf-8")
+                self.assertNotEqual(run.returncode, 0)
+                self.assertIn("quote text must be nonempty", run.stdout + run.stderr)
+            self.assertFalse(list(root.glob("*.png")))
+
+
+if __name__ == "__main__":
+    unittest.main()
