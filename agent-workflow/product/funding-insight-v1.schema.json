{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wavesight.local/schemas/funding-insight-v1.schema.json",
  "title": "WaveSight Funding Insight V1",
  "type": "object",
  "required": [
    "schema_version",
    "funding_insight_id",
    "triggered_by_event_id",
    "source_event_ids",
    "as_of_date",
    "company",
    "financing",
    "products",
    "customers",
    "customer_research",
    "comparisons",
    "metrics",
    "analysis",
    "entity_links",
    "entity_link_coverage",
    "aggregation",
    "funding_history",
    "research_sources",
    "model_provenance",
    "auto_publish_gate",
    "publication_status",
    "published_at"
  ],
  "properties": {
    "schema_version": { "const": "FUNDING-INSIGHT-V1.1" },
    "funding_insight_id": { "type": "string", "minLength": 1 },
    "triggered_by_event_id": { "type": "string", "minLength": 1 },
    "source_event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "as_of_date": { "type": "string", "format": "date" },
    "company": {
      "type": "object",
      "required": ["entity_id", "name", "full_name", "website", "summary", "headquarters", "founders", "team_size", "evidence_refs"],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "full_name": { "type": "string", "minLength": 1 },
        "website": { "type": "string" },
        "summary": { "type": "string", "minLength": 1 },
        "headquarters": { "type": "string" },
        "founders": { "type": "array" },
        "team_size": { "type": "object" },
        "evidence_refs": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": false
    },
    "financing": {
      "type": "object",
      "required": [
        "round",
        "round_code",
        "round_original",
        "amount",
        "total_raised",
        "announced_at",
        "investors",
        "other_round_investors",
        "disclosures",
        "evidence_refs"
      ],
      "properties": {
        "round": { "type": "string", "minLength": 1 },
        "round_code": { "type": "string", "minLength": 1 },
        "round_original": { "type": "string" },
        "amount": { "type": "string", "minLength": 1 },
        "total_raised": { "type": "string" },
        "announced_at": { "type": "string" },
        "investor_disclosure_status": { "enum": ["disclosed", "not_disclosed", "unknown"] },
        "risk_markers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "investors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role", "entity_id", "evidence_refs"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "role": { "type": "string" },
              "entity_id": { "type": ["string", "null"] },
              "evidence_refs": { "type": "array", "minItems": 1 }
            },
            "additionalProperties": false
          }
        },
        "other_round_investors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "role", "entity_id", "evidence_refs"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "role": { "type": "string" },
              "entity_id": { "type": ["string", "null"] },
              "evidence_refs": { "type": "array", "minItems": 1 },
              "round_context": {
                "type": "object",
                "required": ["code", "label", "original"],
                "properties": {
                  "code": { "type": "string", "minLength": 1 },
                  "label": { "type": "string", "minLength": 1 },
                  "original": { "type": "string" }
                },
                "additionalProperties": false
              },
              "classification_reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "disclosures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["event_id", "round_original", "amount", "announced_at", "evidence_refs"],
            "properties": {
              "event_id": { "type": "string", "minLength": 1 },
              "round_original": { "type": "string" },
              "amount": { "type": "string" },
              "announced_at": { "type": "string" },
              "evidence_refs": { "type": "array" }
            },
            "additionalProperties": false
          }
        },
        "evidence_refs": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": false
    },
    "products": { "type": "array", "minItems": 1 },
    "customers": { "type": "array" },
    "customer_research": {
      "type": "object",
      "required": ["status", "verified_customer_count", "searched_source_count"],
      "properties": {
        "status": { "enum": ["verified_customers_found", "no_verified_customer_found"] },
        "verified_customer_count": { "type": "integer", "minimum": 0 },
        "searched_source_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "product", "scenario", "target_customer", "funding_summary", "core_difference", "evidence_refs"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "product": { "type": "string" },
          "scenario": { "type": "string" },
          "target_customer": { "type": "string" },
          "funding_summary": { "type": "string" },
          "core_difference": { "type": "string", "minLength": 1 },
          "entity_id": { "type": ["string", "null"] },
          "evidence_refs": { "type": "array", "minItems": 1 }
        },
        "additionalProperties": false
      }
    },
    "metrics": { "type": "array" },
    "quotes": { "type": "array" },
    "analysis": {
      "type": "object",
      "required": [
        "investment_rationale",
        "investment_thesis",
        "capital_judgment",
        "validated_signals",
        "risks",
        "related_direction_id",
        "sector"
      ],
      "properties": {
        "investment_rationale": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["institution", "speaker", "speaker_role", "rationale", "quote", "evidence_refs"],
            "properties": {
              "institution": { "type": "string", "minLength": 1 },
              "speaker": { "type": "string" },
              "speaker_role": { "type": "string" },
              "rationale": { "type": "string", "minLength": 1 },
              "quote": { "type": "string", "minLength": 1 },
              "evidence_refs": { "type": "array", "minItems": 1 }
            },
            "additionalProperties": false
          }
        },
        "investment_thesis": {
          "type": "object",
          "required": ["statement", "evidence_signals", "risks", "institutional_rationale_status"],
          "properties": {
            "statement": { "type": "string", "minLength": 1 },
            "evidence_signals": { "type": "array", "items": { "type": "string" } },
            "risks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "institutional_rationale_status": { "enum": ["disclosed", "not_disclosed"] }
          },
          "additionalProperties": false
        },
        "capital_judgment": { "type": "string", "minLength": 1 },
        "validated_signals": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "related_direction_id": { "type": "string" },
        "product_form_id": {
          "enum": [
            "model",
            "api_service",
            "developer_tool",
            "ai_application",
            "enterprise_platform",
            "data_infrastructure",
            "security_product",
            "ai_device",
            "robot",
            "chip_accelerator",
            "compute_system",
            "compute_service"
          ]
        },
        "market_category_id": {
          "enum": [
            "ai_infrastructure",
            "horizontal_ai",
            "vertical_ai"
          ]
        },
        "sector": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "entity_links": { "type": "array" },
    "entity_link_coverage": {
      "type": "object",
      "required": ["products", "founders"],
      "properties": {
        "products": { "$ref": "#/$defs/linkCoverage" },
        "founders": { "$ref": "#/$defs/linkCoverage" }
      },
      "additionalProperties": false
    },
    "aggregation": {
      "type": "object",
      "required": ["key", "event_count", "strategy"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "event_count": { "type": "integer", "minimum": 1 },
        "strategy": { "const": "company_and_normalized_round" }
      },
      "additionalProperties": false
    },
    "funding_history": { "type": "array" },
    "research_sources": { "type": "array", "minItems": 2 },
    "model_provenance": { "type": "object" },
    "auto_publish_gate": {
      "type": "object",
      "required": ["passed", "problems", "gate_version"],
      "properties": {
        "passed": { "const": true },
        "problems": { "type": "array", "maxItems": 0 },
        "gate_version": { "const": "FUNDING-INSIGHT-AUTO-PUBLISH-GATE-V1.1" }
      },
      "additionalProperties": false
    },
    "publication_status": { "const": "auto_published" },
    "published_at": { "type": "string" }
  },
  "additionalProperties": false,
  "$defs": {
    "linkCoverage": {
      "type": "object",
      "required": ["linked", "total", "unresolved_names"],
      "properties": {
        "linked": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "unresolved_names": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  }
}
