{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wavesight.local/schemas/funding-insight-v1.schema.json",
  "title": "WaveSight Funding Insight V1",
  "type": "object",
  "required": [
    "schema_version",
    "funding_insight_id",
    "triggered_by_event_id",
    "as_of_date",
    "company",
    "financing",
    "products",
    "customers",
    "comparisons",
    "metrics",
    "analysis",
    "entity_links",
    "funding_history",
    "research_sources",
    "model_provenance",
    "auto_publish_gate",
    "publication_status",
    "published_at"
  ],
  "properties": {
    "schema_version": { "const": "FUNDING-INSIGHT-V1.0" },
    "funding_insight_id": { "type": "string", "minLength": 1 },
    "triggered_by_event_id": { "type": "string", "minLength": 1 },
    "as_of_date": { "type": "string", "format": "date" },
    "company": {
      "type": "object",
      "required": ["entity_id", "name", "full_name", "website", "summary", "headquarters", "founders", "team_size", "evidence_refs"],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "full_name": { "type": "string", "minLength": 1 },
        "website": { "type": "string" },
        "summary": { "type": "string", "minLength": 1 },
        "headquarters": { "type": "string" },
        "founders": { "type": "array" },
        "team_size": { "type": "object" },
        "evidence_refs": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": false
    },
    "financing": {
      "type": "object",
      "required": ["round", "amount", "total_raised", "announced_at", "investors", "evidence_refs"],
      "properties": {
        "round": { "type": "string", "minLength": 1 },
        "amount": { "type": "string", "minLength": 1 },
        "total_raised": { "type": "string" },
        "announced_at": { "type": "string" },
        "investors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "role", "entity_id", "evidence_refs"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "role": { "type": "string" },
              "entity_id": { "type": ["string", "null"] },
              "evidence_refs": { "type": "array", "minItems": 1 }
            },
            "additionalProperties": false
          }
        },
        "evidence_refs": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": false
    },
    "products": { "type": "array", "minItems": 1 },
    "customers": { "type": "array" },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "product", "scenario", "target_customer", "funding_summary", "core_difference", "evidence_refs"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "product": { "type": "string" },
          "scenario": { "type": "string" },
          "target_customer": { "type": "string" },
          "funding_summary": { "type": "string" },
          "core_difference": { "type": "string", "minLength": 1 },
          "evidence_refs": { "type": "array", "minItems": 1 }
        },
        "additionalProperties": false
      }
    },
    "metrics": { "type": "array" },
    "quotes": { "type": "array" },
    "analysis": {
      "type": "object",
      "required": ["investment_rationale", "capital_judgment", "validated_signals", "risks", "related_direction_id", "sector"],
      "properties": {
        "investment_rationale": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["institution", "speaker", "speaker_role", "rationale", "quote", "evidence_refs"],
            "properties": {
              "institution": { "type": "string", "minLength": 1 },
              "speaker": { "type": "string" },
              "speaker_role": { "type": "string" },
              "rationale": { "type": "string", "minLength": 1 },
              "quote": { "type": "string", "minLength": 1 },
              "evidence_refs": { "type": "array", "minItems": 1 }
            },
            "additionalProperties": false
          }
        },
        "capital_judgment": { "type": "string", "minLength": 1 },
        "validated_signals": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "related_direction_id": { "type": "string" },
        "sector": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "entity_links": { "type": "array" },
    "funding_history": { "type": "array" },
    "research_sources": { "type": "array", "minItems": 2 },
    "model_provenance": { "type": "object" },
    "auto_publish_gate": {
      "type": "object",
      "required": ["passed", "problems", "gate_version"],
      "properties": {
        "passed": { "const": true },
        "problems": { "type": "array", "maxItems": 0 },
        "gate_version": { "const": "FUNDING-INSIGHT-AUTO-PUBLISH-GATE-V1.0" }
      },
      "additionalProperties": false
    },
    "publication_status": { "const": "auto_published" },
    "published_at": { "type": "string" }
  },
  "additionalProperties": false
}
