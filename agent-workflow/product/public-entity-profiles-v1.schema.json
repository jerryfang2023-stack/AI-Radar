{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wavesight.local/schemas/public-entity-profiles-v1.schema.json",
  "title": "WaveSight Public Entity Profiles V1",
  "type": "object",
  "required": ["schema_version", "as_of", "institutions", "people"],
  "properties": {
    "schema_version": { "const": "PUBLIC-ENTITY-PROFILES-V1.0" },
    "as_of": { "type": "string", "format": "date" },
    "institutions": { "type": "object", "patternProperties": { "^INV-[a-f0-9]{14}$": { "$ref": "#/$defs/institution" } }, "additionalProperties": false },
    "people": { "type": "object", "patternProperties": { "^(EN-[a-f0-9]{16}|INV-[a-f0-9]{14})$": { "$ref": "#/$defs/person" } }, "additionalProperties": false }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_id", "source_url", "source_title", "source_content_hash", "quote", "quote_hash"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "source_title": { "type": "string", "minLength": 1 },
        "source_content_hash": { "type": "string", "pattern": "^(?:[a-f0-9]{16}|[a-f0-9]{64})$" },
        "quote": { "type": "string", "minLength": 1 },
        "quote_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": ["field", "label", "value", "source_id"],
      "properties": { "field": { "type": "string" }, "label": { "type": "string" }, "value": { "type": ["string", "array"] }, "source_id": { "type": "string" } },
      "additionalProperties": false
    },
    "milestone": {
      "type": "object",
      "required": ["date", "description", "source_id"],
      "properties": { "date": { "type": "string" }, "description": { "type": "string" }, "source_id": { "type": "string" } },
      "additionalProperties": false
    },
    "achievement": {
      "type": "object",
      "required": ["description", "source_id"],
      "properties": { "description": { "type": "string" }, "source_id": { "type": "string" } },
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "required": ["kind", "label", "value", "source_id"],
      "properties": {
        "kind": { "enum": ["website", "application", "email", "phone", "address", "contact_form", "social"] },
        "label": { "type": "string" }, "value": { "type": "string" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }, "source_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "institution": {
      "type": "object",
      "required": ["summary", "facts", "milestones", "track_record", "contacts", "sources", "last_verified_at"],
      "properties": {
        "summary": { "type": "string" }, "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "milestones": { "type": "array", "items": { "$ref": "#/$defs/milestone" } },
        "track_record": { "type": "array", "items": { "$ref": "#/$defs/achievement" } },
        "profile_type": { "enum": ["organization", "person", "unverified"] },
        "coverage_status": { "enum": ["researched", "activity_only", "self_declared_affiliation", "identity_unverified"] },
        "coverage_note": { "type": "string" },
        "current_roles": { "type": "array", "items": { "$ref": "#/$defs/role" } },
        "career": { "type": "array", "items": { "$ref": "#/$defs/career" } },
        "education": { "type": "array", "items": { "$ref": "#/$defs/education" } },
        "experience_summary": { "type": "string" },
        "contacts": { "type": "array", "items": { "$ref": "#/$defs/contact" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "last_verified_at": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "role": {
      "type": "object", "required": ["title", "organization", "source_id"],
      "properties": { "title": { "type": "string" }, "organization": { "type": "string" }, "source_id": { "type": "string" } },
      "additionalProperties": false
    },
    "career": {
      "type": "object", "required": ["organization", "title", "period", "description", "source_id"],
      "properties": { "organization": { "type": "string" }, "title": { "type": "string" }, "period": { "type": "string" }, "description": { "type": "string" }, "source_id": { "type": "string" } },
      "additionalProperties": false
    },
    "education": {
      "type": "object", "required": ["institution", "qualification", "source_id"],
      "properties": { "institution": { "type": "string" }, "qualification": { "type": "string" }, "source_id": { "type": "string" } },
      "additionalProperties": false
    },
    "person": {
      "type": "object",
      "required": ["summary", "current_roles", "career", "education", "experience_summary", "track_record", "sources", "last_verified_at"],
      "properties": {
        "summary": { "type": "string" }, "current_roles": { "type": "array", "items": { "$ref": "#/$defs/role" } },
        "coverage_status": { "enum": ["researched", "activity_only", "self_declared_affiliation", "identity_unverified"] },
        "coverage_note": { "type": "string" },
        "career": { "type": "array", "items": { "$ref": "#/$defs/career" } },
        "education": { "type": "array", "items": { "$ref": "#/$defs/education" } },
        "experience_summary": { "type": "string" }, "track_record": { "type": "array", "items": { "$ref": "#/$defs/achievement" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "last_verified_at": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    }
  }
}
