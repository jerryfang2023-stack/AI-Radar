{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wavesight.local/schemas/data-center-v4.schema.json",
  "title": "WaveSight Data Center V4",
  "type": "object",
  "required": ["manifest", "source_artifacts", "raw_documents", "claims", "entities", "entity_mentions", "canonical_events", "event_sources", "event_claims", "event_conflicts", "relationships", "tag_assertions", "facet_assertions", "reviewed_event_classifications", "fde_records", "fde_observations", "hardware_records", "hardware_facts", "hardware_snapshots", "monitoring_funnel", "qa_queue"],
  "properties": {
    "manifest": { "$ref": "#/$defs/manifest" },
    "source_artifacts": { "type": "array", "items": { "$ref": "#/$defs/sourceArtifact" } },
    "raw_documents": { "type": "array", "items": { "$ref": "#/$defs/rawDocument" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "entity_mentions": { "type": "array", "items": { "$ref": "#/$defs/entityMention" } },
    "canonical_events": { "type": "array", "items": { "$ref": "#/$defs/canonicalEvent" } },
    "event_sources": { "type": "array", "items": { "$ref": "#/$defs/eventSource" } },
    "event_claims": { "type": "array", "items": { "$ref": "#/$defs/eventClaim" } },
    "event_conflicts": { "type": "array", "items": { "$ref": "#/$defs/eventConflict" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
    "tag_assertions": { "type": "array", "items": { "$ref": "#/$defs/tagAssertion" } },
    "facet_assertions": { "type": "array", "items": { "$ref": "#/$defs/facetAssertion" } },
    "reviewed_event_classifications": { "type": "array", "items": { "$ref": "#/$defs/reviewedEventClassification" } },
    "fde_records": { "type": "array", "items": { "$ref": "#/$defs/fdeRecord" } },
    "fde_observations": { "type": "array", "items": { "$ref": "#/$defs/fdeObservation" } },
    "hardware_records": { "type": "array", "items": { "$ref": "#/$defs/hardwareRecord" } },
    "hardware_facts": { "type": "array", "items": { "$ref": "#/$defs/hardwareFact" } },
    "hardware_snapshots": { "type": "array", "items": { "$ref": "#/$defs/hardwareSnapshot" } },
    "monitoring_funnel": { "type": "array", "items": { "$ref": "#/$defs/monitoringFunnel" } },
    "qa_queue": { "type": "array", "items": { "$ref": "#/$defs/qaItem" } }
  },
  "additionalProperties": false,
  "$defs": {
    "sourceSpan": {
      "type": "object",
      "required": ["raw_id", "start", "end"],
      "properties": {
        "raw_id": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": ["product_version", "raw_version", "event_version", "fde_version", "fde_observation_version", "hardware_version", "hardware_fact_version", "hardware_snapshot_version", "monitoring_funnel_version", "tag_version", "date", "generated_at", "counts"],
      "properties": {
        "product_version": { "const": "SITE-V4.0-data-center" },
        "raw_version": { "const": "RAW-V4.0" },
        "event_version": { "const": "EVENT-V1.1" },
        "fde_version": { "const": "FDE-V2.0" },
        "fde_observation_version": { "const": "FDE-OBSERVATION-V1.0" },
        "hardware_version": { "const": "HARDWARE-V1.0" },
        "hardware_fact_version": { "const": "HARDWARE-FACT-V1.0" },
        "hardware_snapshot_version": { "const": "HARDWARE-SNAPSHOT-V1.0" },
        "monitoring_funnel_version": { "const": "LENS-FUNNEL-V1.0" },
        "tag_version": { "const": "TAG-V4.1" },
        "date": { "type": "string", "format": "date" },
        "generated_at": { "type": "string" },
        "source_of_truth": { "type": "string" },
        "compatibility_state": { "const": "retired" },
        "counts": { "type": "object" },
        "forbidden_field_hits": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "sourceArtifact": {
      "type": "object",
      "required": ["source_artifact_id", "source_url", "captured_at", "snapshot_refs", "content_hash"],
      "properties": {
        "source_artifact_id": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string" },
        "canonical_url": { "type": "string" },
        "publisher": { "type": "string" },
        "capture_method": { "type": "string" },
        "captured_at": { "type": "string" },
        "snapshot_refs": { "type": "array", "items": { "type": "string" } },
        "content_hash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "rawDocument": {
      "type": "object",
      "required": ["schema_version", "raw_id", "source_artifact_id", "source_url", "captured_at", "title_original", "body_ref", "body_length", "body_storage", "content_hash", "extraction_status", "claim_ids", "entity_mention_ids", "event_candidate_ids"],
      "properties": {
        "schema_version": { "const": "RAW-V4.0" },
        "raw_id": { "type": "string", "minLength": 1 },
        "source_artifact_id": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string" },
        "canonical_url": { "type": "string" },
        "publisher": { "type": "string" },
        "author": { "type": "string" },
        "published_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "captured_at": { "type": "string" },
        "language": { "type": "string" },
        "document_type": { "type": "string" },
        "title_original": { "type": "string" },
        "title_zh": { "type": "string" },
        "body_length": { "type": "integer", "minimum": 0 },
        "body_storage": { "const": "private_evidence_store" },
        "content_hash": { "type": "string" },
        "capture_method": { "type": "string" },
        "extraction_status": { "enum": ["accepted", "partial", "quarantined"] },
        "market_scope": {
          "type": "object",
          "required": ["source_registry_id", "source_region", "market_region", "china_market_match", "china_market_match_basis"],
          "properties": {
            "source_registry_id": { "type": "string" },
            "source_region": { "type": "string" },
            "market_region": { "type": "string" },
            "china_market_match": { "type": "boolean" },
            "china_market_match_basis": { "type": "string" }
          },
          "additionalProperties": false
        },
        "source_update_history": { "type": "array" },
        "claim_ids": { "type": "array", "items": { "type": "string" } },
        "entity_mention_ids": { "type": "array", "items": { "type": "string" } },
        "event_candidate_ids": { "type": "array", "items": { "type": "string" } },
        "body_ref": { "type": "string", "pattern": "^evidence://" }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "raw_id", "claim_type", "subject", "predicate", "object", "source_span", "source_quote", "extraction_method", "extraction_confidence", "verification_status"],
      "properties": {
        "claim_id": { "type": "string" },
        "raw_id": { "type": "string" },
        "claim_type": { "type": "string" },
        "subject": { "type": "string" },
        "predicate": { "type": "string" },
        "object": { "type": "string" },
        "qualifiers": { "type": "object" },
        "source_span": { "$ref": "#/$defs/sourceSpan" },
        "source_quote": { "type": "string", "minLength": 1 },
        "extraction_method": { "enum": ["deterministic_source_span", "model_source_span", "manual"] },
        "extraction_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "verification_status": { "enum": ["accepted", "partial", "disputed", "quarantined"] }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["entity_id", "canonical_name", "entity_type", "aliases", "verification_status"],
      "properties": {
        "entity_id": { "type": "string" },
        "canonical_name": { "type": "string" },
        "entity_type": { "enum": ["organization_candidate", "person_candidate", "product_candidate", "location_candidate", "unknown"] },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "verification_status": { "enum": ["candidate", "verified", "merged", "quarantined"] }
      },
      "additionalProperties": false
    },
    "entityMention": {
      "type": "object",
      "required": ["mention_id", "entity_id", "raw_id", "text", "source", "start", "end", "verification_status"],
      "properties": {
        "mention_id": { "type": "string", "minLength": 1 },
        "entity_id": { "type": "string", "minLength": 1 },
        "raw_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "source": { "enum": ["title_original", "claim_evidence", "document_evidence", "source_url"] },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "verification_status": { "enum": ["candidate", "verified", "merged", "quarantined"] }
      },
      "additionalProperties": false
    },
    "canonicalEvent": {
      "type": "object",
      "required": ["event_id", "event_type", "event_status", "event_time", "disclosed_at", "entities", "action", "object", "metrics", "locations", "claim_refs", "source_refs", "conflicts", "missing_fields", "update_history", "publication_status"],
      "properties": {
        "event_id": { "type": "string" },
        "event_type": { "enum": ["model_release", "product_release", "service_change", "pricing_change", "funding", "acquisition", "ipo_listing", "capital_investment", "financial_performance", "partnership", "procurement_contract", "market_expansion", "deployment", "organization_people", "organization_restructuring", "policy_regulation", "lawsuit_settlement", "certification_compliance", "standard_specification", "security_incident", "research_result", "hardware_product", "hardware_capacity", "hardware_supply", "hardware_deployment"] },
        "event_status": { "enum": ["announced", "planned", "in_progress", "completed", "rumored", "disputed", "withdrawn"] },
        "event_time": { "type": "string" },
        "disclosed_at": { "type": "string" },
        "display_title_zh": { "type": "string" },
        "entities": { "type": "array", "items": { "type": "string" } },
        "action": { "type": "string" },
        "object": { "type": "string" },
        "metrics": { "type": "array" },
        "locations": { "type": "array" },
        "claim_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "conflicts": { "type": "array" },
        "missing_fields": { "type": "array", "items": { "type": "string" } },
        "update_history": { "type": "array" },
        "publication_status": { "enum": ["verified", "partial", "disputed", "quarantined", "withdrawn"] }
        ,"market_scope": {
          "type": "object",
          "required": ["market_region", "china_market_match", "china_market_basis", "source_registry_ids", "claim_refs"],
          "properties": {
            "market_region": { "const": "CN" },
            "china_market_match": { "const": true },
            "china_market_basis": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["actor_origin", "event_market", "regulatory_jurisdiction", "deployment_location"] }
            },
            "source_registry_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "claim_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tagAssertion": {
      "type": "object",
      "required": ["asset_id", "tag_id", "evidence_ref", "source_span", "assignment_method", "confidence", "taxonomy_version", "status"],
      "properties": {
        "asset_id": { "type": "string" },
        "tag_id": { "type": "string" },
        "evidence_ref": { "type": "string" },
        "source_span": { "$ref": "#/$defs/sourceSpan" },
        "assignment_method": { "enum": ["rule", "model", "manual"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "taxonomy_version": { "const": "TAG-V4.1" },
        "status": { "enum": ["active", "review", "rejected", "deprecated"] }
      },
      "additionalProperties": false
    },
    "facetAssertion": {
      "type": "object",
      "required": ["asset_id", "dimension_id", "value_id", "evidence_ref", "source_span", "assignment_method", "confidence", "taxonomy_version", "status"],
      "properties": {
        "asset_id": { "type": "string" },
        "dimension_id": { "enum": ["product_form", "use_case", "industry", "deployment_model", "target_user"] },
        "value_id": { "type": "string" },
        "evidence_ref": { "type": "string" },
        "source_span": { "$ref": "#/$defs/sourceSpan" },
        "assignment_method": { "enum": ["rule", "model", "manual"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "taxonomy_version": { "const": "TAG-V4.1" },
        "status": { "enum": ["active", "review", "rejected", "deprecated"] }
      },
      "additionalProperties": false
    },
    "reviewedEvidenceRef": {
      "type": "object",
      "required": ["source_id", "source_url", "quote", "source_content_hash", "quote_hash"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "pattern": "^https?://" },
        "quote": { "type": "string", "minLength": 1 },
        "source_content_hash": { "type": "string", "minLength": 1 },
        "quote_hash": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "reviewedEventClassification": {
      "type": "object",
      "required": ["reviewed_classification_id", "event_id", "decision_event_id", "entity_id", "company_name", "company_resolution", "funding_insight_id", "decision_ref", "dimension_id", "value_id", "evidence_refs", "assignment_method", "confidence", "taxonomy_version", "review_status", "status"],
      "properties": {
        "reviewed_classification_id": { "type": "string", "pattern": "^REC-" },
        "event_id": { "type": "string", "minLength": 1 },
        "decision_event_id": { "type": "string", "minLength": 1 },
        "entity_id": { "type": "string", "minLength": 1 },
        "company_name": { "type": "string", "minLength": 1 },
        "company_resolution": { "enum": ["declared_entity_exact", "declared_event_entity", "catalog_name_exact", "funding_application_entity", "reviewed_funding_entity", "reviewed_company_identity", "canonical_entity_profile_exact"] },
        "funding_insight_id": { "type": "string", "minLength": 1 },
        "decision_ref": { "type": "string", "minLength": 1 },
        "dimension_id": { "enum": ["ai_market_category", "ai_market_subcategory", "ai_market_application", "product_form", "use_case", "industry", "target_user"] },
        "value_id": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reviewedEvidenceRef" } },
        "assignment_method": { "const": "reviewed_funding_insight" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "taxonomy_version": { "const": "TAG-V4.1" },
        "review_status": { "const": "accepted" },
        "status": { "const": "active" }
      },
      "additionalProperties": false
    },
    "eventSource": {
      "type": "object",
      "required": ["event_id", "source_artifact_id"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "source_artifact_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "eventClaim": {
      "type": "object",
      "required": ["event_id", "claim_id"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "claim_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "eventConflict": {
      "type": "object",
      "required": ["conflict_id", "event_id", "field", "values", "source_refs"],
      "properties": {
        "conflict_id": { "type": "string", "minLength": 1 },
        "event_id": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "values": { "type": "array", "minItems": 2 },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": ["relationship_id", "event_id", "subject", "predicate", "object", "claim_ref", "source_refs"],
      "properties": {
        "relationship_id": { "type": "string" },
        "event_id": { "type": "string" },
        "subject": { "type": "string" },
        "predicate": { "type": "string" },
        "object": { "type": "string" },
        "claim_ref": { "type": "string" },
        "source_refs": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": false
    },
    "fdeRecord": {
      "type": "object",
      "required": ["fde_id", "event_id", "customer", "vendor", "industry", "use_case", "deployment_stage", "reported_need", "reported_delivery_components", "reported_outcomes", "undisclosed_fields", "claim_refs", "source_refs"],
      "properties": {
        "fde_id": { "type": "string" },
        "event_id": { "type": "string" },
        "customer": { "type": "string" },
        "vendor": { "type": "string" },
        "industry": { "type": "string" },
        "use_case": { "type": "string" },
        "workflow_before": { "type": "string" },
        "workflow_after": { "type": "string" },
        "deployment_stage": { "type": "string" },
        "delivery_model": { "type": "string" },
        "team_composition": { "type": "string" },
        "systems_integrated": { "type": "array" },
        "data_requirements": { "type": "array" },
        "governance_controls": { "type": "array" },
        "timeline": { "type": "string" },
        "reported_metrics": { "type": "array" },
        "metric_attribution": { "type": "string" },
        "reported_need": { "type": "string" },
        "reported_delivery_components": { "type": "array" },
        "reported_outcomes": { "type": "array" },
        "undisclosed_fields": { "type": "array" },
        "claim_refs": { "type": "array", "minItems": 1 },
        "source_refs": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": false
    },
    "fdeObservation": {
      "type": "object",
      "required": ["observation_id", "implementation_key", "observation_type", "observed_at", "customer", "vendor", "industry", "use_case", "workflow", "systems_integrated", "lifecycle_stage", "reported_outcomes", "event_refs", "claim_refs", "source_refs", "completeness"],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "implementation_key": { "type": "string", "minLength": 1 },
        "observation_type": { "enum": ["customer_case", "procurement", "contract_award", "earnings_disclosure", "production_rollout", "implementation_update"] },
        "observed_at": { "type": "string" },
        "customer": { "type": "string" },
        "vendor": { "type": "string" },
        "industry": { "type": "string" },
        "use_case": { "type": "string" },
        "workflow": { "type": "string" },
        "systems_integrated": { "type": "array" },
        "lifecycle_stage": { "type": "string" },
        "reported_outcomes": { "type": "array" },
        "event_refs": { "type": "array", "items": { "type": "string" } },
        "claim_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "completeness": {
          "type": "object",
          "required": ["resolved_fields", "total_fields", "ratio", "missing_fields"],
          "properties": {
            "resolved_fields": { "type": "integer", "minimum": 0 },
            "total_fields": { "type": "integer", "minimum": 1 },
            "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "missing_fields": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "hardwareRecord": {
      "type": "object",
      "required": ["hardware_record_id", "event_id", "hardware_event_type", "component_type", "compute_layer", "manufacturing_stage", "process_node", "capacity", "capacity_unit", "supplier", "customer", "deployment_site", "region", "contract_value", "shipment_date", "claim_refs", "source_refs"],
      "properties": {
        "hardware_record_id": { "type": "string" },
        "event_id": { "type": "string" },
        "hardware_event_type": { "type": "string" },
        "component_type": { "type": "string" },
        "compute_layer": { "type": "string" },
        "manufacturing_stage": { "type": "string" },
        "process_node": { "type": "string" },
        "capacity": { "type": ["number", "null"] },
        "capacity_unit": { "type": "string" },
        "supplier": { "type": "string" },
        "customer": { "type": "string" },
        "deployment_site": { "type": "string" },
        "region": { "type": "string" },
        "contract_value": { "type": "string" },
        "shipment_date": { "type": "string" },
        "claim_refs": { "type": "array", "minItems": 1 },
        "source_refs": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": false
    },
    "hardwareFact": {
      "type": "object",
      "required": ["hardware_fact_id", "fact_type", "observed_at", "subject_entity_id", "subject_name", "product_entity_ids", "product_names", "component_type", "metric_value", "unit", "source_quote", "event_refs", "claim_ref", "source_refs"],
      "properties": {
        "hardware_fact_id": { "type": "string", "minLength": 1 },
        "fact_type": { "enum": ["product", "specification", "oem_odm", "capacity", "supply", "shipment_deployment", "capex"] },
        "observed_at": { "type": "string" },
        "subject_entity_id": { "type": "string" },
        "subject_name": { "type": "string", "minLength": 1 },
        "product_entity_ids": { "type": "array", "items": { "type": "string" } },
        "product_names": { "type": "array", "items": { "type": "string" } },
        "component_type": { "type": "string", "minLength": 1 },
        "metric_value": { "type": "string" },
        "unit": { "type": "string" },
        "source_quote": { "type": "string", "minLength": 1 },
        "event_refs": { "type": "array", "items": { "type": "string" } },
        "claim_ref": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "hardwareSnapshot": {
      "type": "object",
      "required": ["hardware_snapshot_id", "snapshot_key", "as_of", "subject_entity_id", "subject_name", "product_entity_ids", "product_names", "component_types", "latest_values", "fact_refs", "claim_refs", "source_refs", "event_refs", "previous_snapshot_ref", "change_status"],
      "properties": {
        "hardware_snapshot_id": { "type": "string", "minLength": 1 },
