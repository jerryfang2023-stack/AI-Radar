{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wavesight.local/schemas/investment-institution-v1.schema.json",
  "title": "WaveSight Investment Institution V1",
  "type": "object",
  "required": ["meta", "institutions"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema_version", "generated_at", "source_contract", "institution_count", "evidence_backed_count", "current_round_activity_count", "individual_investor_count", "boundary"],
      "properties": {
        "schema_version": { "const": "INVESTMENT-INSTITUTION-V1.0" },
        "generated_at": { "type": "string" },
        "source_contract": { "const": "FUNDING-INSIGHT-V1.3" },
        "institution_count": { "type": "integer", "minimum": 0 },
        "evidence_backed_count": { "type": "integer", "minimum": 0 },
        "current_round_activity_count": { "type": "integer", "minimum": 0 },
        "individual_investor_count": { "type": "integer", "minimum": 0 },
        "boundary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "institutions": {
      "type": "array",
      "items": { "$ref": "#/$defs/institution" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "normalizedAmount": {
      "type": ["object", "null"],
      "required": ["currency", "value", "min_value", "max_value", "unit", "status", "display_zh"],
      "properties": {
        "currency": { "type": "string" },
        "value": { "type": ["number", "null"] },
        "min_value": { "type": ["number", "null"] },
        "max_value": { "type": ["number", "null"] },
        "unit": { "const": "base" },
        "status": { "enum": ["exact", "approximate", "lower_bound", "range", "undisclosed", "unparsed"] },
        "display_zh": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["source_id", "source_url", "source_title", "source_content_hash", "quote", "quote_hash"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://", "minLength": 1 },
        "source_title": { "type": "string" },
        "source_content_hash": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" },
        "quote": { "type": "string", "minLength": 1 },
        "quote_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "required": ["activity_id", "funding_insight_id", "event_ids", "company_entity_id", "company_canonical_entity_id", "company_name", "round", "round_code", "round_original", "amount_original", "amount_normalized", "announced_at", "market_region", "china_market_match", "disclosure_status", "scope", "role", "role_code", "evidence"],
      "properties": {
        "activity_id": { "type": "string", "minLength": 1 },
        "funding_insight_id": { "type": "string", "minLength": 1 },
        "event_ids": { "type": "array", "items": { "type": "string" } },
        "company_entity_id": { "type": "string" },
        "company_canonical_entity_id": { "type": "string" },
        "company_name": { "type": "string", "minLength": 1 },
        "round": { "type": "string" },
        "round_code": { "type": "string" },
        "round_original": { "type": "string" },
        "amount_original": { "type": "string" },
        "amount_normalized": { "$ref": "#/$defs/normalizedAmount" },
        "announced_at": { "type": "string" },
        "market_region": { "enum": ["CN", "GLOBAL"] },
        "china_market_match": { "type": "boolean" },
        "disclosure_status": { "enum": ["disclosed", "partially_disclosed", "not_disclosed", "unknown"] },
        "scope": { "enum": ["current_round", "historical_or_ambiguous"] },
        "role": { "type": "string" },
        "role_code": { "enum": ["lead", "co_lead", "participant", "other_current_round", "historical_or_ambiguous"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      },
      "additionalProperties": false
    },
    "institution": {
      "type": "object",
      "required": ["id", "name", "aliases", "canonical_entity_id", "investor_kind", "investor_kind_label", "classification_confidence", "collection_status", "current_round_count", "historical_or_ambiguous_count", "portfolio_company_count", "market_regions", "china_market_activity_count", "china_market_company_count", "first_disclosed_at", "latest_disclosed_at", "role_counts", "round_codes", "portfolio_companies", "activities", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^INV-" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "canonical_entity_id": { "type": ["string", "null"] },
        "investor_kind": { "enum": ["investment_institution", "government_fund", "corporate_investor", "individual", "unverified_investor"] },
        "investor_kind_label": { "type": "string", "minLength": 1 },
        "classification_confidence": { "enum": ["evidence_bounded", "unverified"] },
        "collection_status": { "enum": ["evidence_backed", "partial"] },
        "current_round_count": { "type": "integer", "minimum": 0 },
        "historical_or_ambiguous_count": { "type": "integer", "minimum": 0 },
        "portfolio_company_count": { "type": "integer", "minimum": 0 },
        "market_regions": { "type": "array", "minItems": 1, "items": { "enum": ["CN", "GLOBAL"] } },
        "china_market_activity_count": { "type": "integer", "minimum": 0 },
        "china_market_company_count": { "type": "integer", "minimum": 0 },
        "first_disclosed_at": { "type": "string" },
        "latest_disclosed_at": { "type": "string" },
        "role_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "round_codes": { "type": "array", "items": { "type": "string" } },
        "portfolio_companies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity_id", "canonical_entity_id", "name"],
            "properties": {
              "entity_id": { "type": "string" },
              "canonical_entity_id": { "type": "string" },
              "name": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "activities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/activity" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      },
      "additionalProperties": false
    }
  }
}
