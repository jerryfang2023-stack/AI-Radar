[Unit]
Description=Guanlan financing cloud daily supervisor and recovery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=guanlan-financing
Group=guanlan-financing
WorkingDirectory=/srv/guanlan-financing/WaveSight
EnvironmentFile=/etc/guanlan-financing/runtime.env
ExecStart=/opt/guanlan-financing-tools/run.sh --watch=true
UMask=0077
TimeoutStartSec=6h
# Full-catalog publication exceeded the former 1600M cgroup ceiling.
# Keep a bounded budget while leaving headroom on the 4 GB VPS.
MemoryMax=2800M
CPUQuota=100%
PrivateTmp=false
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.guanlan-runtime
StandardOutput=append:/srv/guanlan-financing/runtime/supervisor.log
StandardError=append:/srv/guanlan-financing/runtime/supervisor.log

[Install]
WantedBy=multi-user.target
