  "rules": {
    "primary_sector": "一个主营赛道，一个细分赛道；多产品公司依据当前已交付业务和融资主体判定。",
    "scope": "排除具身智能、机器人本体和机器人核心部件主营企业，保留消费 AI 硬件。",
    "evidence": "所有分类必须引用卡片已验证的公司或产品原文证据；不能根据投资方、单个客户、技术关键词、旧标签推定。",
    "uncertainty": "证据不足保留待分类；不把未知强制塞进通用行业。",
    "finance_fields": "轮次、融资金额、估值、地区、披露日期是结构字段，不是标签。",
    "retired": "FDE、部署方式、硬件性能/供应链事实、MCP/RAG/推理能力等旧技术标签不进入当前融资筛选；机器人类不进入本融资目录。"
  }
