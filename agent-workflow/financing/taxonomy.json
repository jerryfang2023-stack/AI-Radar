{
  "version": "AI-FUNDING-TAGS-1.0",
  "effective_date": "2026-10-01",
  "purpose": "帮助创业者按主营业务查找 AI 企业融资；融资事件事实与企业分类分开。",
  "sources": [
    {
      "name": "Dealroom Tech Sector Taxonomy",
      "url": "https://dealroom.co/our-data/taxonomy/",
      "use": "行业、技术、客户、商业模式分维度；本体系采用业务分类与筛选维度分离原则。"
    },
    {
      "name": "Crunchbase Glossary of Industries",
      "url": "https://support.crunchbase.com/hc/en-us/articles/27690673553555-Glossary-of-Industries",
      "use": "区分基础模型与 AI 应用；参考公开行业定义，不复制数据库。"
    },
    {
      "name": "PitchBook AI & ML Report Q1 2023",
      "url": "https://files.pitchbook.com/website/files/pdf/Q1_2023_Artificial_Intelligence_Machine_Learning_Report_13959.pdf",
      "use": "基础设施与应用分层方法；细分按当前融资业务范围自主设计。"
    }
  ],
  "sectors": [
    {
      "id": "models",
      "name": "基础模型",
      "en": "Foundation models",
      "definition": "训练并提供通用或专用基础模型；不包括仅调用模型的应用。",
      "subsectors": [
        {
          "id": "general-models",
          "name": "通用与多模态模型"
        },
        {
          "id": "specialist-models",
          "name": "专用模型与科学模型"
        },
        {
          "id": "media-models",
          "name": "语音、图像与视频模型"
        }
      ]
    },
    {
      "id": "compute",
      "name": "AI 算力与芯片",
      "en": "AI compute & chips",
      "definition": "为 AI 训练或推理提供计算资源和芯片；排除机器人专用执行部件。",
      "subsectors": [
        {
          "id": "ai-chips",
          "name": "AI 芯片与加速器"
        },
        {
          "id": "compute-systems",
