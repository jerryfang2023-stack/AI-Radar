      "sources": [
        {
          "source_id": "corazon_update",
          "source_url": "https://www.corazon.com/update",
          "source_title": "Update | Corazon Capital",
          "source_content_hash": "dad7e5bb82a9f55768bbabcb2b3b0f9dd470f47d9dee1ce64f8afc2f5616707e",
          "quote": "Corazon Capital today announced the final close of its fourth fund at $100 million. Fund IV will invest at the pre-seed, seed, and series A stages, with an emphasis on AI-native companies built around enduring human behaviors.",
          "quote_hash": "1a9f4690e3b0f96cd7a737825247fc2f4c9c457e3fbe510036c455b10f8323a3"
        },
        {
          "source_id": "corazon_focus",
          "source_url": "https://www.corazon.com/update",
          "source_title": "Update | Corazon Capital",
          "source_content_hash": "dad7e5bb82a9f55768bbabcb2b3b0f9dd470f47d9dee1ce64f8afc2f5616707e",
          "quote": "Fund IV reflects the firm’s continued commitment to partnering closely with founders leveraging innovation to transform how humans learn, connect, transact, work, and live.",
          "quote_hash": "f1cca56f837a96b0d121afdd62a16815913d3532c6bca962066c9cca5fcac656"
        },
        {
          "source_id": "corazon_companies",
          "source_url": "https://www.corazon.com/update",
          "source_title": "Update | Corazon Capital",
          "source_content_hash": "dad7e5bb82a9f55768bbabcb2b3b0f9dd470f47d9dee1ce64f8afc2f5616707e",
          "quote": "Led by the team that built and ran category-defining consumer platforms including SparkNotes, OkCupid, Match, Tinder, ShopRunner, and Grindr.",
          "quote_hash": "b4473811d402240090a95a35068462269f3ea28acededf40ac797872b7fbd10f"
        },
        {
          "source_id": "corazon_geography",
          "source_url": "https://www.corazon.com/update",
          "source_title": "Update | Corazon Capital",
          "source_content_hash": "dad7e5bb82a9f55768bbabcb2b3b0f9dd470f47d9dee1ce64f8afc2f5616707e",
          "quote": "Corazon invests nationally and backs ubiquitous, market-leading consumer companies such as SpotHero and PrettyLitter, scaled unicorns such as Telnyx and TradingView, and next-generation platforms including Brilliant and Noble Mobile. As its portfolio has grown, Corazon has expanded beyond its Chicago roots with investors based in Los Angeles, San Francisco, and New York, creating a unique geographic footprint that mirrors its portfolio’s national reach.",
          "quote_hash": "f0ec46cb76b7c2dc18665950a9b5f18a52588d478ccbffd0b4e63d9443149997"
        },
        {
          "source_id": "corazon_phil",
          "source_url": "https://www.corazon.com/update",
          "source_title": "Update | Corazon Capital",
          "source_content_hash": "dad7e5bb82a9f55768bbabcb2b3b0f9dd470f47d9dee1ce64f8afc2f5616707e",
          "quote": "Phil Schwarz, managing partner at Corazon.",
          "quote_hash": "698810e756038da701051f9acca45c5228c8946a79b336824317e83d164a1508"
        },
        {
          "source_id": "corazon_promotions",
          "source_url": "https://www.corazon.com/update",
          "source_title": "Update | Corazon Capital",
          "source_content_hash": "dad7e5bb82a9f55768bbabcb2b3b0f9dd470f47d9dee1ce64f8afc2f5616707e",
          "quote": "Corazon promoted Greg Johnston and Smriti Jayaraman, both formerly principals at the firm, to partner. Corazon also named Alison Stillman, formerly founding partner at Serena Ventures and more recently a venture partner at Corazon, to partner.",
          "quote_hash": "c72d0e298d943da73167829bcb31eee6dea0c5c3218eaf14367a61e579653d07"
        },
        {
          "source_id": "corazon_sam",
          "source_url": "https://www.corazon.com/team",
          "source_title": "Team | Corazon Capital",
          "source_content_hash": "316ef2062c0ff926024cf2adedcc3af52a54f602a75ca53bac60d9fea0917c2b",
          "quote": "Co-Founder & Managing Partner, Corazon Capital",
          "quote_hash": "f4d66214d478c5a5dec623737270681a0c4bb8201294499b0d4047bf417b35b3"
        },
        {
          "source_id": "corazon_sam_career",
          "source_url": "https://www.corazon.com/team",
          "source_title": "Team | Corazon Capital",
          "source_content_hash": "316ef2062c0ff926024cf2adedcc3af52a54f602a75ca53bac60d9fea0917c2b",
          "quote": "He also co-founded OkCupid, which he led as its CEO through its sale to Match Group in 2011.",
          "quote_hash": "8ec42deee0a37daaa7883b5a8df1d4d0ed8b33a876b8ffead36381082ba04317"
        },
        {
          "source_id": "corazon_sam_shoprunner",
          "source_url": "https://www.corazon.com/team",
          "source_title": "Team | Corazon Capital",
          "source_content_hash": "316ef2062c0ff926024cf2adedcc3af52a54f602a75ca53bac60d9fea0917c2b",
          "quote": "He recently served as the Chief Executive Officer of ShopRunner, Inc., an ecommerce enablement platform; in 2020, he led the sale of ShopRunner to FedEx Corp. (NYSE: FDX).",
          "quote_hash": "535e4193d6a7c399735bf1b75efd5cfea06c1879a5b696a064065bb613c6b02a"
        },
        {
          "source_id": "corazon_sam_education",
          "source_url": "https://www.corazon.com/team",
          "source_title": "Team | Corazon Capital",
          "source_content_hash": "316ef2062c0ff926024cf2adedcc3af52a54f602a75ca53bac60d9fea0917c2b",
          "quote": "Sam has a BA with honors in Applied Mathematics and Economics from Harvard College and an MBA from the Stanford Graduate School of Business.",
          "quote_hash": "a0aebde672038c96df720cc5a38f9fc55241b8d6a3a78d7702a36fc78beb0e52"
        },
        {
          "source_id": "corazon_steve",
          "source_url": "https://www.corazon.com/team",
          "source_title": "Team | Corazon Capital",
          "source_content_hash": "316ef2062c0ff926024cf2adedcc3af52a54f602a75ca53bac60d9fea0917c2b",
          "quote": "Steve co-founded Corazon Capital.",
          "quote_hash": "fa58012512f2499fd530f083108bcf84b8b49979f186b3b32e76fbab4617ac24"
        },
        {
          "source_id": "corazon_steve_career",
          "source_url": "https://www.corazon.com/team",
          "source_title": "Team | Corazon Capital",
          "source_content_hash": "316ef2062c0ff926024cf2adedcc3af52a54f602a75ca53bac60d9fea0917c2b",
          "quote": "Steve co-founded Corazon Capital. He was a Board Member of Techstars Chicago and co-managed the program in 2013 and 2014. Steve was Chief Operating Officer of Tap.Me, which was sold to MediaMath in 2012. Previously, Steve was a General Partner with Norwest Equity Partners. Over his 9 years with the firm, Steve invested $280 million of equity in 13 management buyouts and growth capital investments across a variety of industries.",
          "quote_hash": "b5a402df3a6174bccf62625b1e930092b2b60fe1fe960293123c5f4080f339d7"
        },
        {
          "source_id": "corazon_steve_education",
          "source_url": "https://www.corazon.com/team",
          "source_title": "Team | Corazon Capital",
          "source_content_hash": "316ef2062c0ff926024cf2adedcc3af52a54f602a75ca53bac60d9fea0917c2b",
          "quote": "Steve was a lecturer of Entrepreneurship and Innovation at Northwestern's Kellogg School of Management where he also received his MBA. Steve has a bachelor's degree in accounting from the University of Wisconsin - Madison.",
          "quote_hash": "9e7f1f0b728bbe7d3195243b5a439c90c7167e2c320f67f8d0bdf3970cfe95f2"
        },
        {
          "source_id": "corazon_contact",
          "source_url": "https://www.corazon.com/update",
          "source_title": "Update | Corazon Capital",
          "source_content_hash": "dad7e5bb82a9f55768bbabcb2b3b0f9dd470f47d9dee1ce64f8afc2f5616707e",
          "quote": "Media inquiries: corazonpr@corazon.com 312-798-9379",
          "quote_hash": "9460933b68630e01ca387e4857ae9cb464251a9eade2157868392aa9515b2d80"
        },
        {
          "source_id": "corazon_general",
