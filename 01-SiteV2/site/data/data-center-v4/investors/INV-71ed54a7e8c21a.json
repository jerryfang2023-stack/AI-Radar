      "contacts": [],
      "sources": [
        {
          "source_id": "FISRC-ed4f088f02c38455",
          "source_url": "https://finance.sina.com.cn/tech/roll/2026-08-31/doc-iniqexup7868136.shtml",
          "source_title": "OpenCSG完成数亿元Pre-A轮融资_新浪科技_新浪网",
          "source_content_hash": "bbacedd17cd7918ac59cb4abbe0d3d74dd41877f7a6ecb935b548c79dba198af",
          "quote": "CSG完成数亿元Pre-A轮融资 OpenCSG完成数亿元Pre-A轮融资 2026年08月31日 15:29 投中网 新浪财经APP 缩小字体 放大字体 收藏 微博 微信 分享 腾讯QQ QQ空间 本轮融资由静安资本、市北高新、徐汇资本、黄海金控等共同参与。此前，OpenCSG已获得联想创投、北京国信中数、中科升哲等机构投资。 近日，开放传神（OpenCSG）宣布完成数亿元人民币Pre-A轮融资，投后估值迈入独角兽级别。本轮融资由静安资本、市北高新、徐汇资本、黄海金控等共同参与。此前，OpenCSG已获得联想创投、北京国信中数、中科升哲等机构投资。 本轮融资完成后，OpenCSG将进一步加大在开源AI基础设施、Agentic AI平台、全球开发者生态及城市级AI基础设施",
          "quote_hash": "0047127bc9aa95e7f1f436f186a6512c8361156cb1698fe47340a798d9c7f941"
        },
        {
          "source_id": "FISRC-6acf14b7549af590",
          "source_url": "https://www.36kr.com/p/3974730056757511",
          "source_title": "头部智能眼镜品牌完成近10亿C轮融资，已正式启动上市筹备工作｜硬氪首发-36氪",
          "source_content_hash": "738942f456c4ccf0cf6c87000aa892da7cc7f31ab6db2af12f295bc98490e489",
          "quote": "氪首发 黄 楠 · 2026年09月09日 09:00 近年来影目科技营收增速连续保持200%以上。 作者｜黄楠 编辑｜袁斯来 硬氪获悉，全球智能眼镜品牌「影目科技」近日完成C3轮融资，由四川振兴科创基金领投，静安资本、市北高新、广州产投、四川中试、眉山中试及东坡国投跟投。继年初完成C1、C2轮融资后，公司C轮融资累计金额近10亿元。 本轮资金将主要用于新一代空间智能硬件产品线的研发落地，及INMO AIOS 系统的持续迭代升级，加强硬件与软件底层核心能力构建；同时，加大品牌建设与全渠道布局，完善商业化能力，推动产品破圈，实现业务加速增长。 目前，影目科技已正式启动上市筹备工作，近年来公司营收增速连续保持200%以上。 智能眼镜正在被推向消费电子领域最受关注的位置。IDC",
          "quote_hash": "f70d3b7110ee5ecc7cddd9c644c1cee31117bca348cf0a31d7e1e954cbec10bb"
        }
      ],
