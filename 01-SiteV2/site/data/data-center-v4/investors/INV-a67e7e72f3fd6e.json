      "sources": [
        {
          "source_id": "step_group_about_2010",
          "source_url": "https://www.stepholdings.com/about.html",
          "source_title": "创业接力集团｜关于我们",
          "source_content_hash": "dc84fd13d87ef8b5d2930c88e793032e1a6eae37a496a264c61675404996b361",
          "quote": "上海创业接力科技金融集团有限公司（简称\"创业接力集团\"）成立于2010年。创业接力集团以“专注科技创业，接力企业成长”为使命，建立了以基金投资管理、金融创新服务、科创服务平台三大主营业务为核心的早期科创企业服务生态。",
          "quote_hash": "821eb6f380fd7aabab2d011402366e091b5f18e7f0d453ff4a54a2b9a1e7d918"
        },
        {
          "source_id": "step_group_contacts",
          "source_url": "https://www.stepholdings.com/about.html",
          "source_title": "创业接力集团｜关于我们",
          "source_content_hash": "dc84fd13d87ef8b5d2930c88e793032e1a6eae37a496a264c61675404996b361",
          "quote": "step@stepholdings.com；021-5523 5596；021-5523 8610；上海市杨浦区伟成路70号1号楼3楼。",
          "quote_hash": "a69597af1a83f46792e45023cd02b714b5795f6e564dd4a2882d1149d3b79c4a"
        },
        {
          "source_id": "step_group_angel_operator",
          "source_url": "https://www.stepholdings.com/product.html?cid1=72339069014638592&cid2=72340168526266368",
          "source_title": "创业接力集团｜业务布局：接力资本",
          "source_content_hash": "3fa0856b98b90bd7dd3c7607c1e3f731aa59c854d26ceaf1099a7db5c2c778bc",
          "quote": "接力资本是创业接力集团受托管理“上海市天使投资引导基金”（简称“天使引导基金”）的业务经营主体，以多产品组合，开展早期科技创业投资孵化业务。",
          "quote_hash": "ff3352e155e4549286d971aef65c8f9613fcc5928dbe51e2af1ec0d888639fbb"
        },
        {
          "source_id": "step_group_angel_metrics",
          "source_url": "https://www.stepholdings.com/product.html?cid1=72339069014638592&cid2=72340168526266368",
          "source_title": "创业接力集团｜业务布局：接力资本",
          "source_content_hash": "3fa0856b98b90bd7dd3c7607c1e3f731aa59c854d26ceaf1099a7db5c2c778bc",
          "quote": "天使引导基金自2014年成立以来，根据“优化区域创新创业生态、培育早期科创企业”的政策定位，以“政府引导社会资本共担创新风险，共享创新成果”为引导本质，发挥政府资金的杠杆效应和引领作用，杠杆更多社会资本投早、投小、投科技。一期管理规模35亿，过会基金145家，资金放大5倍。",
          "quote_hash": "70343fdda1b1a6f1f3eacef2a5dd2c85ae2d6874a904d72e901cfd19158dbeeb"
        },
        {
          "source_id": "step_group_fof_strategy",
          "source_url": "https://www.stepholdings.com/product.html?cid1=72339069014638592&cid2=72340168526266368",
          "source_title": "创业接力集团｜业务布局：接力资本",
          "source_content_hash": "3fa0856b98b90bd7dd3c7607c1e3f731aa59c854d26ceaf1099a7db5c2c778bc",
          "quote": "综合母基金专注于投资标签鲜明的早期股权基金。参与青松基金、礼来亚洲、钟鼎基金、金沙江创投等多家知名投资机构。结合接力资本旗下直投基金等多产品组合，实行PSD（母基金、直投、S基金）投资策略。",
          "quote_hash": "01d9a7246bfd7b509508cd7091d65ca9c7f7a7dba1e25ff446732a74accde9d2"
        },
        {
          "source_id": "step_angel_fund_contacts",
          "source_url": "https://www.stepholdings.com/product.html?cid1=72339069014638592&cid2=72340168526266368",
          "source_title": "创业接力集团｜业务布局：接力资本",
          "source_content_hash": "3fa0856b98b90bd7dd3c7607c1e3f731aa59c854d26ceaf1099a7db5c2c778bc",
          "quote": "联系方式：021-55238613；apply@sacgfund.org；官网：http://www.sacgfund.org.cn",
          "quote_hash": "dd43c7d33143933ac8284fd7b8fb245ca04b3343c031160e0245af3165723cf2"
        },
