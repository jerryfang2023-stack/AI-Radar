        {
          "field": "team_background",
          "label": "Luke Alvarez 履历",
          "value": "官网称其有 33 年科技行业经验，曾共同创立在 Nasdaq 上市的 Inspired Entertainment 和英国公共 Wi-Fi 运营商 The Cloud，曾任 Boston Consulting Group 顾问；为剑桥大学毕业生及 Fulbright 学者，负责公司战略并参与 AI、长寿、体育和深科技投资。",
          "source_id": "hiro_team"
        },
        {
          "field": "team_background",
          "label": "Sir Nick Clegg 履历",
          "value": "官网将其列为普通合伙人；曾任英国副首相（2010–2015）、Meta 全球事务总裁（2018–2025），此前在欧洲议会及欧盟机构任职约十年。",
          "source_id": "hiro_team"
        },
        {
          "field": "team_background",
          "label": "Cherry Freeman 履历",
          "value": "共同创立手工艺品电商 LoveCrafts，该公司后被美国战略买家收购；曾任 Boston Consulting Group 顾问及 Computacenter 集团战略总监，负责扩展软件业务；为剑桥大学毕业生。",
          "source_id": "hiro_team"
        },
        {
          "field": "team_background",
          "label": "Sir Ian Livingstone 履历",
          "value": "游戏产业创业者，曾共同创立 Games Workshop 与 Eidos（《古墓丽影》）；获 CBE、2022 年骑士爵位及 BAFTA 终身成就奖。",
          "source_id": "hiro_team"
        },
        {
          "field": "team_background",
          "label": "其他投资团队成员",
          "value": "Spike Laurie 负责太空、国防与游戏投资，曾在 ESL 任领导职务；Beth Li 负责亚洲业务，拥有 22 年咨询、战略及跨境科技市场经验，曾任职 JP Morgan 并创立 BML Consulting。",
