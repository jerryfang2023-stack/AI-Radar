        {
          "field": "geography_and_check_size",
          "label": "投资地域与规模",
          "value": "主要投资欧洲科技公司；初始投资通常为 100 万至 700 万欧元，按多轮投资后对单家组合公司最多可投资 2500 万欧元。",
          "source_id": "otb_about"
        },
        {
          "field": "leadership_adam_niewinski",
          "label": "联合创始人 Adam Niewiński 履历与关联公司",
          "value": "官网简介称其有 20 多年创业及高级经营管理经验、十年以上投资经验；曾任 Boston Consulting Group 顾问，创办 Expander、Platinum Bank，担任 UniCredit 集团创业公司 Xelion CEO，并任 PEKAO 副 CEO。官网还列出其参与 ICEYE、Silent Eight、KYP.ai、Hydrosat 与 FintechOS 董事会。",
          "source_id": "otb_adam"
        },
        {
          "field": "leadership_marcin_hejka",
          "label": "联合创始人 Marcin Hejka 履历与关联公司",
          "value": "创办 OTB 前在 Intel Capital 工作 18 年，曾任 VP、全球投资委员会成员及管理董事，负责欧洲、以色列、中东、非洲与印度；官网称其完成 50 多笔投资与退出，其中包括五家独角兽或十角兽公司。其 OTB 组合董事会关联包括 Apheris、Plumerai 与 MatrixSpace，已退出案例包括 BabbleLabs 与 Minit。",
          "source_id": "otb_marcin"
        },
