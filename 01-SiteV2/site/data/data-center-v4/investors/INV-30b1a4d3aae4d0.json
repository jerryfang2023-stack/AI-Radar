    "public_profile": {
      "profile_type": "organization",
      "identity_status": "verified",
      "coverage_status": "researched",
      "coverage_note": "“龙岗引导基金”是政策基金体系的常用简称，融资来源没有指出具体基金法律主体或子基金，因此不把基金运营方龙岗金控等同于该笔直接出资实体。2026年政府报道的规模与投资成果为引导基金及其子基金合并口径。尚未找到经核验、现行且专用于项目申报的公开联系方式。",
      "summary": "融资数据库中的“龙岗引导基金”可与龙岗区政策性投资引导基金对应。它是区级政府投资基金体系，通过与专业创投机构合作设立子基金，撬动社会资本支持龙岗产业；深圳市龙岗区人民政府2026年披露其合作子基金38支、总规模约998.55亿元，近三年布局半导体、人工智能、生物医药和机器人等方向。",
      "facts": [
        {
          "field": "fund_identity",
          "label": "基金身份",
          "value": "区级政策性投资引导基金体系；融资数据库简称“龙岗引导基金”未指明某一只子基金或法律出资主体。",
          "source_id": "lg_fund_framework"
        },
        {
          "field": "policy_sponsor",
          "label": "出资与政策定位",
          "value": "由龙岗区人民政府出资，按照市场化方式运作，发挥财政资金引导作用，重点支持创新型中小企业和战略性新兴产业。",
          "source_id": "lg_fund_framework"
        },
        {
          "field": "manager",
          "label": "运营管理主体（2026年政府披露）",
          "value": "龙岗金融投资控股有限公司（龙岗金控）。管理主体与各笔融资记录中的直接法律出资主体应分别核对。",
          "source_id": "lg_fund_2026_scale"
        },
        {
          "field": "subfunds",
