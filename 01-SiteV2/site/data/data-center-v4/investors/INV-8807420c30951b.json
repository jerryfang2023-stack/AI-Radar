      "sources": [
        {
          "source_id": "hongshan_contact",
          "source_url": "https://www.hongshan.com/about-us/",
          "source_title": "关于我们｜红杉中国",
          "source_content_hash": "686788d69b2f85c745161c3f9035e1abab4efdb9e1688355e2d316c9ca3bc672",
