    "public_profile": {
      "summary": "陈宇森是网络安全创业者，浙江大学计算机科学与技术专业毕业，曾为美国西北大学访问学者。大学期间组建浙大 AAA 战队，后加入蓝莲花战队，并在 2014 年与队友联合创办长亭科技，担任 CEO、负责商业拓展。2017 年入选《福布斯》中国 30 位 30 岁以下精英。此履历依据 2015—2018 年公开报道，反映历史任职；不据此推断其当前职位。",
      "current_roles": [],
      "career": [
        {
          "organization": "长亭科技",
          "title": "联合创始人、CEO",
          "period": "2014—至少 2018 年（报道时）",
          "description": "与蓝莲花战队队友共同创办网络安全公司；早期负责商业拓展并推动安全产品和服务商业化。2018 年报道仍称其为 CEO；本资料不代表其现任该职。",
          "source_id": "chen_yusen_profile"
        },
        {
          "organization": "蓝莲花（Blue-Lotus）网络安全战队",
          "title": "战队成员",
          "period": "大学期间至创业前后",
          "description": "参与国内外攻防竞赛。媒体对其战队经历的报道记载，蓝莲花战队于 2013 年参加 DEF CON CTF 并获得全球第 11 名。",
          "source_id": "chen_yusen_profile"
