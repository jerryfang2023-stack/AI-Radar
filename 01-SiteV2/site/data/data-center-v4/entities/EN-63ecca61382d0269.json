          "organization": "它石智航（TARS）",
          "source_id": "ding_fudan"
        }
      ],
      "career": [
        {
          "organization": "华为车 BU（智能汽车解决方案 BU）",
          "title": "预测领域技术专家",
          "period": "2020—2023",
          "description": "参与华为 ADS 1.0 与 ADS 2.0 智能驾驶系统研发，研究预测决策耦合算法并推动技术在量产车型应用。",
          "source_id": "ding_fudan"
        },
        {
          "organization": "复旦大学智能机器人与先进制造创新学院",
