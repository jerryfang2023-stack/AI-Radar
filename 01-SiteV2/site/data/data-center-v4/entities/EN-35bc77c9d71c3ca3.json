        }
      ],
      "career": [
        {
          "organization": "清华大学自动化系",
          "title": "博士后研究人员",
          "period": "2019年至2021年",
          "description": "中国科学院大学讲座报道的科研经历。",
          "source_id": "zheng_zheng_ucas_2026"
        },
        {
          "organization": "极佳视界",
          "title": "联合创始人、首席科学家",
          "period": "公开报道于2026年记录；起始年份未披露",
          "description": "负责世界模型及具身基础模型相关研究与技术工作；当前头衔由公开报道支持。",
          "source_id": "FISRC-a1fb846b5355af64"
        }
      ],
      "education": [
        {
          "institution": "中国科学院自动化研究所",
          "qualification": "博士；2019年毕业",
          "source_id": "zheng_zheng_ucas_2026"
        }
      ],
      "experience_summary": "公开高校讲座材料记载其在视觉跟踪、自动驾驶感知与世界模型方向的研究经历，并报道了在清华大学自动化系开展博士后研究。该材料未披露博士专业细目、博士后之后的完整任职时间线。",
      "track_record": [
        {
          "description": "高校讲座人物介绍称其发表论文70余篇、引用逾1.9万次，并连续4年入选全球前2%顶尖科学家；这些为来源页面截至发布时的统计口径。",
          "source_id": "zheng_zheng_ucas_2026"
        },
        {
          "description": "同一人物介绍列出SiamRPN、DaSiamRPN、BEVDet、WebFace260M等代表成果，并称部分研究被集成进OpenCV、产业方案或科研机构采用。",
          "source_id": "zheng_zheng_ucas_2026"
        },
        {
          "description": "中国科学院大学报道朱政介绍极佳视界的GigaBrain、GigaWorld与DriveDreamer系列研究；产品成果归属公司团队，不等同于个人单独成果。",
          "source_id": "zheng_zheng_ucas_2026"
        }
      ],
