          "bundle_path": "01-SiteV2/content/11-databases/data-center-v4/2026-08-24/hardware-facts.json"
        },
        {
          "data_date": "2026-08-24",
          "hardware_fact_id": "HWF-2dea33c8aa1c0eda",
          "fact_type": "shipment_deployment",
