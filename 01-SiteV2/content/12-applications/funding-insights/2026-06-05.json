      "products": [
        {
          "name": "Archestra 平台",
          "description": "一个开源、自托管的控制平面，作为 AI 智能体与企业数据之间的中间层，提供身份与策略检查、数据访问代理、审计日志、确定性护栏、成本优化和可观测性。支持 Claude、ChatGPT、Gemini 及开源模型，连接器覆盖 Jira、Confluence、GitHub、Notion、SharePoint、Google Drive 和 Salesforce。",
          "target_customers": "拥有内部 AI 团队、需要将 AI 智能体安全接入敏感企业数据的大型企业，尤其是法律、采购、管理和运营部门。",
          "features": [
            "确定性护栏防止数据泄露",
            "基于 RBAC 和凭证隔离的治理",
            "完整的审计追踪",
            "成本优化层，可将推理账单削减高达 96%",
            "内置 RAG，含分块、嵌入、混合搜索和重排序",
            "私有 MCP 注册表，可管理、版本化和回滚 MCP 服务器",
            "支持 OpenTelemetry 追踪和 Prometheus 指标导出",
            "自托管于 Kubernetes，提供 Helm chart 和 Terraform provider"
          ],
          "evidence_refs": [
            {
              "source_id": "FISRC-2226010f84adae92",
              "quote": "Archestra acts as a middle layer between the agent and the data. The agent calls Archestra, which checks identity and policy, brokers the actual data access and logs the result."
            },
            {
              "source_id": "FISRC-2226010f84adae92",
              "quote": "The guardrails are pitched as protection against the combination of access to private data, exposure to untrusted content and the ability to communicate externally"
            },
            {
              "source_id": "FISRC-2226010f84adae92",
              "quote": "A cost-optimization layer tracks spending per team, agent or organization and can route simpler queries to cheaper models, which Archestra claims can cut inference bills by as much as 96%."
            }
          ],
          "entity_id": null
        }
