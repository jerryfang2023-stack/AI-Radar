      "products": [
        {
          "name": "Centralize",
          "description": "一个企业销售平台，通过 AI 代理分析第一方数据、通话记录、邮件、日历事件和网络来源，持续构建关键关系的实时图谱，充当收入团队的“交易 GPS”。",
          "target_customers": "企业收入团队，包括客户经理、销售开发代表和客户成功经理",
          "features": [
            "自动生成组织架构图并可视化关键利益相关者关系",
            "AI 助手 Centra 可回答“谁掌握预算？”或“如何接触 CRO？”等问题",
            "主动标记关键拥护者离职、新决策者加入或关键交易参与度下降",
            "通过共同联系人、过往公司重叠等识别潜在切入点",
            "支持无限席位的“管理账户”定价模式"
          ],
          "evidence_refs": [
            {
              "source_id": "FISRC-0232cca5ca9bf922",
              "quote": "Centralize operates as a visual, multiplayer surface centered around automated org charts that function like a map. AI agents analyze first-party data, call recordings, emails, calendar events, and web sources to continuously construct a live picture of key relationships.",
              "source_content_hash": "71082c4f5d29c731",
              "quote_hash": "4443cb4c03ea102b228cae21903d55d20d5b8c7b483fc80df3a4efba4384796a"
            },
            {
              "source_id": "FISRC-0232cca5ca9bf922",
              "quote": "It also flags the moment a champion leaves, a new decision-maker joins, or engagement drops on a key deal.",
              "source_content_hash": "71082c4f5d29c731",
              "quote_hash": "f07806d09ab34c1db689c1522fb6bf4546326963ba9eef09104ef2e57a52f7c2"
            },
            {
              "source_id": "FISRC-0232cca5ca9bf922",
              "quote": "the platform also identifies warm entry points through mutual connections or past company overlaps.",
              "source_content_hash": "71082c4f5d29c731",
              "quote_hash": "366ead6d8b6ac6a550a776d9990fbd3113aa295c9cd33de0890e2b3423a96619"
            }
          ],
