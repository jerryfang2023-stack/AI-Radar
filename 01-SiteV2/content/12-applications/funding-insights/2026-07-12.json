      "products": [
        {
          "name": "AI网络全栈组合（硅、系统、软件）",
          "description": "通过统一的开放标准AI架构，将加速器、内存和存储连接成单一高性能AI引擎，专为消除大规模同步AI工作负载（包括前沿模型的训练和推理）中的网络瓶颈而构建。",
          "target_customers": "超大规模云服务商和领先的新云基础设施提供商",
          "features": [
            "全栈组合涵盖硅、系统和软件",
            "统一开放标准AI架构",
            "消除大规模同步AI工作负载的网络瓶颈"
          ],
          "evidence_refs": [
            {
              "source_id": "FISRC-7dcdc22c0b1702bf",
              "quote": "Upscale AI is reimagining networking for the AI era with a full-stack portfolio spanning silicon, systems, and software. Through a unified, open-standard AI fabric, the company connects accelerators, memory, and storage into a single high-performance AI engine purpose-built to eliminate network bottlenecks across large-scale, synchronized AI workloads, including training and inference of frontier models.",
              "source_content_hash": "23145edb5fdd8d69",
              "quote_hash": "b6c770326b2dd8c62e475e9091de749cdfb17f3f68b1d7040b01bde5c846850e"
            }
          ],
          "entity_id": null
        },
        {
          "name": "SkyHammer芯片（Scale-up交换机）",
          "description": "提供确定性延迟的定制芯片，支持UALink和ESUN等开放协议，使GPU能像访问本地内存一样读取彼此的内存，避免数据移动速度的意外停顿。",
          "target_customers": "AI数据中心",
          "features": [
            "确定性延迟",
            "支持UALink开放协议",
            "支持ESUN（AI优化以太网）"
          ],
          "evidence_refs": [
            {
              "source_id": "FISRC-77f4599a4e868378",
              "quote": "Upscale says its scale-up line delivers what it calls deterministic latency, meaning data-movement speeds can be known in advance and unexpected stalls avoided. The capability runs on a custom chip the company calls SkyHammer, which supports open protocols built for this kind of traffic, including UALink, a standard that lets GPUs read one another's memory as if it were local, and ESUN, an AI-tuned flavor of Ethernet.",
              "source_content_hash": "fdc040e719a0dd75",
              "quote_hash": "fa9723b98da07eaaa22b2ad4b3b79e69a3bfb00ced6be049af3d47371441d1e2"
