      "products": [
        {
          "name": "OxCore",
          "description": "可扩展、可授权的GPU核心架构，集成三个不同的计算引擎：CUDA兼容的GPU引擎、张量处理引擎和负责协调工作负载与智能体的编排引擎（CPU）。该架构将通常分散在三颗芯片上的计算功能紧密耦合，专为近存计算设计，以最小化数据移动，提升AI工作负载的计算和能效。",
          "target_customers": "半导体公司和AI系统构建者",
          "features": [
            "CUDA兼容GPU引擎",
            "张量处理引擎",
            "编排引擎（CPU）",
            "近存计算设计",
            "从单核AI部署到大规模数据中心配置的高效扩展"
          ],
          "evidence_refs": [
            {
              "source_id": "FISRC-b7d7449114c23ca5",
              "quote": "At the center of the architecture is OxCore, a scalable, licensable GPU core that integrates three distinct compute engines: a CUDA-compatible GPU engine, a tensor processing engine, and an orchestration engine (CPU)",
              "source_content_hash": "7277428ab4a1fd81",
              "quote_hash": "fe21f2c0e1c10dbc39e705796a3c07c34ccaa6c2164b37d6062446b1ed01f214"
            },
            {
              "source_id": "FISRC-2ac2183ceab4ddd7",
              "quote": "OxCore tightly couples compute functionality that is typically split across three chips, and was purpose-built for near-memory compute, minimizing data movement to enhance compute and energy efficiency of AI workloads.",
              "source_content_hash": "b11173439b5612a7",
              "quote_hash": "91b056a89950fc5cc7a1c4c0d48565247c33d017c2bd37184d2efc74344522c2"
            }
          ],
          "entity_id": null
        },
        {
          "name": "OxQuilt",
          "description": "OXMIQ的小芯片集成架构，将异构计算小芯片和内存组合在单一封装中。该架构可适配任何供应链，提供配置工具让客户跨逻辑工艺节点、内存类型、互连标准和先进封装选项进行设计。",
          "target_customers": "半导体设计团队",
          "features": [
            "异构计算小芯片与内存集成",
            "适配任意供应链",
            "跨工艺节点、内存类型、互连标准和封装选项的配置工具"
          ],
          "evidence_refs": [
            {
              "source_id": "FISRC-2ac2183ceab4ddd7",
              "quote": "OxQuilt instead adapts to any supply chain, with configuration tools that let customers design across logic process nodes, memory types, interconnect standards, and advanced packaging options.",
              "source_content_hash": "b11173439b5612a7",
              "quote_hash": "52f3f19e98da0dd9e6ce91b8a12d89476ff9c7dc9e2441c6f39da44f734110da"
            }
          ],
          "entity_id": null
        },
        {
          "name": "OxPython",
          "description": "软件堆栈的一部分，可在OxCore上无需代码更改即可运行现有CUDA和PyTorch代码，为开发者提供跨硬件的完全可移植性。支持新兴硅架构以进行大规模优化推理，并为新模型提供首日支持。",
          "target_customers": "AI开发者",
          "features": [
