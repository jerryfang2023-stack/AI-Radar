  },
  {
    "relationship_id": "REL-75dc7846cf03f0b0",
    "event_id": "EV-be4b6dc8829070e5",
    "subject": "谷歌用同态加密让私有化 AI 推理走向实用：开源编译器 HEIR",
    "predicate": "product_release",
    "object": "To overcome the usability challenges and advance the opportunity homomorphic encryption provides, researchers and engineers at Google built the HEIR compiler project . HEIR (Homomorphic Encryption Intermediate Representation) is an open-source compiler toolchain and development platform for homomorphic encryption. In particular, HEIR can convert pre-trained AI models that operate on unencrypted data to operate on encrypted inputs. Our vision is to make HEIR a one-click solution to enable non-experts to incorporate encrypted inference into production applications.",
    "claim_ref": "CL-7530b61f3b43a514",
    "source_refs": [
      "SA-257c0c394af45db0"
    ]
